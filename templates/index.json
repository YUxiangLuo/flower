        "q2": {
          "type": "question",
          "settings": {
            "question": "Do you use real flowers?",
            "answer": "<p>Yes. Each piece is handcrafted with real pressed botanicals. Because natural flowers vary slightly in shape and color, every frame is one of a kind.</p>"
          }
        },
        "question_cdhkjk": {
          "type": "question",
          "settings": {
            "question": "Do I need to send you flowers?",
            "answer": "<p>No. We create your keepsake using our own preserved botanicals. For bouquet-inspired designs, you can upload a photo and we’ll recreate the overall color mood and floral feeling.</p>"
          }
        },
        "q1": {
          "type": "question",
          "settings": {
            "question": "How long does a keepsake take to make?",
            "answer": "<p>Each piece is made to order, and creation time varies by design and size. Check the product page for the current estimate; we’ll email you as soon as your keepsake is on its way.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "How do I care for my pressed-flower art?",
            "answer": "<p>Keep it away from direct sunlight and high humidity, and clean the glazing with a soft, dry cloth. Natural fading can occur over time, but careful placement will help preserve its colour.</p>"
          }
        }
      },
