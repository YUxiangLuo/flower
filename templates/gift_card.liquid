{% layout none %}

<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Metadata comes before styles and resource hints. %}
    {% render 'meta-tags' %}

    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Shopify-hosted QR library; the card remains usable if JavaScript is unavailable. %}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>

    {% style %}
      .gift-card-page {
        display: grid;
        place-items: center;
        width: 100%;
        min-height: 100svh;
        padding: clamp(1rem, 4vw, 3rem);
        background-color: var(--color-surface);
      }

      .gift-card {
        width: min(100%, 34rem);
        padding: clamp(1.5rem, 5vw, 3rem);
        background-color: var(--color-background);
        border: 1px solid var(--color-line);
        text-align: center;
      }

      .gift-card__brand {
        display: inline-flex;
        justify-content: center;
        color: var(--color-foreground);
        text-decoration: none;
      }

      .gift-card__logo {
        display: block;
        width: min(13.75rem, 100%);
        max-height: 4rem;
        object-fit: contain;
      }

      .gift-card__eyebrow {
        margin-top: var(--space-lg);
      }

      .gift-card__balance {
        margin-top: var(--space-xs);
        font-family: var(--font-heading--family);
        font-size: clamp(2.2rem, 8vw, 4rem);
        font-weight: 400;
        line-height: 1;
      }

      .gift-card__status,
      .gift-card__expiry {
        margin-top: var(--space-sm);
        color: var(--color-muted);
      }

      .gift-card__status {
        color: var(--color-accent-strong);
        font-weight: 600;
      }

      .gift-card__art {
        width: min(18rem, 80%);
        margin: var(--space-lg) auto;
      }

      .gift-card__art img {
        width: 100%;
        height: auto;
      }

      .gift-card__instructions {
        line-height: 1.6;
      }

      .gift-card__code-wrap {
        margin-top: var(--space-md);
      }

      .gift-card__code-label {
        display: block;
        margin-bottom: var(--space-xs);
        color: var(--color-muted);
        font-size: 0.78rem;
        letter-spacing: var(--tracking-button);
        text-transform: uppercase;
      }

      .gift-card__code {
        display: block;
        padding: 0.9rem 1rem;
        border: 1px dashed var(--color-foreground);
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: clamp(1rem, 4vw, 1.35rem);
        letter-spacing: 0.08em;
        overflow-wrap: anywhere;
      }

      .gift-card__qr {
        display: grid;
        place-items: center;
        min-height: 8rem;
        margin-top: var(--space-lg);
      }

      .gift-card__qr :is(canvas, img) {
        width: 8rem;
        height: 8rem;
      }

      .gift-card__actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: var(--space-xs);
        margin-top: var(--space-lg);
      }

      .gift-card__copy-status {
        width: 100%;
        color: var(--color-accent-strong);
        font-size: 0.85rem;
      }

      .gift-card__wallet {
        display: inline-flex;
        margin-top: var(--space-md);
      }

      .gift-card__wallet img {
        width: 12.5rem;
        height: auto;
      }

      @media print {
        .gift-card-page {
          min-height: auto;
          padding: 0;
          background: #fff;
        }

        .gift-card {
          border: 0;
        }

        .gift-card__actions,
        .gift-card__wallet {
          display: none;
        }
      }
    {% endstyle %}

    {{ content_for_header }}
  </head>

  <body>
    <main id="MainContent" class="gift-card-page">
      <article class="gift-card">
        <a class="gift-card__brand" href="{{ routes.root_url }}">
          {% render 'brand-mark', css_class: 'gift-card__logo', width: 220, loading: 'eager' %}
        </a>

        <p class="eyebrow gift-card__eyebrow">{{ 'gift_card.card' | t }}</p>
        <h1 class="gift-card__balance">
          <span class="visually-hidden">{{ 'gift_card.balance' | t }}:</span>
          {{ gift_card.balance | money_with_currency }}
        </h1>

        {% if gift_card.enabled == false or gift_card.expired %}
          <p class="gift-card__status">{{ 'gift_card.expired' | t }}</p>
        {% endif %}

        {% if gift_card.expires_on %}
          {% assign expires_on = gift_card.expires_on | time_tag: format: 'date' %}
          <p class="gift-card__expiry">
            {{ 'gift_card.expires_on' | t: expires_on: expires_on }}
          </p>
        {% endif %}

        <div class="gift-card__art">
          <img
            src="{{ 'gift-card/card.svg' | shopify_asset_url }}"
            alt="{{ 'gift_card.card' | t }}"
            width="300"
            height="200"
          >
        </div>

        <p class="gift-card__instructions">{{ 'gift_card.use_at_checkout' | t }}</p>
        <div class="gift-card__code-wrap">
          <span class="gift-card__code-label">{{ 'gift_card.code_label' | t }}</span>
          <code class="gift-card__code" data-gift-card-code>{{ gift_card.code | format_code }}</code>
        </div>

        <div
          class="gift-card__qr"
          data-gift-card-qr
          role="img"
          aria-label="{{ 'gift_card.qr_code' | t }}"
        ></div>

        <div class="gift-card__actions">
          <button class="button button--solid" type="button" data-copy-gift-card>
            {{ 'gift_card.copy_code' | t }}
          </button>
          <a class="button button--outline" href="{{ routes.root_url }}">
            {{ 'gift_card.shop' | t }}
          </a>
          <p class="gift-card__copy-status" data-copy-status role="status" hidden>
            {{ 'gift_card.copy_success' | t }}
          </p>
        </div>

        {% if gift_card.pass_url %}
          <a class="gift-card__wallet" href="{{ gift_card.pass_url }}">
            <img
              src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}"
              alt="{{ 'gift_card.add_to_apple_wallet' | t }}"
              width="200"
              height="60"
            >
          </a>
        {% endif %}
      </article>
    </main>

    <script>
      document.addEventListener('DOMContentLoaded', function () {
        var qrTarget = document.querySelector('[data-gift-card-qr]');
        if (qrTarget && typeof window.QRCode === 'function') {
          new window.QRCode(qrTarget, {
            text: {{ gift_card.qr_identifier | json }},
            width: 128,
            height: 128
          });
        }

        var copyButton = document.querySelector('[data-copy-gift-card]');
        var copyStatus = document.querySelector('[data-copy-status]');
        if (!copyButton) return;

        copyButton.addEventListener('click', function () {
          var code = {{ gift_card.code | json }};
          if (!navigator.clipboard || !navigator.clipboard.writeText) return;
          navigator.clipboard.writeText(code).then(function () {
            if (copyStatus) copyStatus.hidden = false;
          });
        });
      });
    </script>
  </body>
</html>
