{% doc %}
  Emits the theme's global CSS custom properties on `:root`, loading the
  primary font (with `display: swap`) and exposing typography, layout, colour
  and icon tokens shared across every section. Rendered once per page in the
  document `<head>`.

  Takes no parameters; reads from global `settings`.

  @example
  {% render 'css-variables' %}
{% enddoc %}

{% style %}
  {% # Loads all font variantions with display: swap %}
  {{ settings.type_primary_font | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}

  :root {
    --font-primary--family: {{ settings.type_primary_font.family }}, {{ settings.type_primary_font.fallback_families }};
    --font-primary--style: {{ settings.type_primary_font.style }};
    --font-primary--weight: {{ settings.type_primary_font.weight }};
    --page-width: {{ settings.max_page_width }};
    --page-margin: {{ settings.min_page_margin }}px;
    --color-background: {{ settings.background_color }};
    --color-foreground: {{ settings.foreground_color }};
    --style-border-radius-inputs: {{ settings.input_corner_radius }}px;

    {% # Sunflower-inspired design tokens shared across homepage sections %}
    --font-heading--family: Georgia, 'Times New Roman', Times, serif;
    --color-surface: #f1efe0;
    --color-surface-deep: #e7e4cf;
    {% # Text tokens maintain at least 4.5:1 contrast on page and surface backgrounds. %}
    --color-muted: #66644d;
    --color-accent: #85580d;
    --color-accent-strong: #85580d;
    --color-line: #e4e0ce;
    --section-spacing: clamp(3.5rem, 8vw, 7rem);
    --content-gap: clamp(1.25rem, 3vw, 2.5rem);

    {% # Heading type ramp — one shared scale so every section matches %}
    --text-hero: clamp(2.5rem, 6vw, 4.75rem);
    --text-2xl: clamp(2.1rem, 4.5vw, 3.4rem);
    --text-xl: clamp(1.9rem, 3.5vw, 2.9rem);
    --text-lg: 1.3rem;
    --text-md: 1.05rem;

    {% # Spacing scale for consistent rhythm inside sections %}
    --space-2xs: 0.5rem;
    --space-xs: 0.75rem;
    --space-sm: 1rem;
    --space-md: 1.5rem;
    --space-lg: 2.5rem;
    --space-xl: 4rem;

    {% # Shared motion + tracking so transitions and letter-spacing stay in sync %}
    --ease-out: cubic-bezier(0.2, 0.8, 0.2, 1);
    --duration-media: 0.8s;
    --duration-ui: 0.4s;
    --tracking-eyebrow: 0.28em;
    --tracking-button: 0.18em;

    {% # Stroke weight for the inline SVG icons in assets/ %}
    --icon-stroke-width: 1.2;
  }
{% endstyle %}
