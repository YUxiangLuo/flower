{% doc %}
  Renders a product media stage and thumbnail navigation.

  @param {product} product - The product whose media is displayed.

  @example
  {% render 'product-media-gallery', product: product %}
{% enddoc %}

<div class="product__gallery" data-gallery>
  <div class="product__stage">
    {% if product.media.size > 0 %}
      {% for media in product.media %}
        {%- comment -%}
          Resolve the alt text first. A `| default:` written inside an
          `image_tag` argument binds to the tag's output, not to the argument,
          so the fallback would silently never apply.
        {%- endcomment -%}
        {% assign media_alt = media.preview_image.alt | default: product.title %}
        {%- comment -%}
          Images share one square stage so the gallery never resizes under the
          reader. Uploaded video does not: a 9:16 clip cropped to a square
          loses the top and bottom of the frame, which is where most of a
          vertical composition lives. The ratio comes off the preview image,
          which Shopify generates from the video itself.

          Only `video`, not every non-image type. A 3D model and an external
          video render as <model-viewer> and <iframe>, which object-fit cannot
          reach, and an embed's own ratio need not match the poster Shopify
          made for it.
        {%- endcomment -%}
        {%- liquid
          assign stage_ratio = ''
          if media.media_type == 'video'
            assign stage_ratio = media.preview_image.aspect_ratio
          endif
        -%}
        <div
          class="product__stage-item{% if forloop.first %} is-active{% endif %}{% if media.media_type == 'video' %} product__stage-item--native{% endif %}"
          {% if stage_ratio != blank %}style="--stage-ratio: {{ stage_ratio }};"{% endif %}
          data-stage-item
          data-media-index="{{ forloop.index0 }}"
          data-media-id="{{ media.id }}"
        >
          {% if media.media_type == 'image' %}
            <button
              type="button"
              class="product__zoom"
              data-zoom-open="{{ forloop.index0 }}"
              data-preview="{{ media.preview_image | image_url: width: 800 }}"
              data-full="{{ media.preview_image | image_url: width: 2048 }}"
              aria-label="{{ 'sections.product.zoom' | t }}"
            >
              {% if forloop.first %}
                {{
                  media.preview_image
                  | image_url: width: 1600
                  | image_tag: loading: 'eager', fetchpriority: 'high', class: 'product__image', sizes: '(min-width: 750px) 50vw, 100vw', widths: '400, 600, 800, 1200, 1600', alt: media_alt
                }}
              {% else %}
                {{
                  media.preview_image
                  | image_url: width: 1600
                  | image_tag: loading: 'lazy', class: 'product__image', sizes: '(min-width: 750px) 50vw, 100vw', widths: '400, 600, 800, 1200, 1600', alt: media_alt
                }}
              {% endif %}
            </button>
          {% else %}
            {{ media | media_tag: class: 'product__image', image_size: '1600x' }}
          {% endif %}
        </div>
      {% endfor %}
    {% else %}
      <div class="product__stage-item is-active" data-stage-item data-media-index="0">
        {{ 'product-1' | placeholder_svg_tag: 'product__image product__image--placeholder' }}
      </div>
    {% endif %}

    {% if product.media.size > 1 %}
      <button
        type="button"
        class="product__stage-nav product__stage-nav--prev"
        data-gallery-prev
        aria-label="{{ 'sections.product.previous_gallery_item' | t }}"
      >
        {{- 'icon-chevron.svg' | inline_asset_content -}}
      </button>
      <button
        type="button"
        class="product__stage-nav product__stage-nav--next"
        data-gallery-next
        aria-label="{{ 'sections.product.next_gallery_item' | t }}"
      >
        {{- 'icon-chevron.svg' | inline_asset_content -}}
      </button>
    {% endif %}

    <div class="product__media-status product__gallery-status" data-gallery-status hidden>
      <span class="product__media-spinner" data-gallery-spinner aria-hidden="true"></span>
      <span data-gallery-status-text></span>
      <button
        type="button"
        class="product__media-retry"
        data-gallery-retry
        hidden
      >
        {{- 'sections.product.retry_image' | t -}}
      </button>
    </div>
    <p
      class="visually-hidden"
      data-gallery-live
      role="status"
      aria-live="polite"
      aria-atomic="true"
    ></p>
  </div>

  {% if product.media.size > 1 %}
    <div class="product__thumbs" data-thumbs role="group" aria-label="{{ 'sections.product.thumbnails' | t }}">
      {% for media in product.media %}
        <button
          type="button"
          class="product__thumb{% if forloop.first %} is-active{% endif %}"
          data-thumb="{{ forloop.index0 }}"
          aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
          aria-label="{{ 'sections.product.go_to_media' | t: index: forloop.index }}"
        >
          {{
            media.preview_image
            | image_url: width: 200, height: 200, crop: 'center'
            | image_tag: loading: 'lazy', class: 'product__thumb-image', sizes: '72px', widths: '72, 144, 200', alt: ''
          }}
          {%- comment -%}
            The play mark is the same asset the video section uses, not the
            &#9658; glyph it used to be: that character is drawn by whichever
            font resolves it, so its proportions and baseline were never the
            theme's to control.
          {%- endcomment -%}
          {% if media.media_type != 'image' %}
            <span class="product__thumb-badge" aria-hidden="true">
              {{- 'icon-play.svg' | inline_asset_content -}}
            </span>
          {% endif %}
        </button>
      {% endfor %}
    </div>
  {% endif %}
</div>
