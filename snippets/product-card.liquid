{% doc %}
  Renders a minimal product card with image, title and price.

  @param {product} product - The product to render
  @param {number} [image_size] - The rendered image width/height in pixels (defaults to 600)
  @param {string} [heading_level] - Heading element for the product title (defaults to h2)
  @param {number} [columns] - Number of desktop columns in the containing grid (defaults to 4)
  @param {boolean} [eager] - Load the image immediately instead of deferring it. Set it on the cards in the grid's first row and nowhere else.
  @param {boolean} [full_width] - Set when the containing grid spans the viewport instead of stopping at the page width. Pair it with an `image_size` large enough for the wider card.

  @example
  {% render 'product-card', product: product %}
  {% render 'product-card', product: product, image_size: 800 %}
  {% render 'product-card', product: product, eager: true %}
{% enddoc %}

{% liquid
  assign image_size = image_size | default: 600
  assign heading_level = heading_level | default: 'h2'
  assign columns = columns | default: 4

  # Each rung is roughly a doubling of the rendered card, because the candidate
  # a browser wants is the CSS width times the device pixel ratio. The ceiling
  # tracks `image_size`: a grid that renders cards twice as wide needs candidates
  # to match, and one that does not should never be offered the larger files.
  #
  # Every rung tops out at exactly the `image_size` that reaches it, and has to.
  # `image_size` is the width baked into the URL these candidates are derived
  # from, so a larger entry is not served — it is dropped, and the rung quietly
  # promises a file that never existed.
  if image_size > 800
    assign image_widths = '240, 360, 480, 600, 800, 1000'
  elsif image_size > 700
    assign image_widths = '240, 360, 480, 600, 700, 800'
  elsif image_size > 600
    assign image_widths = '240, 360, 480, 600, 700'
  else
    assign image_widths = '240, 360, 480, 600'
  endif
%}

{% capture image_sizes %}
  {%- render 'grid-image-sizes', columns: columns, full_width: full_width -%}
{% endcapture %}
{% assign image_sizes = image_sizes | strip %}

{%- comment -%}
  Resolve the alt text first. A `| default:` written inside an `image_tag`
  argument binds to the tag's output, not to the argument, so the fallback
  would silently never apply.
{%- endcomment -%}
{% assign card_alt = product.featured_image.alt | default: product.title %}
{% assign card_price = product.price | money %}

<a class="product-card" href="{{ product.url }}">
  <div class="product-card__media">
    {% if product.featured_image %}
      {%- comment -%}
        A deferred image is not discovered by the preload scanner and is queued
        at low priority once layout has run, which is the wrong treatment for a
        card that is on screen when the page opens — that image is often the
        page's largest paint. Callers mark the few cards that qualify; everyone
        else gets the default, because eagerly loading a grid is how a
        collection page ends up fetching twenty-four full-size images at once.

        Eager, but not `fetchpriority: 'high'`. A card is only a candidate for
        the largest paint, never a certainty: on a phone the collection header's
        own artwork usually wins, and that one is preloaded. Raising a grid
        image above it would have the two fighting over the same connection.
        Eager already buys the thing that was missing — discovery during parse.
      {%- endcomment -%}
      {% if eager %}
        {{
          product.featured_image
          | image_url: width: image_size, height: image_size, crop: 'center'
          | image_tag: loading: 'eager', class: 'product-card__image', sizes: image_sizes, widths: image_widths, alt: card_alt
        }}
      {% else %}
        {{
          product.featured_image
          | image_url: width: image_size, height: image_size, crop: 'center'
          | image_tag: loading: 'lazy', class: 'product-card__image', sizes: image_sizes, widths: image_widths, alt: card_alt
        }}
      {% endif %}
    {% else %}
      {{ 'product-1' | placeholder_svg_tag: 'product-card__image product-card__image--placeholder' }}
    {% endif %}

    {% if product.compare_at_price > product.price %}
      <span class="product-card__badge">{{ 'sections.featured_products.sale' | t }}</span>
    {% endif %}
  </div>

  <div class="product-card__info">
    <{{ heading_level }} class="product-card__title">{{ product.title | escape }}</{{ heading_level }}>
    <p class="product-card__price">
      {% if product.compare_at_price > product.price %}
        <s class="product-card__price-was">{{ product.compare_at_price | money }}</s>
      {% endif %}
      {% if product.price_varies %}
        <span>{{ 'product.from_price' | t: price: card_price }}</span>
      {% else %}
        <span>{{ card_price }}</span>
      {% endif %}
    </p>
  </div>
</a>

{% stylesheet %}
  .product-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    color: var(--color-foreground);
    text-decoration: none;
  }

  .product-card__media {
    position: relative;
    overflow: hidden;
    background-color: var(--color-surface);
    aspect-ratio: 1 / 1;
  }

  .product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-media) var(--ease-out);
  }

  .product-card:hover .product-card__image,
  .product-card:focus-visible .product-card__image {
    transform: scale(1.04);
  }

  .product-card__badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    padding: 0.25rem 0.6rem;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    background-color: var(--color-background);
    color: var(--color-accent-strong);
  }

  .product-card__info {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .product-card__title {
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: var(--text-md);
    line-height: 1.3;
  }

  .product-card__price {
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
    font-size: 0.9rem;
    color: var(--color-muted);
  }

  .product-card__price-was {
    color: var(--color-muted);
  }
{% endstylesheet %}
