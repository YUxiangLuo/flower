{% doc %}
  Renders the image-only product media lightbox.

  @param {media[]} image_media - Product media filtered to image media.

  @example
  {% assign image_media = product.media | where: 'media_type', 'image' %}
  {% render 'product-lightbox', image_media: image_media %}
{% enddoc %}

{% if image_media.size > 0 %}
  {%- comment -%}
    `scroll-lock` is read by critical.css to freeze the page behind an open
    dialog. Without it the page keeps scrolling under the lightbox and the
    customer is returned to a different place in the product page on close.
  {%- endcomment -%}
  <dialog
    class="product__lightbox"
    data-lightbox
    scroll-lock
    aria-label="{{ 'sections.product.gallery' | t }}"
  >
    <button
      type="button"
      class="product__lightbox-close"
      data-lightbox-close
      aria-label="{{ 'sections.product.close' | t }}"
    >
      {{- 'icon-close.svg' | inline_asset_content -}}
    </button>
    {% if image_media.size > 1 %}
      <button
        type="button"
        class="product__lightbox-nav product__lightbox-nav--prev"
        data-lightbox-prev
        aria-label="{{ 'sections.product.previous_media' | t }}"
      >
        {{- 'icon-chevron.svg' | inline_asset_content -}}
      </button>
    {% endif %}
    {% # theme-check-disable ImgWidthAndHeight, RemoteAsset %}
    <img class="product__lightbox-image" data-lightbox-image decoding="async" alt="">
    {% # theme-check-enable ImgWidthAndHeight, RemoteAsset %}
    <div class="product__lightbox-loader" data-lightbox-loader hidden>
      <span class="product__media-spinner" aria-hidden="true"></span>
      <span data-lightbox-loader-text></span>
    </div>
    <div class="product__lightbox-meta">
      <span
        class="product__lightbox-counter"
        data-lightbox-counter
        aria-hidden="true"
      >
        1 / {{ image_media.size }}
      </span>
      <span data-lightbox-error hidden></span>
      <button
        type="button"
        class="product__media-retry product__lightbox-retry"
        data-lightbox-retry
        hidden
      >
        {{- 'sections.product.retry_image' | t -}}
      </button>
    </div>
    <p
      class="visually-hidden"
      data-lightbox-live
      role="status"
      aria-live="polite"
      aria-atomic="true"
    ></p>
    {% if image_media.size > 1 %}
      <button
        type="button"
        class="product__lightbox-nav product__lightbox-nav--next"
        data-lightbox-next
        aria-label="{{ 'sections.product.next_media' | t }}"
      >
        {{- 'icon-chevron.svg' | inline_asset_content -}}
      </button>
    {% endif %}
  </dialog>
{% endif %}
