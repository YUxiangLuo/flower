{% doc %}
  Renders the document's core meta tags: charset and viewport, SEO title and
  description, canonical URL, and Open Graph / Twitter card tags for social
  sharing. Rendered once per page in the document `<head>`.

  Takes no parameters; reads from global objects (`page_title`,
  `page_description`, `canonical_url`, `shop`, etc.).

  @example
  {% render 'meta-tags' %}
{% enddoc %}

<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width,initial-scale=1">

{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign canonical_href = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name
  assign og_locale = request.locale.iso_code | replace: '-', '_'

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

{% if settings.favicon != blank %}
  <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
{% endif %}

{% if request.page_type == 'search' or request.page_type == 'cart' %}
  <meta name="robots" content="noindex,follow">
{% elsif request.page_type == 'gift_card' %}
  <meta name="robots" content="noindex,nofollow">
{% endif %}

<meta
  property="og:site_name"
  content="{{ shop.name | escape }}"
>
<meta
  property="og:url"
  content="{{ og_url | escape }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>
<meta
  property="og:locale"
  content="{{ og_locale | escape }}"
>

{%- if page_image -%}
  <meta
    property="og:image"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:width"
    content="{{ page_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ page_image.height }}"
  >
  {% if page_image.alt != blank %}
    <meta
      property="og:image:alt"
      content="{{ page_image.alt | escape }}"
    >
  {% endif %}
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>

  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html | escape }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code | escape }}"
  >
{%- endif -%}

<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>
{%- if page_image -%}
  <meta
    name="twitter:image"
    content="https:{{ page_image | image_url }}"
  >
  {% if page_image.alt != blank %}
    <meta
      name="twitter:image:alt"
      content="{{ page_image.alt | escape }}"
    >
  {% endif %}
{%- endif -%}

<title>
  {{- page_title | escape -}}
  {%- if current_tags -%}
    {%- assign escaped_current_tags = current_tags | join: ', ' | escape -%}
    &ndash; {{ 'general.meta.tagged' | t: tags: escaped_current_tags }}
  {%- endif -%}
  {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
  {%- unless page_title contains shop.name %} &ndash; {{ shop.name | escape }}{% endunless -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_href | escape }}"
>

{% if page_description %}
  <meta
    name="description"
    content="{{ page_description | escape }}"
  >
{% endif %}
