{% comment %}
  A slim, full-width strip of reassurance points shown just under the hero.
  Uses section blocks so merchants can add, remove and reorder the points.
{% endcomment %}

<div
  class="reassure full-width"
  style="--reassure-bg: {{ section.settings.background_color }}; --reassure-text: {{ section.settings.text_color }};"
>
  <ul class="reassure__list" style="--columns: {{ section.blocks.size }}">
    {% for block in section.blocks %}
      <li class="reassure__item" {{ block.shopify_attributes }}>
        {% if block.settings.icon %}
          {{
            block.settings.icon
            | image_url: width: 96, height: 96
            | image_tag: loading: 'lazy', class: 'reassure__icon', alt: block.settings.label
          }}
        {% else %}
          <span class="reassure__dot" aria-hidden="true"></span>
        {% endif %}
        <span class="reassure__label">{{ block.settings.label }}</span>
      </li>
    {% endfor %}
  </ul>
</div>

{% stylesheet %}
  .reassure {
    background-color: var(--reassure-bg);
    color: var(--reassure-text);
  }

  .reassure__list {
    max-width: var(--page-width);
    margin-inline: auto;
    padding-block: 1.25rem;
    padding-inline: var(--page-margin);
    display: grid;
    grid-template-columns: repeat(var(--columns), 1fr);
    gap: 1rem var(--content-gap);
    list-style: none;
  }

  .reassure__item {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    text-align: center;
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .reassure__icon {
    width: 1.5rem;
    height: 1.5rem;
    object-fit: contain;
  }

  .reassure__dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background-color: var(--color-accent);
    flex-shrink: 0;
  }

  @media (max-width: 749px) {
    .reassure__list {
      grid-template-columns: 1fr 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.reassurance.name",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.reassurance.background_color",
      "default": "#f1efe0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:sections.reassurance.text_color",
      "default": "#2a3320"
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "t:sections.reassurance.block_name",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "t:sections.reassurance.icon"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.reassurance.label",
          "default": "Real pressed botanicals"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "t:sections.reassurance.name",
      "blocks": [
        { "type": "point", "settings": { "label": "Real pressed botanicals" } },
        { "type": "point", "settings": { "label": "Handmade to order" } },
        { "type": "point", "settings": { "label": "Personalised to you" } },
        { "type": "point", "settings": { "label": "Made to last for years" } }
      ]
    }
  ]
}
{% endschema %}
