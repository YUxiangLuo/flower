{% liquid
  assign show_country_selector = false
  assign show_language_selector = false

  if section.settings.show_localization
    if localization.available_countries.size > 1
      assign show_country_selector = true
    endif
    if localization.available_languages.size > 1
      assign show_language_selector = true
    endif
  endif

  # Count the columns beside the brand so the grid can name them. `auto-fit`
  # would read the count off the container, but a track list holding an
  # auto-repeat may not also hold an `fr` value — and the brand column is 1.4fr,
  # so the whole declaration was being thrown away and the footer stacked into
  # one column on every desktop page.
  assign footer_columns = section.blocks.size
  if section.settings.show_newsletter
    assign footer_columns = footer_columns | plus: 1
  endif
  assign footer_columns = footer_columns | at_least: 1
%}

<footer
  class="footer full-width"
  style="--footer-bg: {{ section.settings.background_color }}; --footer-text: {{ section.settings.text_color }};"
>
  <div class="footer__inner">
    <div class="footer__top" style="--footer-columns: {{ footer_columns }}">
      <div class="footer__brand">
        <a class="footer__logo" href="{{ routes.root_url }}" style="--logo-width: {{ settings.logo_width }}px">
          {% render 'brand-mark', css_class: 'footer__logo-mark', width: settings.logo_width %}
        </a>
        {% if section.settings.tagline != blank %}
          <p class="footer__tagline">{{ section.settings.tagline }}</p>
        {% endif %}

        {% if section.settings.social_facebook != blank or section.settings.social_instagram != blank %}
          <div class="footer__social">
            {% if section.settings.social_facebook != blank %}
              <a
                class="footer__social-link"
                href="{{ section.settings.social_facebook }}"
                aria-label="{{ 'sections.footer.follow_facebook' | t }}"
              >
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                  <path d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.4v7A10 10 0 0 0 22 12z"/>
                </svg>
              </a>
            {% endif %}
            {% if section.settings.social_instagram != blank %}
              <a
                class="footer__social-link"
                href="{{ section.settings.social_instagram }}"
                aria-label="{{ 'sections.footer.follow_instagram' | t }}"
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false">
                  <rect x="3" y="3" width="18" height="18" rx="5"/>
                  <circle cx="12" cy="12" r="4"/>
                  <circle cx="17.3" cy="6.7" r="1" fill="currentColor" stroke="none"/>
                </svg>
              </a>
            {% endif %}
          </div>
        {% endif %}
      </div>

      {% for block in section.blocks %}
        <div class="footer__column" {{ block.shopify_attributes }}>
          {% if block.settings.heading != blank %}
            <h2 class="footer__column-title">{{ block.settings.heading }}</h2>
          {% endif %}

          {% case block.type %}
            {% when 'menu' %}
              {% if block.settings.menu != blank %}
                <ul class="footer__links">
                  {% for link in block.settings.menu.links %}
                    <li><a class="footer__link" href="{{ link.url }}">{{ link.title }}</a></li>
                  {% endfor %}
                </ul>
              {% endif %}
            {% when 'text' %}
              <div class="footer__text">{{ block.settings.content }}</div>
          {% endcase %}
        </div>
      {% endfor %}

      {% if section.settings.show_newsletter %}
        <div class="footer__column footer__newsletter">
          {% if section.settings.newsletter_heading != blank %}
            <h2 class="footer__column-title">{{ section.settings.newsletter_heading }}</h2>
          {% endif %}

          {% assign footer_newsletter_form_id = 'FooterNewsletterForm-' | append: section.id %}
          {% form 'customer', id: footer_newsletter_form_id %}
            {% if form.posted_successfully? %}
              <p class="footer__newsletter-success">{{ 'sections.footer.newsletter_success' | t }}</p>
            {% else %}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <div class="footer__newsletter-field">
                <label class="visually-hidden" for="FooterEmail-{{ section.id }}">
                  {{- 'sections.footer.email_placeholder' | t -}}
                </label>
                <input
                  id="FooterEmail-{{ section.id }}"
                  type="email"
                  name="contact[email]"
                  placeholder="{{ 'sections.footer.email_placeholder' | t }}"
                  autocomplete="email"
                  required
                >
                <button type="submit" aria-label="{{ 'sections.footer.subscribe' | t }}">&rarr;</button>
              </div>
              {% if form.errors %}
                <div class="footer__newsletter-error">{{ form.errors | default_errors }}</div>
              {% endif %}
            {% endif %}
          {% endform %}
        </div>
      {% endif %}
    </div>

    <div class="footer__bottom">
      {% if show_country_selector or show_language_selector %}
        {% assign footer_localization_form_id = 'FooterLocalizationForm-' | append: section.id %}
        {% form 'localization', id: footer_localization_form_id, class: 'footer__localization' %}
          {% if show_country_selector %}
            <label for="FooterCountry-{{ section.id }}">{{ 'sections.footer.country' | t }}</label>
            <select id="FooterCountry-{{ section.id }}" name="country_code" data-localization-select>
              {% for available_country in localization.available_countries %}
                <option
                  value="{{ available_country.iso_code }}"
                  {% if available_country.iso_code == localization.country.iso_code %}selected{% endif %}
                >
                  {{ available_country.name | escape }}
                  ({{ available_country.currency.iso_code }} {{ available_country.currency.symbol }})
                </option>
              {% endfor %}
            </select>
          {% endif %}

          {% if show_language_selector %}
            <label for="FooterLanguage-{{ section.id }}">{{ 'sections.footer.language' | t }}</label>
            <select id="FooterLanguage-{{ section.id }}" name="locale_code" data-localization-select>
              {% for available_language in localization.available_languages %}
                <option
                  value="{{ available_language.iso_code }}"
                  {% if available_language.iso_code == localization.language.iso_code %}selected{% endif %}
                >
                  {{ available_language.endonym_name | capitalize | escape }}
                </option>
              {% endfor %}
            </select>
          {% endif %}

          {%- comment -%}
            Changing a selector applies it, the way the header's copy already
            worked — the button is only the way out when there is no script to
            do it.

            The handler that binds these lives in the header section and walks
            the whole document, so this footer needs a header on the page to
            work. Only the password layout renders one without the other, and
            the schema below keeps this section off that template rather than
            leaving the selectors to fail there in silence.
          {%- endcomment -%}
          <noscript>
            <button type="submit">{{ 'sections.footer.update_localization' | t }}</button>
          </noscript>
        {% endform %}
      {% endif %}

      <p class="footer__copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }} · {{ powered_by_link }}
      </p>

      {% if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 %}
        <div class="footer__payment">
          {% for type in shop.enabled_payment_types %}
            {{ type | payment_type_svg_tag: class: 'footer__payment-icon' }}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</footer>

{% stylesheet %}
  .footer {
    background-color: var(--footer-bg);
    color: var(--footer-text);
  }

  .footer__inner {
    max-width: var(--page-width);
    margin-inline: auto;
    padding: var(--section-spacing) max(var(--page-margin), 3vw) 2.5rem;
  }

  /* `minmax(0, 1.4fr)` and not a bare `1.4fr`: a flexible track's automatic
     minimum is its content, so the brand column refused to shrink and pushed
     the row past the page — a horizontal scrollbar from 990px up to about
     1280px. Floored at zero it takes only what the link columns leave. */
  .footer__top {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) repeat(var(--footer-columns), minmax(8rem, 1fr));
    gap: clamp(2rem, 4vw, 3.5rem);
    padding-bottom: 3rem;
  }

  .footer__logo {
    font-family: var(--font-heading--family);
    font-size: 1.4rem;
    color: inherit;
    text-decoration: none;
  }

  .footer__logo-mark {
    display: block;
    width: min(var(--logo-width), 100%);
    max-height: 3.5rem;
    object-fit: contain;
    object-position: left center;
  }

  .footer__tagline {
    margin-top: 1rem;
    max-width: 30ch;
    line-height: 1.6;
    opacity: 0.7;
    font-size: 0.9rem;
  }

  .footer__social {
    display: flex;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .footer__social-link {
    color: inherit;
    opacity: 0.75;
    transition: opacity 0.3s ease;
  }

  .footer__social-link:hover,
  .footer__social-link:focus-visible {
    opacity: 1;
  }

  .footer__social-link svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .footer__column-title {
    font-size: 0.78rem;
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.55;
    margin-bottom: 1.25rem;
  }

  .footer__links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer__link,
  .footer__text a {
    color: inherit;
    text-decoration: none;
    font-size: 0.9rem;
    opacity: 0.8;
    transition: opacity 0.3s ease;
  }

  .footer__link:hover,
  .footer__link:focus-visible {
    opacity: 1;
  }

  .footer__text {
    font-size: 0.9rem;
    line-height: 1.7;
    opacity: 0.8;
  }

  .footer__text > * + * {
    margin-top: 0.75rem;
  }

  .footer__newsletter-field {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border-bottom: 1px solid currentColor;
    padding-bottom: 0.5rem;
    max-width: 20rem;
  }

  /* Grid and flex items are as wide as their content unless told otherwise, and
     an <input> carries an intrinsic width of about twenty characters whatever
     the box around it says. That was the widest thing in the footer: it held
     the newsletter column open past its track and pushed the whole row off the
     page. Floors of zero let both shrink to the space they were given. */
  .footer__column {
    min-width: 0;
  }

  .footer__newsletter-field input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: 0;
    color: inherit;
    font-size: 0.9rem;
    padding: 0.25rem 0;
  }

  .footer__newsletter-field input::placeholder {
    color: inherit;
    opacity: 0.6;
  }

  .footer__newsletter-field input:focus {
    outline: none;
  }

  .footer__newsletter-field:focus-within {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  .footer__newsletter-field button {
    background: transparent;
    border: 0;
    color: inherit;
    cursor: pointer;
    font-size: 1.1rem;
    line-height: 1;
  }

  .footer__newsletter-success {
    font-size: 0.9rem;
    opacity: 0.85;
  }

  .footer__newsletter-error {
    margin-top: var(--space-xs);
    font-size: 0.85rem;
  }

  .footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 2rem;
    border-top: 1px solid rgb(255 255 255 / 0.12);
  }

  .footer__localization {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    width: 100%;
  }

  .footer__localization label {
    font-size: 0.75rem;
  }

  .footer__localization select,
  .footer__localization button {
    padding: 0.45rem 0.65rem;
    border: 1px solid currentColor;
    border-radius: var(--style-border-radius-inputs);
    color: inherit;
    background-color: var(--footer-bg);
  }

  .footer__localization button {
    cursor: pointer;
  }

  .footer__copyright {
    font-size: 0.8rem;
    opacity: 0.6;
  }

  .footer__copyright a {
    color: inherit;
  }

  .footer__payment {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .footer__payment-icon {
    width: 2.25rem;
    height: auto;
    border-radius: 3px;
  }

  /* Two columns below this. The full row costs four 10rem link columns plus
     their gaps before the brand gets anything — around 830px — so holding it
     lower leaves the brand column too narrow for a logo and a line of copy
     even once it is allowed to shrink. Above it the brand clears 290px. */
  @media (max-width: 1199px) {
    .footer__top {
      grid-template-columns: 1fr 1fr;
    }

    .footer__brand,
    .footer__newsletter {
      grid-column: 1 / -1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "t:sections.footer.tagline",
      "default": "Handcrafted keepsakes made from real pressed flowers, designed to be treasured for years."
    },
    {
      "type": "header",
      "content": "t:sections.footer.social_header"
    },
    {
      "type": "url",
      "id": "social_facebook",
      "label": "t:sections.footer.social_facebook"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "t:sections.footer.social_instagram"
    },
    {
      "type": "header",
      "content": "t:sections.footer.newsletter_header"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "t:sections.footer.show_newsletter",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "t:sections.footer.newsletter_heading",
      "default": "Subscribe to our emails"
    },
    {
      "type": "header",
      "content": "t:sections.footer.bottom_header"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:labels.show_payment_icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_localization",
      "label": "t:sections.footer.show_localization",
      "default": true
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.footer.background_color",
      "default": "#2a3320"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:sections.footer.text_color",
      "default": "#fcfaf4"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "t:sections.footer.menu_block",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.footer.column_heading",
          "default": "Quick links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:labels.menu"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.footer.text_block",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.footer.column_heading",
          "default": "Contact us"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "t:sections.footer.content",
          "default": "<p>Email: info@driedpetalsgallery.com</p><p>Phone: +852 6158 8111</p>"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "disabled_on": {
    "templates": ["password"]
  },
  "presets": [
    {
      "name": "t:general.footer",
      "blocks": [
        { "type": "menu", "settings": { "heading": "Customer service" } },
        { "type": "menu", "settings": { "heading": "Quick links" } },
        { "type": "text" }
      ]
    }
  ]
}
{% endschema %}
