{% comment %}
  The landing page a visitor sees while the store is password protected.

  This is the only page such a visitor ever reaches, so it carries the brand
  mark and the theme's own type and colour rather than the browser defaults it
  shipped with.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/password
{% endcomment %}

{%- comment -%}
  `full-width` because the section paints a background. Without it critical.css
  drops the element into the middle column of the section grid and the cream
  stops a page margin short of each edge, leaving the body colour showing down
  both sides.
{%- endcomment -%}
<div class="password full-width">
  <div class="password__card">
    <a class="password__brand" href="{{ routes.root_url }}">
      {%- comment -%}
        `eager` because this is the only thing above the fold on the only page
        a locked-out visitor reaches; the snippet lazy-loads by default, which
        suits the footer and nothing here.
      {%- endcomment -%}
      {% render 'brand-mark',
        css_class: 'password__brand-mark',
        width: settings.logo_width,
        loading: 'eager'
      %}
    </a>

    <h1 class="password__title">{{ 'password.title' | t }}</h1>

    {% if shop.password_message != blank %}
      {%- comment -%}
        Not `rte`: that class is defined inside sections/page.liquid, and the
        password template never renders that section, so it would carry no
        styles at all here. The few tags a password message can contain are
        covered below instead.
      {%- endcomment -%}
      <div class="password__message">{{ shop.password_message }}</div>
    {% endif %}

    {% form 'storefront_password', class: 'password__form' %}
      {% if form.errors %}
        <div class="password__errors" role="alert">
          {{ form.errors | default_errors }}
        </div>
      {% endif %}

      <label class="visually-hidden" for="password-input">
        {{- 'password.password' | t -}}
      </label>

      <div class="password__field">
        <input
          type="password"
          name="password"
          id="password-input"
          class="password__input"
          autocomplete="current-password"
          placeholder="{{ 'password.password' | t | escape }}"
        >

        <button type="submit" class="button button--solid password__submit">
          {{- 'password.enter' | t -}}
        </button>
      </div>
    {% endform %}
  </div>
</div>

{% stylesheet %}
  /* The password layout carries no header or footer, so this section is the
     whole page and centres itself in the viewport rather than sitting under
     one. */
  .password {
    display: grid;
    place-items: center;
    min-height: 100svh;
    padding: var(--section-spacing) var(--page-margin);
    background-color: var(--color-surface);
  }

  .password__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    width: min(28rem, 100%);
    padding: clamp(2rem, 6vw, 3.5rem);
    text-align: center;
    background-color: var(--color-background);
    border: 1px solid var(--color-line);
  }

  .password__brand {
    display: block;
    color: var(--color-foreground);
    text-decoration: none;
    transition: opacity 0.3s ease;
  }

  /* Opacity, for the reason given on `.header__logo`: the mark is an image
     whenever one has been uploaded, and a colour change never reaches it. */
  .password__brand:hover,
  .password__brand:focus-visible {
    opacity: 0.7;
  }

  .password__brand-mark {
    font-family: var(--font-heading--family);
    font-size: var(--text-lg);
    letter-spacing: 0.08em;
  }

  .password__title {
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: var(--text-xl);
    line-height: 1.1;
  }

  .password__message {
    color: var(--color-muted);
    line-height: 1.6;
  }

  .password__message > * + * {
    margin-top: var(--space-xs);
  }

  .password__message a {
    color: var(--color-accent);
  }

  .password__message strong {
    color: var(--color-foreground);
  }

  .password__form {
    width: 100%;
  }

  .password__field {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  .password__input {
    flex: 1 1 12rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--color-line);
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .password__input:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .password__submit {
    flex: 0 0 auto;
  }

  .password__errors {
    margin-bottom: var(--space-sm);
    color: var(--color-accent);
    font-size: 0.9rem;
  }

  @media (max-width: 549px) {
    .password__submit {
      flex: 1 1 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.password",
  "settings": []
}
{% endschema %}
