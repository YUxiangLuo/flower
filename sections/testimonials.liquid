{% comment %}
  Customer testimonials on a soft surface background.
  Each testimonial is a block so merchants can manage social proof.
{% endcomment %}

{% liquid
  assign testimonial_count = 0
  for block in section.blocks
    if block.settings.quote != blank
      assign testimonial_count = testimonial_count | plus: 1
    elsif request.design_mode
      assign testimonial_count = testimonial_count | plus: 1
    endif
  endfor
%}

{% if testimonial_count > 0 %}
  <div class="testimonials full-width">
    <div class="testimonials__inner">
      <header class="testimonials__header">
        {% if section.settings.eyebrow != blank %}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="testimonials__heading">{{ section.settings.heading }}</h2>
        {% endif %}
      </header>

      <div class="testimonials__grid" style="--columns: {{ section.settings.columns }}">
        {% for block in section.blocks %}
          {% if block.settings.quote != blank %}
            <figure class="testimonial" {{ block.shopify_attributes }}>
              {% if block.settings.rating > 0 %}
                {%- comment -%}
                  All five slots are always drawn, the unearned ones as outlines.
                  Stopping the loop at the rating leaves three solid stars and
                  nothing after them, which reads as three out of three — the
                  label says "out of 5" but only a screen reader ever hears it.
                {%- endcomment -%}
                <div
                  class="testimonial__stars"
                  aria-label="{{ 'sections.testimonials.rating' | t: rating: block.settings.rating }}"
                >
                  {% for i in (1..5) %}
                    <span
                      class="testimonial__star{% if i > block.settings.rating %} testimonial__star--empty{% endif %}"
                      aria-hidden="true"
                    >
                      {{- 'icon-star.svg' | inline_asset_content -}}
                    </span>
                  {% endfor %}
                </div>
              {% endif %}

              <blockquote class="testimonial__quote">{{ block.settings.quote | escape }}</blockquote>

              {% if block.settings.author != blank %}
                <figcaption class="testimonial__author">{{ block.settings.author | escape }}</figcaption>
              {% endif %}
            </figure>
          {% elsif request.design_mode %}
            <div class="testimonial testimonial--empty" {{ block.shopify_attributes }}>
              {{ 'sections.testimonials.add_review' | t }}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .testimonials {
    background-color: var(--color-background);
  }

  .testimonials__inner {
    padding-block: var(--section-spacing);
    padding-inline: var(--page-margin);
    max-width: var(--page-width);
    margin-inline: auto;
  }

  .testimonials__header {
    text-align: center;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .testimonials__heading {
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: var(--text-xl);
    line-height: 1.1;
  }

  /* A fixed column count rather than auto-fit: these cards hold prose, and
     auto-fit answers the merchant's block count with however many 15rem columns
     the page happens to fit — six blocks land as five plus an orphan, each one
     too narrow to read a quote in. */
  .testimonials__grid {
    display: grid;
    grid-template-columns: repeat(var(--columns), 1fr);
    gap: var(--content-gap);
  }

  .testimonial {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 2rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-line);
    text-align: center;
    align-items: center;
  }

  .testimonial__stars {
    display: flex;
    gap: 0.2rem;
    color: var(--color-accent);
  }

  .testimonial__star {
    display: block;
    width: 0.95rem;
    height: 0.95rem;
  }

  .testimonial__star svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Same glyph either way, so the row keeps its spacing and an outline cannot be
     mistaken for a gap. */
  .testimonial__star--empty svg {
    fill: none;
  }

  .testimonial__quote {
    font-family: var(--font-heading--family);
    font-size: 1.15rem;
    line-height: 1.5;
    font-style: italic;
    margin: 0;
  }

  .testimonial__author {
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .testimonial--empty {
    color: var(--color-muted);
    font-style: italic;
  }

  @media (max-width: 989px) {
    .testimonials__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Quotes go single file well before a product grid would — a testimonial in
     half a phone's width wraps to a column of two-word lines. */
  @media (max-width: 649px) {
    .testimonials__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.testimonials.name",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.testimonials.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.testimonials.heading",
      "default": "Customer testimonials"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "t:sections.testimonials.columns",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "t:sections.testimonials.block_name",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "t:sections.testimonials.rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 0
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "t:sections.testimonials.quote"
        },
        {
          "type": "text",
          "id": "author",
          "label": "t:sections.testimonials.author"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "t:sections.testimonials.name",
      "blocks": [{ "type": "testimonial" }, { "type": "testimonial" }, { "type": "testimonial" }]
    }
  ]
}
{% endschema %}
