{% comment %}
  Customer testimonials on a soft surface background.
  Each testimonial is a block so merchants can manage social proof.
{% endcomment %}

{% liquid
  assign testimonial_count = 0
  for block in section.blocks
    if block.settings.quote != blank
      assign testimonial_count = testimonial_count | plus: 1
    elsif request.design_mode
      assign testimonial_count = testimonial_count | plus: 1
    endif
  endfor
%}

{% if testimonial_count > 0 %}
  <div class="testimonials full-width">
    <div class="testimonials__inner">
      <header class="testimonials__header">
        {% if section.settings.eyebrow != blank %}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="testimonials__heading">{{ section.settings.heading }}</h2>
        {% endif %}
      </header>

      <div class="testimonials__grid">
        {% for block in section.blocks %}
          {% if block.settings.quote != blank %}
            <figure class="testimonial" {{ block.shopify_attributes }}>
              {% if block.settings.rating > 0 %}
                <div
                  class="testimonial__stars"
                  aria-label="{{ 'sections.testimonials.rating' | t: rating: block.settings.rating }}"
                >
                  {% for i in (1..block.settings.rating) %}
                    <span aria-hidden="true">&#9733;</span>
                  {% endfor %}
                </div>
              {% endif %}

              <blockquote class="testimonial__quote">{{ block.settings.quote | escape }}</blockquote>

              {% if block.settings.author != blank %}
                <figcaption class="testimonial__author">{{ block.settings.author | escape }}</figcaption>
              {% endif %}
            </figure>
          {% elsif request.design_mode %}
            <div class="testimonial testimonial--empty" {{ block.shopify_attributes }}>
              {{ 'sections.testimonials.add_review' | t }}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .testimonials {
    background-color: var(--color-background);
  }

  .testimonials__inner {
    padding-block: var(--section-spacing);
    padding-inline: var(--page-margin);
    max-width: var(--page-width);
    margin-inline: auto;
  }

  .testimonials__header {
    text-align: center;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .testimonials__heading {
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: var(--text-xl);
    line-height: 1.1;
  }

  .testimonials__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--content-gap);
  }

  .testimonial {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 2rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-line);
    text-align: center;
    align-items: center;
  }

  .testimonial__stars {
    display: flex;
    gap: 0.2rem;
    color: var(--color-accent);
    font-size: 0.9rem;
  }

  .testimonial__quote {
    font-family: var(--font-heading--family);
    font-size: 1.15rem;
    line-height: 1.5;
    font-style: italic;
    margin: 0;
  }

  .testimonial__author {
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .testimonial--empty {
    color: var(--color-muted);
    font-style: italic;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.testimonials.name",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.testimonials.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.testimonials.heading",
      "default": "Customer testimonials"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "t:sections.testimonials.block_name",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "t:sections.testimonials.rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 0
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "t:sections.testimonials.quote"
        },
        {
          "type": "text",
          "id": "author",
          "label": "t:sections.testimonials.author"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "t:sections.testimonials.name",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
