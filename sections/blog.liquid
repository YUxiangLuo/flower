{% comment %}
  Blog page: lists the articles within a blog as a card grid.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/blog
{% endcomment %}

{% capture blog_image_sizes %}
  {%- render 'grid-image-sizes', columns: section.settings.columns, two_column_breakpoint: 650 -%}
{% endcapture %}
{% assign blog_image_sizes = blog_image_sizes | strip %}

<div class="blog">
  <header class="blog__header">
    <h1 class="blog__title">{{ blog.title }}</h1>
  </header>

  {% paginate blog.articles by 6 %}
    <div class="blog__grid" style="--columns: {{ section.settings.columns }}">
      {% for article in blog.articles %}
        <article class="blog-card">
          {%- comment -%}
            The title below is the link that names this article. This one goes
            to the same place and holds only artwork, so with no featured image
            it was a link with nothing to announce it by. Marked decorative
            rather than labelled, which also spares a screen reader the same
            destination twice.
          {%- endcomment -%}
          <a class="blog-card__media" href="{{ article.url }}" tabindex="-1" aria-hidden="true">
            {% if article.image %}
              {{
                article.image
                | image_url: width: 900, height: 600, crop: 'center'
                | image_tag: loading: 'lazy', class: 'blog-card__image', sizes: blog_image_sizes, widths: '360, 540, 720, 900', alt: article.title
              }}
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'blog-card__image blog-card__image--placeholder' }}
            {% endif %}
          </a>

          <div class="blog-card__body">
            {% assign date = article.published_at | time_tag: format: 'date' %}
            <p class="blog-card__meta">{{ 'blog.article_metadata_html' | t: date: date, author: article.author }}</p>
            <h2 class="blog-card__title">
              <a href="{{ article.url }}">{{ article.title }}</a>
            </h2>
            {% if section.settings.show_excerpt and article.excerpt_or_content != blank %}
              <p class="blog-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
            {% endif %}
            <a class="blog-card__link" href="{{ article.url }}">
              {{ 'blog.read_more' | t }}
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </article>
      {% endfor %}
    </div>

    {% render 'pagination', paginate: paginate %}
  {% endpaginate %}
</div>

{% stylesheet %}
  .blog {
    padding-block: var(--section-spacing);
  }

  .blog__header {
    text-align: center;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .blog__title {
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: clamp(2rem, 4vw, 3.25rem);
  }

  .blog__grid {
    display: grid;
    grid-template-columns: repeat(var(--columns), 1fr);
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  .blog-card {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .blog-card__media {
    overflow: hidden;
    aspect-ratio: 3 / 2;
    background-color: var(--color-surface);
  }

  .blog-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .blog-card__media:hover .blog-card__image {
    transform: scale(1.04);
  }

  .blog-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .blog-card__meta {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .blog-card__title {
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: 1.5rem;
    line-height: 1.2;
  }

  .blog-card__title a {
    color: var(--color-foreground);
    text-decoration: none;
  }

  .blog-card__excerpt {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .blog-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent-strong);
    text-decoration: none;
  }

  .blog-card__link:hover span {
    transform: translateX(0.35rem);
  }

  .blog-card__link span {
    transition: transform 0.3s ease;
  }

  @media (max-width: 989px) {
    .blog__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 649px) {
    .blog__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.blog",
  "settings": [
    {
      "type": "select",
      "id": "columns",
      "label": "t:sections.blog.columns",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }
      ],
      "default": "3"
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "t:sections.blog.show_excerpt",
      "default": true
    }
  ]
}
{% endschema %}
