{% comment %}
  A slim, full-width strip of gifting reassurances. Block-driven so merchants
  can edit the points.
{% endcomment %}

{% liquid
  # A point counts when it carries anything at all, icon included. Requiring a
  # label would silently drop a point a merchant had already configured.
  assign assurance_count = 0
  for block in section.blocks
    if block.settings.label != blank
      assign assurance_count = assurance_count | plus: 1
    elsif block.settings.icon
      assign assurance_count = assurance_count | plus: 1
    endif
  endfor
%}

{%- comment -%}
  A strip with no points is a coloured band and nothing else. It stays up in
  the editor so the merchant can select it while adding the first point.
{%- endcomment -%}
{% if assurance_count > 0 or request.design_mode %}
  <div
    class="giftassure full-width"
    style="--giftassure-bg: {{ section.settings.background_color }}; --giftassure-text: {{ section.settings.text_color }};"
  >
    <ul class="giftassure__list" style="--columns: {{ assurance_count }}">
      {% for block in section.blocks %}
        {% assign point_has_content = false %}
        {% if block.settings.label != blank %}
          {% assign point_has_content = true %}
        {% elsif block.settings.icon %}
          {% assign point_has_content = true %}
        {% endif %}

        {% if point_has_content %}
          <li class="giftassure__item" {{ block.shopify_attributes }}>
            {% if block.settings.icon %}
              {{
                block.settings.icon
                | image_url: width: 96, height: 96
                | image_tag: loading: 'lazy', class: 'giftassure__icon', sizes: '24px', widths: '24, 48, 72, 96', alt: ''
              }}
            {% else %}
              <span class="giftassure__dot" aria-hidden="true"></span>
            {% endif %}
            <span class="giftassure__label">{{ block.settings.label }}</span>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>
{% endif %}

{% stylesheet %}
  .giftassure {
    background-color: var(--giftassure-bg);
    color: var(--giftassure-text);
  }

  .giftassure__list {
    max-width: var(--page-width);
    margin-inline: auto;
    padding-block: 1.35rem;
    padding-inline: var(--page-margin);
    display: grid;
    grid-template-columns: repeat(var(--columns), 1fr);
    gap: 1rem var(--content-gap);
    list-style: none;
  }

  .giftassure__item {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    text-align: center;
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .giftassure__icon {
    width: 1.5rem;
    height: 1.5rem;
    object-fit: contain;
  }

  .giftassure__dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background-color: var(--color-accent);
    flex-shrink: 0;
  }

  @media (max-width: 749px) {
    /* Stack into a single left-aligned checklist so the letter-spaced labels
       aren't forced to wrap in a cramped two-column layout. The block is
       centered while the items align left, keeping the dots in one column. */
    .giftassure__list {
      grid-template-columns: 1fr;
      gap: 0.85rem;
      width: fit-content;
      max-width: 100%;
    }

    .giftassure__item {
      justify-content: flex-start;
      text-align: left;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.gift_assurance.name",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.gift_assurance.background_color",
      "default": "#2a3320"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:sections.gift_assurance.text_color",
      "default": "#fcfaf4"
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "t:sections.gift_assurance.block_name",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "t:sections.gift_assurance.icon"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.gift_assurance.label",
          "default": "Carefully packaged for gifting"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "t:sections.gift_assurance.name",
      "blocks": [
        { "type": "point", "settings": { "label": "Carefully packaged for gifting" } },
        { "type": "point", "settings": { "label": "Add a personal gift note" } },
        { "type": "point", "settings": { "label": "Worldwide delivery available" } },
        { "type": "point", "settings": { "label": "Made to be treasured for years" } }
      ]
    }
  ]
}
{% endschema %}
