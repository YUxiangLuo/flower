{% comment %}
  Merchant-curated product reviews with an overall summary. Block-driven so the
  shop owner enters real reviews; no third-party app or fabricated data. The
  section id is "reviews" so the product buy box can anchor to it.
{% endcomment %}

<div class="reviews reviews--{{ section.settings.background }} full-width" id="reviews">
  <div class="reviews__inner">
    <header class="reviews__header">
      {% if section.settings.eyebrow != blank %}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="reviews__heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.rating != blank %}
        <div class="reviews__summary">
          <span class="reviews__summary-stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
          <span class="reviews__summary-score">{{ section.settings.rating }}</span>
          {% if section.settings.review_count != blank %}
            <span class="reviews__summary-count">
              {{ 'sections.product_reviews.based_on' | t: count: section.settings.review_count }}
            </span>
          {% endif %}
        </div>
      {% endif %}
    </header>

    <div class="reviews__grid">
      {% for block in section.blocks %}
        <figure class="review" {{ block.shopify_attributes }}>
          {% if block.settings.rating > 0 %}
            <div
              class="review__stars"
              aria-label="{{ 'sections.testimonials.rating' | t: rating: block.settings.rating }}"
            >
              {% for i in (1..block.settings.rating) %}
                <span aria-hidden="true">&#9733;</span>
              {% endfor %}
            </div>
          {% endif %}

          {% if block.settings.image %}
            <div class="review__media">
              {{
                block.settings.image
                | image_url: width: 600, height: 600, crop: 'center'
                | image_tag: loading: 'lazy', class: 'review__image', alt: ''
              }}
            </div>
          {% endif %}

          <blockquote class="review__quote">{{ block.settings.quote }}</blockquote>

          <figcaption class="review__footer">
            <span class="review__author">{{ block.settings.author }}</span>
            {% if block.settings.date != blank %}
              <span class="review__date">{{ block.settings.date }}</span>
            {% endif %}
          </figcaption>
        </figure>
      {% endfor %}
    </div>
  </div>
</div>

{% stylesheet %}
  .reviews--page {
    background-color: var(--color-background);
  }
  .reviews--surface {
    background-color: var(--color-surface);
  }
  .reviews--surface-deep {
    background-color: var(--color-surface-deep);
  }

  .reviews__inner {
    max-width: var(--page-width);
    margin-inline: auto;
    padding-block: var(--section-spacing);
    padding-inline: var(--page-margin);
  }

  .reviews__header {
    text-align: center;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .reviews__heading {
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: var(--text-xl);
    line-height: 1.1;
  }

  .reviews__summary {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
    margin-top: var(--space-sm);
  }

  .reviews__summary-stars {
    color: var(--color-accent);
    letter-spacing: 0.1em;
  }

  .reviews__summary-score {
    font-family: var(--font-heading--family);
    font-size: 1.3rem;
  }

  .reviews__summary-count {
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  .reviews__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--content-gap);
  }

  .review {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 0;
    padding: 1.75rem;
    background-color: var(--color-background);
    border: 1px solid var(--color-line);
  }

  .reviews--page .review {
    background-color: var(--color-surface);
  }

  .review__stars {
    display: flex;
    gap: 0.15rem;
    color: var(--color-accent);
    font-size: 0.9rem;
  }

  .review__media {
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background-color: var(--color-surface-deep);
  }

  .review__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .review__quote {
    margin: 0;
    line-height: 1.7;
    color: var(--color-foreground);
  }

  .review__footer {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
  }

  .review__author {
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .review__date {
    font-size: 0.78rem;
    color: var(--color-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.product_reviews.name",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.product_reviews.eyebrow",
      "default": "Loved by gift-givers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.product_reviews.heading",
      "default": "What our customers say"
    },
    {
      "type": "text",
      "id": "rating",
      "label": "t:sections.product_reviews.rating",
      "info": "t:sections.product_reviews.rating_info",
      "default": "4.9"
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "t:sections.product_reviews.review_count",
      "default": "290"
    },
    {
      "type": "select",
      "id": "background",
      "label": "t:sections.product_reviews.background",
      "options": [
        { "value": "page", "label": "t:options.background.page" },
        { "value": "surface", "label": "t:options.background.surface" },
        { "value": "surface-deep", "label": "t:options.background.surface_deep" }
      ],
      "default": "surface"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "t:sections.product_reviews.block_name",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "t:sections.product_reviews.review_rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "t:sections.product_reviews.quote",
          "default": "This pressed flower frame is absolutely breathtaking. Even better in person."
        },
        {
          "type": "text",
          "id": "author",
          "label": "t:sections.product_reviews.author",
          "default": "Sarah M."
        },
        {
          "type": "text",
          "id": "date",
          "label": "t:sections.product_reviews.date"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.product_reviews.image"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "t:sections.product_reviews.name",
      "blocks": [
        { "type": "review" },
        {
          "type": "review",
          "settings": {
            "quote": "It's great, very beautiful. The colours are so vivid.",
            "author": "Odysseas M."
          }
        },
        {
          "type": "review",
          "settings": {
            "quote": "So pleased with my order. Will definitely be purchasing more.",
            "author": "Miss E."
          }
        }
      ]
    }
  ]
}
{% endschema %}
