{% comment %}
  Merchant-curated product reviews with an overall summary. Block-driven so the
  shop owner enters real reviews; no third-party app or fabricated data. The
  section id is "reviews" so the product buy box can anchor to it.
{% endcomment %}

{% liquid
  assign visible_review_count = 0
  for block in section.blocks
    if block.settings.quote != blank
      assign visible_review_count = visible_review_count | plus: 1
    elsif request.design_mode
      assign visible_review_count = visible_review_count | plus: 1
    endif
  endfor

  assign show_reviews = false
  if section.settings.rating != blank
    assign show_reviews = true
  elsif visible_review_count > 0
    assign show_reviews = true
  endif
%}

{% if show_reviews %}
  <div class="reviews reviews--{{ section.settings.background }} full-width" id="reviews">
    <div class="reviews__inner">
      <header class="reviews__header">
        {% if section.settings.eyebrow != blank %}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="reviews__heading">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.rating != blank %}
          {% assign rating_value = section.settings.rating | times: 1 | at_least: 0 | at_most: 5 %}
          {% assign filled_stars = rating_value | round %}
          <div class="reviews__summary">
            <span class="reviews__summary-stars" aria-hidden="true">
              {%- for i in (1..5) -%}
                {%- if i <= filled_stars -%}&#9733;{%- else -%}&#9734;{%- endif -%}
              {%- endfor -%}
            </span>
            <span class="reviews__summary-score">{{ rating_value }}</span>
            {% if section.settings.review_count != blank %}
              {% assign escaped_review_count = section.settings.review_count | escape %}
              <span class="reviews__summary-count">
                {{ 'sections.product_reviews.based_on' | t: count: escaped_review_count }}
              </span>
            {% endif %}
          </div>
        {% endif %}
      </header>

      <div class="reviews__grid">
        {% for block in section.blocks %}
          {% if block.settings.quote != blank %}
            <figure class="review" {{ block.shopify_attributes }}>
              {% if block.settings.rating > 0 %}
                <div
                  class="review__stars"
                  aria-label="{{ 'sections.testimonials.rating' | t: rating: block.settings.rating }}"
                >
                  {% for i in (1..block.settings.rating) %}
                    <span aria-hidden="true">&#9733;</span>
                  {% endfor %}
                </div>
              {% endif %}

              {% if block.settings.image %}
                <div class="review__media">
                  {{
                    block.settings.image
                    | image_url: width: 600, height: 600, crop: 'center'
                    | image_tag: loading: 'lazy', class: 'review__image', sizes: '(min-width: 990px) 33vw, (min-width: 550px) 50vw, 100vw', widths: '240, 360, 480, 600', alt: ''
                  }}
                </div>
              {% endif %}

              <blockquote class="review__quote">{{ block.settings.quote | escape }}</blockquote>

              {% if block.settings.author != blank or block.settings.date != blank %}
                <figcaption class="review__footer">
                  {% if block.settings.author != blank %}
                    <span class="review__author">{{ block.settings.author | escape }}</span>
                  {% endif %}
                  {% if block.settings.date != blank %}
                    <span class="review__date">{{ block.settings.date | escape }}</span>
                  {% endif %}
                </figcaption>
              {% endif %}
            </figure>
          {% elsif request.design_mode %}
            <div class="review review--empty" {{ block.shopify_attributes }}>
              {{ 'sections.product_reviews.add_review' | t }}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .reviews--page {
    background-color: var(--color-background);
  }
  .reviews--surface {
    background-color: var(--color-surface);
  }
  .reviews--surface-deep {
    background-color: var(--color-surface-deep);
  }

  .reviews__inner {
    max-width: var(--page-width);
    margin-inline: auto;
    padding-block: var(--section-spacing);
    padding-inline: var(--page-margin);
  }

  .reviews__header {
    text-align: center;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .reviews__heading {
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: var(--text-xl);
    line-height: 1.1;
  }

  .reviews__summary {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
    margin-top: var(--space-sm);
  }

  .reviews__summary-stars {
    color: var(--color-accent);
    letter-spacing: 0.1em;
  }

  .reviews__summary-score {
    font-family: var(--font-heading--family);
    font-size: 1.3rem;
  }

  .reviews__summary-count {
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  .reviews__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--content-gap);
  }

  .review {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 0;
    padding: 1.75rem;
    background-color: var(--color-background);
    border: 1px solid var(--color-line);
  }

  .reviews--page .review {
    background-color: var(--color-surface);
  }

  .review__stars {
    display: flex;
    gap: 0.15rem;
    color: var(--color-accent);
    font-size: 0.9rem;
  }

  .review__media {
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background-color: var(--color-surface-deep);
  }

  .review__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .review__quote {
    margin: 0;
    line-height: 1.7;
    color: var(--color-foreground);
  }

  .review__footer {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
  }

  .review__author {
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .review__date {
    font-size: 0.78rem;
    color: var(--color-muted);
  }

  .review--empty {
    color: var(--color-muted);
    font-style: italic;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.product_reviews.name",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.product_reviews.eyebrow",
      "default": "Loved by gift-givers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.product_reviews.heading",
      "default": "What our customers say"
    },
    {
      "type": "text",
      "id": "rating",
      "label": "t:sections.product_reviews.rating",
      "info": "t:sections.product_reviews.rating_info"
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "t:sections.product_reviews.review_count"
    },
    {
      "type": "select",
      "id": "background",
      "label": "t:sections.product_reviews.background",
      "options": [
        { "value": "page", "label": "t:options.background.page" },
        { "value": "surface", "label": "t:options.background.surface" },
        { "value": "surface-deep", "label": "t:options.background.surface_deep" }
      ],
      "default": "surface"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "t:sections.product_reviews.block_name",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "t:sections.product_reviews.review_rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 0
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "t:sections.product_reviews.quote"
        },
        {
          "type": "text",
          "id": "author",
          "label": "t:sections.product_reviews.author"
        },
        {
          "type": "text",
          "id": "date",
          "label": "t:sections.product_reviews.date"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.product_reviews.image"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "t:sections.product_reviews.name",
      "blocks": [
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
