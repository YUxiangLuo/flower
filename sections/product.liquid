              lightboxImg.onload = null;
              lightboxImg.onerror = null;
              lightboxImg.src = source.full;
              fullLoader = null;
            });
          };
          loader.onerror = function () {
            if (fullLoader === loader) fullLoader = null;
          };
          loader.src = source.full;
