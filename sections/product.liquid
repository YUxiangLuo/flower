           can move the document vertically when the rail is off-screen. */
        if (scrollThumb !== false && thumbs[index] && (!lightbox || !lightbox.open)) {
          scrollThumbHorizontally(thumbs[index]);
        }
        monitorGalleryImage(index);
      }

      /* Let the buy box switch the gallery to a variant's featured media. */
      root.selectMedia = function (mediaId) {
        for (var i = 0; i < items.length; i++) {
          if (items[i].getAttribute('data-media-id') === String(mediaId)) {
            show(i);
            return;
          }
        }
      };

      thumbs.forEach(function (thumb, i) {
        thumb.addEventListener('click', function () {
          show(i);
        });
      });

      if (galleryPrev) {
        galleryPrev.addEventListener('click', function () {
          show(index - 1);
        });
      }
      if (galleryNext) {
        galleryNext.addEventListener('click', function () {
          show(index + 1);
        });
      }

      /* Left/right arrows move between media when a thumbnail has focus. */
      gallery.addEventListener('keydown', function (event) {
        if (document.activeElement && document.activeElement.hasAttribute('data-thumb')) {
          if (event.key === 'ArrowRight') {
            event.preventDefault();
            show(index + 1);
            thumbs[index].focus();
          } else if (event.key === 'ArrowLeft') {
            event.preventDefault();
            show(index - 1);
            thumbs[index].focus();
          }
        }
      });

      function cancelFullLoader() {
        if (!fullLoader) return;
        fullLoader.onload = null;
        fullLoader.onerror = null;
        if (typeof fullLoader.removeAttribute === 'function') {
          fullLoader.removeAttribute('src');
        }
        fullLoader = null;
      }

      function stopWaitingForStage() {
        if (!lightboxStageCleanup) return;
        lightboxStageCleanup();
        lightboxStageCleanup = null;
      }

      if (lightbox && lightboxImg && typeof lightbox.showModal === 'function') {
        function setLightboxState(state, mediaIndex) {
          var position = imagePosition(mediaIndex);
          var loading = state === 'loading';
          var error = state === 'error';

          if (lightboxCounter) {
            lightboxCounter.textContent = formatMessage(
              positionTemplate,
              position.index,
              position.count
