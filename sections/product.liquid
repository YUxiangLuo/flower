          }
          if (loading) lightbox.setAttribute('aria-busy', 'true');
          else lightbox.removeAttribute('aria-busy');
          if (lightboxLoader) lightboxLoader.hidden = !loading;
          if (lightboxLoaderText) {
            lightboxLoaderText.textContent = loading
              ? formatMessage(loadingTemplate, position.index, position.count)
              : '';
          }
          if (lightboxError) {
            lightboxError.hidden = !error;
            lightboxError.textContent = error ? mediaError : '';
          }
          if (lightboxRetry) lightboxRetry.hidden = !error;
          if (lightboxLive) {
            if (loading) {
              lightboxLive.textContent = formatMessage(
                loadingTemplate,
                position.index,
                position.count
              );
            } else if (error) {
              lightboxLive.textContent = mediaError;
            } else if (state === 'loaded') {
              lightboxLive.textContent = formatMessage(
                loadedTemplate,
                position.index,
                position.count
              );
            } else {
              lightboxLive.textContent = '';
            }
          }
        }

