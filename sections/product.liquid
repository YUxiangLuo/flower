{% comment %}
  Product page. A media gallery (main stage + thumbnails + lightbox) paired with
  a purchase panel, then a full-width story (description + specs) below.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/product
{% endcomment %}

{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign highlight_blocks = section.blocks | where: 'type', 'highlight'
  assign detail_blocks = section.blocks | where: 'type', 'collapsible_row'
  assign personalization_blocks = section.blocks | where: 'type', 'personalization_field'
  assign spec_blocks = section.blocks | where: 'type', 'spec'
  assign image_media = product.media | where: 'media_type', 'image'
%}

<div
  class="product"
  data-product
  data-cart-add-url="{{ routes.cart_add_url }}.js"
  data-status-adding="{{ 'product.adding_to_cart' | t | escape }}"
  data-status-add-error="{{ 'product.add_to_cart_error' | t | escape }}"
  data-media-loading-template="{{ 'sections.product.loading_image' | t: index: '__INDEX__', count: '__COUNT__' | escape }}"
  data-media-position-template="{{ 'sections.product.image_position' | t: index: '__INDEX__', count: '__COUNT__' | escape }}"
  data-media-loaded-template="{{ 'sections.product.image_loaded' | t: index: '__INDEX__', count: '__COUNT__' | escape }}"
  data-media-error="{{ 'sections.product.image_error' | t | escape }}"
>
  <div class="product__top">
    {% render 'product-media-gallery', product: product %}

    <div class="product__info">
      {% if section.settings.show_vendor and product.vendor != blank %}
        <p class="product__vendor">{{ product.vendor }}</p>
      {% endif %}

      <h1 class="product__title">{{ product.title }}</h1>

      <div class="product__price">
        <span class="product__price-current" data-price>{{ current_variant.price | money }}</span>
        <s
          class="product__price-compare"
          data-compare
          {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}
        >
          {{ current_variant.compare_at_price | money }}
        </s>
        <span
          class="product__badge"
          data-badge
          {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}
        >
          {{ 'product.sale' | t }}
        </span>
      </div>

      {% if section.settings.lead_time != blank %}
        <p class="product__lead-time">
          <span class="product__lead-time-dot" aria-hidden="true"></span>
          {{ section.settings.lead_time }}
        </p>
      {% endif %}

      {% form 'product', product, class: 'product__form' %}
        {% render 'product-variant-picker',
          product: product,
          current_variant: current_variant,
          section_id: section.id
        %}
        {% render 'product-personalization-fields',
          blocks: personalization_blocks,
          heading: section.settings.personalization_heading
        %}
        {% render 'product-purchase-actions',
          form: form,
          current_variant: current_variant,
          section_id: section.id
        %}
      {% endform %}

      {% for block in section.blocks %}
        {% if block.type == '@app' %}
          <div class="product__app-block">
            {% render block %}
          </div>
        {% endif %}
      {% endfor %}

      {% if highlight_blocks.size > 0 %}
        <ul class="product__highlights">
          {% for block in highlight_blocks %}
            <li class="product__highlight" {{ block.shopify_attributes }}>
              <span class="product__highlight-mark" aria-hidden="true">&#10022;</span>
              {{ block.settings.text }}
            </li>
          {% endfor %}
        </ul>
      {% endif %}

      {% if detail_blocks.size > 0 %}
        <div class="product__details">
          {% for block in detail_blocks %}
            <details class="product__detail" {{ block.shopify_attributes }}>
              <summary class="product__detail-summary">
                {{ block.settings.heading }}
                <span class="product__detail-icon" aria-hidden="true">&#43;</span>
              </summary>
              <div class="product__detail-content">{{ block.settings.content }}</div>
            </details>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>

  {% render 'product-story', product: product, spec_blocks: spec_blocks %}
  {% render 'product-lightbox', image_media: image_media %}

  <script type="application/json" data-variants>{{ product.variants | json }}</script>

  {%- comment -%}
    variant id -> featured media id. Built in Liquid because `variant | json`
    doesn't include featured_media. Lets the buy box sync the gallery image.
  {%- endcomment -%}
  <script type="application/json" data-variant-media>
    {
      {%- assign media_sep = '' -%}
      {%- for variant in product.variants -%}
        {%- if variant.featured_media -%}
          {{ media_sep }}"{{ variant.id }}": {{ variant.featured_media.id }}
          {%- assign media_sep = ',' -%}
        {%- endif -%}
      {%- endfor -%}
    }
  </script>
</div>

{% stylesheet %}
  .product {
    padding-block: var(--section-spacing);
  }

  .product__top {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: start;
    gap: clamp(2rem, 5vw, 4.5rem);
  }

  /* Gallery — main stage with a horizontal thumbnail strip below it. */
  .product__gallery {
    position: sticky;
    top: 6.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    /* Let the grid track shrink to its fr share instead of being widened by
       the thumbnail strip's intrinsic width (default min-width is auto). */
    min-width: 0;
  }

  .product__stage {
    position: relative;
  }

  .product__stage-nav {
    position: absolute;
    top: 50%;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    color: var(--color-foreground);
    background-color: transparent;
    cursor: pointer;
    transform: translateY(-50%);
    transition:
      color 180ms ease,
      background-color 180ms ease,
      box-shadow 180ms ease;
    -webkit-tap-highlight-color: transparent;
  }

  .product__stage-nav--prev {
    left: 0.75rem;
  }

  .product__stage-nav--next {
    right: 0.75rem;
  }

  .product__stage-nav svg {
    width: 1.8rem;
    height: 1.8rem;
    max-width: none;
    filter: drop-shadow(0 0 2px var(--color-background));
  }

  .product__stage-nav--next svg {
    transform: rotate(180deg);
  }

  .product__stage-nav:hover,
  .product__stage-nav:focus-visible {
    background-color: var(--color-background);
    box-shadow: 0 0.35rem 1.1rem rgb(43 42 28 / 0.18);
  }

  .product__stage-nav:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
  }

  .product__stage-item {
    display: none;
    overflow: hidden;
    background-color: var(--color-surface);
    aspect-ratio: 1 / 1;
  }

  .product__stage-item .product__image {
    transition: opacity 180ms ease, filter 180ms ease;
  }

  .product__stage-item.is-loading .product__image {
    opacity: 0.62;
    filter: saturate(0.8);
  }

  /* Must follow the base rule: same specificity, so source order decides. The
     fallback covers media whose preview image carries no ratio. */
  .product__stage-item--native {
    aspect-ratio: var(--stage-ratio, 1 / 1);
  }

  /* The box already matches the media, so this only guards the rounding. */
  .product__stage-item--native .product__image {
    object-fit: contain;
  }

  .product__stage-item.is-active {
    display: block;
  }

  .product__zoom {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: zoom-in;
  }

  .product__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product__stage-item .product__image--placeholder {
    object-fit: contain;
  }

  .product__thumbs {
    display: flex;
    flex-direction: row;
    gap: 0.6rem;
    overflow-x: auto;
    padding-bottom: 0.25rem;
    /* Scroll the strip horizontally rather than letting it widen the column. */
    min-width: 0;
  }

  .product__thumb {
    position: relative;
    flex: 0 0 auto;
    width: 4.5rem;
    aspect-ratio: 1 / 1;
    padding: 0;
    border: 1px solid transparent;
    background: var(--color-surface);
    cursor: pointer;
    overflow: hidden;
    transition: border-color var(--duration-ui) ease, opacity var(--duration-ui) ease;
    opacity: 0.7;
  }

  .product__thumb:hover,
  .product__thumb:focus-visible {
    opacity: 1;
  }

  .product__thumb.is-active {
    border-color: var(--color-foreground);
    opacity: 1;
  }

  .product__thumb-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product__thumb-badge {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: #fff;
    background-color: rgb(0 0 0 / 0.25);
  }

  .product__thumb-badge svg {
    width: 2.8rem;
    height: 2.8rem;
    max-width: none;
  }

  .product__media-status,
  .product__lightbox-loader,
  .product__lightbox-meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    padding: 0.6rem 0.8rem;
    border-radius: 999px;
    font-size: 0.76rem;
    letter-spacing: 0.06em;
  }

  .product__gallery-status {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 2;
    width: max-content;
    max-width: calc(100% - 2rem);
    color: var(--color-foreground);
    background-color: var(--color-background);
    box-shadow: 0 0.5rem 1.5rem rgb(43 42 28 / 0.14);
    transform: translate(-50%, -50%);
  }

  .product__media-spinner {
    flex: 0 0 auto;
    width: 0.9rem;
    height: 0.9rem;
    border: 2px solid currentcolor;
    border-right-color: transparent;
    border-radius: 50%;
    animation: product-media-spin 700ms linear infinite;
  }

  .product__media-retry {
    padding: 0.25rem 0.5rem;
    border: 1px solid currentcolor;
    border-radius: 999px;
    color: inherit;
    background: transparent;
    font: inherit;
    letter-spacing: inherit;
    cursor: pointer;
  }

  .product__media-status[hidden],
  .product__lightbox-loader[hidden],
  .product__media-spinner[hidden],
  .product__media-retry[hidden] {
    display: none;
  }

  @keyframes product-media-spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* Buy box */
  .product__info {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .product__vendor {
    font-size: 0.78rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-accent-strong);
  }

  .product__title {
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: var(--text-xl);
    line-height: 1.1;
    margin-top: -0.5rem;
  }

  .product__price {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 1.15rem;
  }

  .product__price-compare {
    color: var(--color-muted);
    font-size: 1rem;
  }

  .product__badge {
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent-strong);
    border: 1px solid var(--color-accent-strong);
    padding: 0.15rem 0.5rem;
    align-self: center;
  }

  .product__lead-time {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: -0.75rem;
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  .product__lead-time-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background-color: var(--color-accent);
    flex-shrink: 0;
  }

  .product__form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin: 0;
  }

  .product__options {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .product__option {
    border: 0;
    padding: 0;
    margin: 0;
  }

  .product__option-name {
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 0.75rem;
    padding: 0;
  }

  .product__swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .product__swatch {
    cursor: pointer;
  }

  .product__swatch input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .product__swatch-label {
    display: inline-flex;
    align-items: center;
    padding: 0.55rem 1.1rem;
    font-size: 0.85rem;
    border: 1px solid var(--color-line);
    transition: border-color 0.25s ease, background-color 0.25s ease;
  }

  .product__swatch input:checked + .product__swatch-label {
    border-color: var(--color-foreground);
    background-color: var(--color-surface);
  }

  .product__swatch-chip {
    display: block;
    width: 2.4rem;
    height: 2.4rem;
    border: 1px solid var(--color-line);
    background-size: cover;
    background-position: center;
    transition: box-shadow 0.2s ease;
  }

  .product__swatch input:checked + .product__swatch-chip {
    box-shadow: 0 0 0 2px var(--color-background), 0 0 0 3px var(--color-foreground);
  }

  .product__swatch input:focus-visible + .product__swatch-label,
  .product__swatch input:focus-visible + .product__swatch-chip {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .product__variant-select select {
    width: 100%;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--color-line);
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .product__personalization {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
    border: 1px solid var(--color-line);
    background-color: var(--color-surface);
  }

  .product__personalization-title {
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent-strong);
  }

  .product__field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .product__field-label {
    font-size: 0.85rem;
  }

  .product__field-optional {
    color: var(--color-muted);
    font-size: 0.75rem;
  }

  .product__field-input {
    width: 100%;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--color-line);
    background-color: var(--color-background);
    color: var(--color-foreground);
    resize: vertical;
  }

  .product__field-input:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
  }

  .product__purchase {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .product__add-status {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  /* Nothing to announce, nothing to space out. */
  .product__add-status:empty {
    display: none;
  }

  .product__add-status--error {
    color: #9a2f2f;
  }

  .product__quantity {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .product__quantity-label {
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .product__stepper {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--color-line);
  }

  .product__stepper button {
    width: 2.5rem;
    height: 2.75rem;
    background: transparent;
    border: 0;
    color: var(--color-foreground);
    font-size: 1.1rem;
    cursor: pointer;
  }

  .product__quantity-input {
    width: 3rem;
    height: 2.75rem;
    text-align: center;
    border: 0;
    border-inline: 1px solid var(--color-line);
    background: transparent;
    color: var(--color-foreground);
    -moz-appearance: textfield;
    appearance: textfield;
  }

  .product__quantity-input::-webkit-outer-spin-button,
  .product__quantity-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .product__add {
    width: 100%;
    padding: 1.05rem 2rem;
    font-size: 0.82rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-background);
    background-color: var(--color-foreground);
    border: 1px solid var(--color-foreground);
    cursor: pointer;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .product__add:hover:not(:disabled),
  .product__add:focus-visible:not(:disabled) {
    background-color: transparent;
    color: var(--color-foreground);
  }

  .product__add:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .product__highlights {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-line);
  }

  .product__highlight {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: 0.9rem;
    color: var(--color-muted);
  }

  .product__highlight-mark {
    color: var(--color-accent);
    font-size: 0.75rem;
  }

  .product__details {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-line);
  }

  .product__detail {
    border-bottom: 1px solid var(--color-line);
  }

  .product__detail-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 0;
    cursor: pointer;
    list-style: none;
    font-size: 0.95rem;
  }

  .product__detail-summary::-webkit-details-marker {
    display: none;
  }

  .product__detail-icon {
    color: var(--color-accent);
    transition: transform 0.25s ease;
  }

  .product__detail[open] .product__detail-icon {
    transform: rotate(45deg);
  }

  .product__detail-content {
    padding-bottom: 1.25rem;
    line-height: 1.7;
    color: var(--color-muted);
  }

  .product__detail-content > * + * {
    margin-top: 0.75rem;
  }

  /* Story — single centered column by default, two columns when specs exist. */
  /* No rule between the buy box and the story: a full section of space already
     separates them. Note the rules above are the buy box's own — they sit in
     the right column and stop where it stops, so this one was never closing
     them off, and dropping it leaves the story to open on space alone. */
  .product__story {
    margin-top: var(--section-spacing);
    padding-top: clamp(2.5rem, 5vw, 4rem);
  }

  .product__story--split {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  .product__story-body {
    line-height: 1.8;
    color: var(--color-foreground);
    max-width: 46rem;
    margin-inline: auto;
  }

  .product__story--split .product__story-body {
    max-width: 42rem;
    margin-inline: 0;
  }

  .product__story-body > * + * {
    margin-top: 1rem;
  }

  .product__story-body img {
    margin-block: 1.5rem;
    width: 100%;
  }

  .product__story-body a,
  .product__detail-content a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .product__specs {
    margin: 0;
    align-self: start;
    border-top: 1px solid var(--color-line);
  }

  .product__spec {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--color-line);
    font-size: 0.9rem;
  }

  .product__spec-label {
    color: var(--color-muted);
    letter-spacing: 0.04em;
  }

  .product__spec-value {
    margin: 0;
    text-align: right;
    font-family: var(--font-heading--family);
  }

  /* Lightbox */
  /* Fill the viewport and centre the image with flexbox, rather than relying
     on the browser's default dialog centring (which left it pinned top-left). */
  .product__lightbox {
    position: fixed;
    inset: 0;
    width: 100vw;
    max-width: 100vw;
    height: 100vh;
    max-height: 100vh;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    align-items: center;
    justify-content: center;
  }

  .product__lightbox[open] {
    display: flex;
  }

  .product__lightbox::backdrop {
    background-color: rgb(0 0 0 / 0.8);
  }

  .product__lightbox-image {
    display: block;
    width: auto;
    height: auto;
    max-width: 92vw;
    max-height: 92vh;
    object-fit: contain;
    transition: opacity 180ms ease, filter 180ms ease;
  }

  .product__lightbox[aria-busy='true'] .product__lightbox-image {
    width: min(92vw, 92vh);
    aspect-ratio: 1 / 1;
    object-fit: cover;
    opacity: 0.52;
    filter: blur(5px);
  }

  .product__lightbox-loader {
    position: fixed;
    top: 50%;
    left: 50%;
    z-index: 2;
    width: max-content;
    max-width: calc(100vw - 5rem);
    color: #fff;
    background-color: rgb(0 0 0 / 0.72);
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .product__lightbox-meta {
    position: fixed;
    bottom: 1.25rem;
    left: 50%;
    z-index: 2;
    min-height: 2.25rem;
    color: #fff;
    background-color: rgb(0 0 0 / 0.58);
    transform: translateX(-50%);
  }

  .product__lightbox-counter {
    font-variant-numeric: tabular-nums;
  }

  .product__lightbox-close,
  .product__lightbox-nav {
    position: fixed;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    color: #fff;
    background-color: rgb(0 0 0 / 0.35);
    border: 0;
    cursor: pointer;
  }

  .product__lightbox-close svg,
  .product__lightbox-nav svg {
    width: 1.4rem;
    height: 1.4rem;
  }

  .product__lightbox-close {
    top: 1.25rem;
    right: 1.25rem;
  }

  .product__lightbox-nav--prev {
    top: 50%;
    left: 1.25rem;
    transform: translateY(-50%);
  }

  .product__lightbox-nav--next {
    top: 50%;
    right: 1.25rem;
    transform: translateY(-50%);
  }

  .product__lightbox-nav--next svg {
    transform: rotate(180deg);
  }

  @media (max-width: 989px) {
    .product__top {
      grid-template-columns: 1fr;
      gap: 2rem;
      /* Media leads on mobile; keep a small, deliberate gap under the header. */
      padding-top: 1.5rem;
    }

    .product {
      padding-top: 0;
    }

    .product__gallery {
      position: static;
    }

    .product__stage-nav--prev {
      left: 0.35rem;
    }

    .product__stage-nav--next {
      right: 0.35rem;
    }

    .product__story {
      grid-template-columns: 1fr;
      margin-top: 2.5rem;
    }

    .product__specs {
      order: -1;
    }

    .product__lightbox-nav {
      width: 2.5rem;
      height: 2.5rem;
    }

    .product__lightbox-nav--prev {
      left: 0.5rem;
    }

    .product__lightbox-nav--next {
      right: 0.5rem;
    }

    .product__lightbox-meta {
      bottom: 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product__media-spinner {
      animation: none;
    }

    .product__stage-item .product__image,
    .product__stage-nav,
    .product__lightbox-image {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    function initGallery(root) {
      var gallery = root.querySelector('[data-gallery]');
      if (!gallery) return;
      var items = Array.prototype.slice.call(gallery.querySelectorAll('[data-stage-item]'));
      if (!items.length) return;
      var thumbs = Array.prototype.slice.call(gallery.querySelectorAll('[data-thumb]'));
      var thumbRail = gallery.querySelector('[data-thumbs]');
      var galleryPrev = gallery.querySelector('[data-gallery-prev]');
      var galleryNext = gallery.querySelector('[data-gallery-next]');
      var lightbox = root.querySelector('[data-lightbox]');
      var lightboxImg = lightbox ? lightbox.querySelector('[data-lightbox-image]') : null;
      var galleryStatus = gallery.querySelector('[data-gallery-status]');
      var galleryStatusText = gallery.querySelector('[data-gallery-status-text]');
      var gallerySpinner = gallery.querySelector('[data-gallery-spinner]');
      var galleryRetry = gallery.querySelector('[data-gallery-retry]');
      var galleryLive = gallery.querySelector('[data-gallery-live]');
      var lightboxLoader = lightbox ? lightbox.querySelector('[data-lightbox-loader]') : null;
      var lightboxLoaderText = lightbox
        ? lightbox.querySelector('[data-lightbox-loader-text]')
        : null;
      var lightboxCounter = lightbox ? lightbox.querySelector('[data-lightbox-counter]') : null;
      var lightboxError = lightbox ? lightbox.querySelector('[data-lightbox-error]') : null;
      var lightboxRetry = lightbox ? lightbox.querySelector('[data-lightbox-retry]') : null;
      var lightboxLive = lightbox ? lightbox.querySelector('[data-lightbox-live]') : null;
      var activeIndex = items.findIndex(function (item) {
        return item.classList.contains('is-active');
      });
      var index = activeIndex >= 0 ? activeIndex : 0;
      var galleryRequest = 0;
      var lightboxRequest = 0;
      var galleryDisposed = false;
      var galleryImageCleanup = null;
      var lightboxStageCleanup = null;
      var fullLoader = null;
      var nextFrame = window.requestAnimationFrame
        ? window.requestAnimationFrame.bind(window)
        : function (callback) {
            return window.setTimeout(callback, 0);
          };

      var loadingTemplate =
        root.getAttribute('data-media-loading-template') ||
        'Loading image __INDEX__ of __COUNT__…';
      var positionTemplate =
        root.getAttribute('data-media-position-template') || 'Image __INDEX__ of __COUNT__';
      var loadedTemplate =
        root.getAttribute('data-media-loaded-template') ||
        'Image __INDEX__ of __COUNT__ loaded.';
      var mediaError = root.getAttribute('data-media-error') || 'This image could not be loaded.';

      function formatMessage(template, position, count) {
        return template
          .replace(/__INDEX__/g, String(position))
          .replace(/__COUNT__/g, String(count));
      }

      function galleryMessage(template, mediaIndex) {
        return formatMessage(template, mediaIndex + 1, items.length);
      }

      function decodeImage(image) {
        if (!image || typeof image.decode !== 'function') return Promise.resolve();
        return image.decode().catch(function () {
          /* A completed image is still usable when decode() is unsupported by
             the format or rejects after the resource itself loaded. */
        });
      }

      function setImagePriority(image, active) {
        if (!image) return;
        if (active) {
          image.loading = 'eager';
          image.setAttribute('fetchpriority', 'high');
        } else {
          image.loading = 'lazy';
          image.setAttribute('fetchpriority', 'auto');
        }
      }

      function pauseMedia(item) {
        item.querySelectorAll('video').forEach(function (video) {
          video.pause();
        });
        item.querySelectorAll('model-viewer').forEach(function (model) {
          if (typeof model.pause === 'function') model.pause();
        });
        item.querySelectorAll('iframe').forEach(function (frame) {
          if (!frame.contentWindow) return;
          frame.contentWindow.postMessage(
            JSON.stringify({ event: 'command', func: 'pauseVideo', args: '' }),
            '*'
          );
          frame.contentWindow.postMessage({ method: 'pause' }, '*');
        });
      }

      /* Keep the actual fallback image for every media item. Shopify's video
         markup can include an <img>, and that image needs the same loading,
         error, and retry lifecycle as a regular product image. */
      var galleryImages = items.map(function (item) {
        return item.querySelector('img');
      });

      /* Only image media carry a zoom button. Keep the stage and thumbnail
         elements with their explicit preview/full URLs: the stage's selected
         currentSrc is the lightbox preview, while the full URL is requested
         only after that preview is visible. */
      var sources = items.map(function (item, itemIndex) {
        var btn = item.querySelector('[data-zoom-open]');
        if (!btn) return null;
        var img = galleryImages[itemIndex];
        return {
          preview: btn.getAttribute('data-preview') || '',
          full: btn.getAttribute('data-full') || '',
          alt: (img && img.getAttribute('alt')) || '',
          image: img,
          thumbImage: thumbs[itemIndex] ? thumbs[itemIndex].querySelector('img') : null
        };
      });

      var imageIndexes = [];
      sources.forEach(function (source, mediaIndex) {
        if (source) imageIndexes.push(mediaIndex);
      });

      function imagePosition(mediaIndex) {
        var position = imageIndexes.indexOf(mediaIndex);
        return {
          index: position >= 0 ? position + 1 : 1,
          count: imageIndexes.length || 1
        };
      }

      function setGalleryState(state, mediaIndex) {
        var item = items[mediaIndex];
        var loading = state === 'loading';
        var error = state === 'error';
        if (item) {
          item.classList.toggle('is-loading', loading);
          if (loading) item.setAttribute('aria-busy', 'true');
          else item.removeAttribute('aria-busy');
        }
        if (!galleryStatus) return;

        galleryStatus.hidden = !(loading || error);
        if (gallerySpinner) gallerySpinner.hidden = !loading;
        if (galleryRetry) galleryRetry.hidden = !error;
        if (galleryStatusText) {
          galleryStatusText.textContent = loading
            ? galleryMessage(loadingTemplate, mediaIndex)
            : error
              ? mediaError
              : '';
        }
        if (galleryLive) {
          if (loading) galleryLive.textContent = galleryMessage(loadingTemplate, mediaIndex);
          else if (error) galleryLive.textContent = mediaError;
          else if (state === 'loaded') {
            galleryLive.textContent = galleryMessage(loadedTemplate, mediaIndex);
          } else {
            galleryLive.textContent = '';
          }
        }
      }

      function stopWatchingGalleryImage() {
        if (!galleryImageCleanup) return;
        galleryImageCleanup();
        galleryImageCleanup = null;
      }

      function monitorGalleryImage(mediaIndex) {
        galleryRequest += 1;
        var request = galleryRequest;
        stopWatchingGalleryImage();
        var image = galleryImages[mediaIndex];
        if (!image) {
          setGalleryState('idle', mediaIndex);
          return;
        }

        setImagePriority(image, true);

        function cleanup() {
          image.removeEventListener('load', onLoad);
          image.removeEventListener('error', onError);
        }

        function finish(state) {
          if (request !== galleryRequest || index !== mediaIndex) return;
          cleanup();
          galleryImageCleanup = null;
          setGalleryState(state, mediaIndex);
        }

        function onLoad() {
          decodeImage(image).then(function () {
            finish('loaded');
          });
        }

        function onError() {
          finish('error');
        }

        image.addEventListener('load', onLoad);
        image.addEventListener('error', onError);
        galleryImageCleanup = cleanup;

        if (image.complete) {
          if (image.naturalWidth > 0) onLoad();
          else onError();
        } else {
          setGalleryState('loading', mediaIndex);
        }
      }

      function restartGalleryImage(mediaIndex) {
        var image = galleryImages[mediaIndex];
        if (!image) return;

        galleryRequest += 1;
        stopWatchingGalleryImage();
        setGalleryState('loading', mediaIndex);

        var src = image.getAttribute('src');
        var srcset = image.getAttribute('srcset');
        var sizes = image.getAttribute('sizes');
        image.removeAttribute('src');
        image.removeAttribute('srcset');
        nextFrame(function () {
          if (sizes !== null) image.setAttribute('sizes', sizes);
          if (srcset !== null) image.setAttribute('srcset', srcset);
          if (src !== null) image.setAttribute('src', src);

          /* Selection changes must never strand the retried image without its
             sources. Restore first; only the active item needs fresh
             monitoring and high fetch priority. */
          var active = !galleryDisposed && index === mediaIndex;
          setImagePriority(image, active);
          if (active) monitorGalleryImage(mediaIndex);
        });
      }

      function scrollThumbHorizontally(thumb) {
        if (!thumbRail || !thumb || typeof thumb.getBoundingClientRect !== 'function') return;
        var railRect = thumbRail.getBoundingClientRect();
        var thumbRect = thumb.getBoundingClientRect();
        var delta = 0;
        if (thumbRect.left < railRect.left) {
          delta = thumbRect.left - railRect.left;
        } else if (thumbRect.right > railRect.right) {
          delta = thumbRect.right - railRect.right;
        }
        if (delta) thumbRail.scrollLeft += delta;
      }

      function show(next, scrollThumb) {
        if (next < 0) next = items.length - 1;
        if (next >= items.length) next = 0;
        index = next;
        items.forEach(function (item, i) {
          var active = i === index;
          item.classList.toggle('is-active', active);
          if (!active) {
            item.classList.remove('is-loading');
            item.removeAttribute('aria-busy');
            pauseMedia(item);
          }
          setImagePriority(galleryImages[i], active);
        });
        thumbs.forEach(function (thumb, i) {
          var active = i === index;
          thumb.classList.toggle('is-active', active);
          thumb.setAttribute('aria-current', active ? 'true' : 'false');
        });
