          fullLoader = loader;
          loader.decoding = 'async';
          loader.fetchPriority = 'low';
          loader.onload = function () {
            decodeImage(loader).then(function () {
              if (
                request !== lightboxRequest ||
                index !== mediaIndex ||
                !lightbox.open ||
                fullLoader !== loader
