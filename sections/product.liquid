        function loadLightboxPreview(mediaIndex) {
          var source = sources[mediaIndex];
          if (!source) return;
          lightboxRequest += 1;
          var request = lightboxRequest;
          cancelFullLoader();
          stopWaitingForStage();
          lightboxImg.onload = null;
          lightboxImg.onerror = null;
          lightboxImg.alt = source.alt;
          setLightboxState('loading', mediaIndex);

          /* A loaded thumbnail gives immediate visual continuity. It remains
             deliberately dimmed under the loader until the stage candidate is
             decoded, so it never masquerades as the finished image. */
          var thumbUrl =
            source.thumbImage &&
            (source.thumbImage.currentSrc || source.thumbImage.getAttribute('src'));
          if (thumbUrl) lightboxImg.src = thumbUrl;
          else lightboxImg.removeAttribute('src');

          function loadPreviewUrl(previewUrl) {
            if (!previewUrl) {
              setLightboxState('error', mediaIndex);
              return;
            }

            var targetUrl = new URL(previewUrl, document.baseURI).href;
            var settled = false;

            function matchesTarget() {
              var current = lightboxImg.currentSrc || lightboxImg.src;
              return current && new URL(current, document.baseURI).href === targetUrl;
            }

            function finishPreview() {
              if (
                settled ||
                request !== lightboxRequest ||
                index !== mediaIndex ||
                !lightbox.open ||
                !matchesTarget()
              ) {
                return;
              }
              settled = true;
              decodeImage(lightboxImg).then(function () {
                if (
                  request !== lightboxRequest ||
                  index !== mediaIndex ||
                  !lightbox.open ||
                  !matchesTarget()
                ) {
                  return;
                }
                lightboxImg.onload = null;
                lightboxImg.onerror = null;
                setLightboxState('loaded', mediaIndex);
                upgradeLightbox(source, previewUrl, mediaIndex, request);
              });
            }

            function failPreview() {
              if (
                request !== lightboxRequest ||
                index !== mediaIndex ||
                !lightbox.open ||
                !matchesTarget()
              ) {
                return;
              }
              lightboxImg.onload = null;
              lightboxImg.onerror = null;
              setLightboxState('error', mediaIndex);
            }

            lightboxImg.onload = finishPreview;
            lightboxImg.onerror = failPreview;
            lightboxImg.src = previewUrl;
            if (lightboxImg.complete) {
              if (lightboxImg.naturalWidth > 0) finishPreview();
              else failPreview();
            }
          }

          /* Chromium can keep currentSrc empty for a formerly hidden lazy
             image until that image finishes loading. Listen to the stage
             image instead of guessing a fixed-width fallback: as soon as the
             browser exposes its selected responsive candidate, the lightbox
             uses that exact URL and shares the request/cache entry. */
          function useStageCandidate() {
            if (request !== lightboxRequest || index !== mediaIndex || !lightbox.open) return false;
            var previewUrl = source.image && source.image.currentSrc;
            if (!previewUrl) return false;
            stopWaitingForStage();
            loadPreviewUrl(previewUrl);
            return true;
          }

          function onStageLoad() {
            if (request !== lightboxRequest || index !== mediaIndex || !lightbox.open) return;
            var previewUrl = (source.image && source.image.currentSrc) || source.preview;
            stopWaitingForStage();
            loadPreviewUrl(previewUrl);
          }

          function onStageError() {
            if (request !== lightboxRequest || index !== mediaIndex || !lightbox.open) return;
            stopWaitingForStage();
            setLightboxState('error', mediaIndex);
          }

          if (!source.image) {
            loadPreviewUrl(source.preview);
          } else {
            source.image.addEventListener('load', onStageLoad);
            source.image.addEventListener('error', onStageError);
            lightboxStageCleanup = function () {
              source.image.removeEventListener('load', onStageLoad);
              source.image.removeEventListener('error', onStageError);
            };

            if (!useStageCandidate() && source.image.complete) {
              if (source.image.naturalWidth > 0) onStageLoad();
              else onStageError();
            }
          }
        }

        function openLightbox(i) {
          var source = sources[i];
          if (!source) return;
          show(i, false);
          if (!lightbox.open) lightbox.showModal();
          loadLightboxPreview(i);
        }

        gallery.querySelectorAll('[data-zoom-open]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            openLightbox(parseInt(btn.getAttribute('data-zoom-open'), 10) || 0);
          });
        });

        /* Step to the next/previous image, skipping non-image media (video,
           model) whose cached source is null. */
        function move(step) {
          var n = items.length;
          var i = index;
          for (var k = 0; k < n; k++) {
            i = (i + step + n) % n;
            if (sources[i]) {
              openLightbox(i);
              return;
            }
          }
        }

        var prev = lightbox.querySelector('[data-lightbox-prev]');
        var nextBtn = lightbox.querySelector('[data-lightbox-next]');
        var close = lightbox.querySelector('[data-lightbox-close]');
        if (prev) prev.addEventListener('click', function () { move(-1); });
        if (nextBtn) nextBtn.addEventListener('click', function () { move(1); });
        if (close) close.addEventListener('click', function () { lightbox.close(); });
        if (lightboxRetry) {
          lightboxRetry.addEventListener('click', function () {
            var retryIndex = index;
            setLightboxState('loading', retryIndex);
            restartGalleryImage(retryIndex);
            lightboxImg.removeAttribute('src');
            nextFrame(function () {
              if (index === retryIndex && lightbox.open) loadLightboxPreview(retryIndex);
            });
          });
        }

        lightbox.addEventListener('keydown', function (event) {
          if (event.key === 'ArrowRight') {
            event.preventDefault();
            move(1);
          } else if (event.key === 'ArrowLeft') {
            event.preventDefault();
            move(-1);
          }
        });

        /* Click on the backdrop (outside the image) closes. */
        lightbox.addEventListener('click', function (event) {
          if (event.target === lightbox) lightbox.close();
        });
        lightbox.addEventListener('close', function () {
          lightboxRequest += 1;
          cancelFullLoader();
          stopWaitingForStage();
          lightboxImg.onload = null;
          lightboxImg.onerror = null;
          setLightboxState('idle', index);
        });
      }

      if (galleryRetry) {
        galleryRetry.addEventListener('click', function () {
          restartGalleryImage(index);
        });
      }

      /* Register loading state for the server-rendered active item even when
         there is no variant picker to call selectMedia during buy-box setup. */
      show(index, false);

      root.galleryCleanup = function () {
        galleryDisposed = true;
        galleryRequest += 1;
        lightboxRequest += 1;
        stopWatchingGalleryImage();
        cancelFullLoader();
        stopWaitingForStage();
        if (lightboxImg) {
          lightboxImg.onload = null;
          lightboxImg.onerror = null;
        }
        if (lightbox && lightbox.open) lightbox.close();
      };
    }

    function initBuyBox(root) {
      var select = root.querySelector('[data-variant-select]');
      var selectWrapper = root.querySelector('[data-variant-select-wrapper]');
      var optionInputs = root.querySelectorAll('[data-option-input]');
      var priceEl = root.querySelector('[data-price]');
      var compareEl = root.querySelector('[data-compare]');
      var badgeEl = root.querySelector('[data-badge]');
      var addBtn = root.querySelector('[data-add-button]');
      var paymentButton = root.querySelector('[data-payment-button]');

      var variants = [];
      var dataEl = root.querySelector('[data-variants]');
      if (dataEl) {
        try {
          variants = JSON.parse(dataEl.textContent);
        } catch (e) {
          variants = [];
        }
      }

      var variantMedia = {};
      var mediaMapEl = root.querySelector('[data-variant-media]');
      if (mediaMapEl) {
        try {
          variantMedia = JSON.parse(mediaMapEl.textContent);
        } catch (e) {
          variantMedia = {};
        }
      }

      function selectedValues() {
        var values = [];
        root.querySelectorAll('[data-option-position]').forEach(function (group) {
          var pos = parseInt(group.getAttribute('data-option-position'), 10) - 1;
          var checked = group.querySelector('input:checked');
          if (checked) values[pos] = checked.value;
        });
        return values;
      }

      function findVariant(values) {
        return variants.find(function (variant) {
          if (values.length !== variant.options.length) return false;
          return variant.options.every(function (value, index) {
            return values[index] === value;
          });
        });
      }

      /* Keeps ?variant= in the address bar in sync so the selection survives a
         refresh and can be shared. Uses replaceState to avoid filling up history. */
      function updateUrl(variantId) {
        if (!window.history || !window.history.replaceState) return;
        var url = new URL(window.location.href);
        if (variantId) {
          url.searchParams.set('variant', variantId);
        } else {
          url.searchParams.delete('variant');
        }
        window.history.replaceState({}, '', url.toString());
      }

      function applyOption(option) {
        if (priceEl) {
          priceEl.hidden = !option;
          if (option && option.dataset.price) priceEl.textContent = option.dataset.price;
        }
        if (compareEl) {
          if (option && option.dataset.compare) {
            compareEl.textContent = option.dataset.compare;
            compareEl.hidden = false;
            if (badgeEl) badgeEl.hidden = false;
          } else {
            compareEl.hidden = true;
            if (badgeEl) badgeEl.hidden = true;
          }
        }
        if (addBtn) {
          var available = Boolean(option && option.dataset.available === 'true');
          addBtn.disabled = !available;
          if (!option) {
            addBtn.textContent = addBtn.getAttribute('data-label-unavailable');
          } else {
            addBtn.textContent = available
              ? addBtn.getAttribute('data-label-add')
              : addBtn.getAttribute('data-label-soldout');
          }
        }
        if (paymentButton) paymentButton.hidden = !(option && option.dataset.available === 'true');
      }

      /* Switch the gallery to the variant's featured media when assigned. */
      function selectVariantMedia(variantId) {
        if (typeof root.selectMedia !== 'function') return;
        var mediaId = variantMedia[variantId];
        if (mediaId) root.selectMedia(mediaId);
      }

      function onOptionChange(syncUrl) {
        var variant = findVariant(selectedValues());
        if (variant && select) {
          select.value = String(variant.id);
          applyOption(select.selectedOptions[0]);
          if (syncUrl) updateUrl(variant.id);
          selectVariantMedia(variant.id);
          select.dispatchEvent(new Event('change', { bubbles: true }));
        } else if (select) {
          /* Clear the previously valid id so accelerated checkout and any app
             listeners cannot submit a stale variant for an invalid option set. */
          select.value = '';
          applyOption(null);
          if (syncUrl) updateUrl(null);
          select.dispatchEvent(new Event('change', { bubbles: true }));
        }
      }

      if (optionInputs.length && select) {
        if (selectWrapper) selectWrapper.hidden = true;
        optionInputs.forEach(function (input) {
          input.addEventListener('change', function () {
            onOptionChange(true);
          });
        });
        /* The URL is left untouched on load: Liquid already resolved the variant. */
        onOptionChange(false);
      } else if (select) {
        select.addEventListener('change', function () {
          applyOption(select.selectedOptions[0]);
          updateUrl(select.value);
          selectVariantMedia(select.value);
        });
      }

      var qtyInput = root.querySelector('[data-qty-input]');
      root.querySelectorAll('[data-qty-step]').forEach(function (button) {
        button.addEventListener('click', function () {
          if (!qtyInput) return;
          var step = parseInt(button.getAttribute('data-qty-step'), 10);
          var next = (parseInt(qtyInput.value, 10) || 1) + step;
          if (next < 1) next = 1;
          qtyInput.value = next;
        });
      });

      var form = root.querySelector('.product__form');
      if (!form) return;

      var statusEl = root.querySelector('[data-add-status]');

      function setStatus(message, isError) {
        if (!statusEl) return;
        statusEl.textContent = message || '';
        statusEl.classList.toggle('product__add-status--error', Boolean(isError));
      }

      /* Add through the drawer only when there is a live one to add into.
         The drawer marks itself initialized once it has decided it can run —
         it stands down on the cart page and in browsers without <dialog> — so
         that marker, not merely the element being present, is what says an
         AJAX add has somewhere to show its result. Otherwise the form posts
         normally and the browser lands on the cart page, which is the
         behaviour this replaces. */
      function drawerAvailable() {
        return Boolean(
          window.fetch &&
            window.FormData &&
            document.querySelector('[data-cart-drawer][data-drawer-initialized="true"]')
        );
      }

      form.addEventListener('submit', function (event) {
        /* Don't store blank optional personalization fields as empty line-item
           properties: disabled inputs aren't submitted with the form. */
        root.querySelectorAll('[data-property-optional]').forEach(function (field) {
          if (!field.value.trim()) field.disabled = true;
        });

        if (!drawerAvailable()) return;
        event.preventDefault();
        if (form.getAttribute('data-adding') === 'true') return;

        var drawer = document.querySelector('[data-cart-drawer]');
        var sectionId = drawer.getAttribute('data-section-id');
        var addUrl = root.getAttribute('data-cart-add-url');

        var body = new FormData(form);
        body.append('sections', sectionId);
        body.append('sections_url', window.location.pathname);

        form.setAttribute('data-adding', 'true');
        if (addBtn) addBtn.disabled = true;
        setStatus(root.getAttribute('data-status-adding'), false);

        /* No Content-Type header: the browser has to set the multipart boundary
           itself, and overriding it makes Shopify reject the body. */
        fetch(addUrl, {
          method: 'POST',
          credentials: 'same-origin',
          headers: { Accept: 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
          body: body
        })
          .then(function (response) {
            /* A rejected add may answer with an HTML error page rather than
               JSON, and a dropped connection rejects with the engine's own
               message. Only text the server actually sent is fit to show a
               customer; anything else gets the translated fallback. */
            return response
              .json()
              .catch(function () {
                return {};
              })
              .then(function (data) {
                if (!response.ok) {
                  var responseError = new Error(data.description || data.message || '');
                  responseError.isCartResponseError = true;
                  throw responseError;
                }
                return data;
              });
          })
          .then(function (data) {
            setStatus('', false);
            /* /cart/add.js answers with the line item, not the cart, so there
               is no item count to pass on here. The drawer renders the section
               HTML that came back with it and reports the count from that. */
            document.dispatchEvent(
              new CustomEvent('cart:refresh', { detail: { sections: data.sections } })
            );
            document.dispatchEvent(new CustomEvent('cart:open'));
          })
          .catch(function (error) {
            var message = root.getAttribute('data-status-add-error');
            if (error.isCartResponseError && error.message) message = error.message;
            setStatus(message, true);
          })
          .then(function () {
            form.removeAttribute('data-adding');

            /* Re-enable through the variant logic so a sold-out selection stays
               disabled rather than being switched back on here. An unmatched
               option combination clears the select, leaving selectedIndex at
               -1 and no selected option — passing null is what tells
               applyOption the selection is unbuyable, where falling through to
               a bare re-enable would offer a button that posts an empty id. */
            if (select) applyOption(select.selectedOptions[0] || null);
            else if (addBtn) addBtn.disabled = false;

            /* The properties disabled on the way out have to come back, or a
               second add would drop the customer's personalization. */
            root.querySelectorAll('[data-property-optional]').forEach(function (field) {
              field.disabled = false;
            });
          });
      });
    }

    /* Scope to the section that loaded so re-renders in the theme editor
       (shopify:section:load) re-bind against the fresh DOM. Walk every match
       rather than the first one, so a page carrying more than one product
       section wires up all of them. */
    function initFrom(scope) {
      scope.querySelectorAll('[data-product]').forEach(function (root) {
        if (root.getAttribute('data-product-initialized') === 'true') return;
        root.setAttribute('data-product-initialized', 'true');
        initGallery(root);
        initBuyBox(root);
      });
    }

    initFrom(document);
    document.addEventListener('shopify:section:load', function (event) {
      initFrom(event.target);
    });
    document.addEventListener('shopify:section:unload', function (event) {
      event.target.querySelectorAll('[data-product]').forEach(function (root) {
        if (typeof root.galleryCleanup === 'function') root.galleryCleanup();
      });
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:general.product",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "t:sections.product.show_vendor",
      "default": true
    },
    {
      "type": "text",
      "id": "lead_time",
      "label": "t:sections.product.lead_time",
      "default": "Handcrafted to order · ready in 2–3 weeks"
    },
    {
      "type": "text",
      "id": "personalization_heading",
      "label": "t:sections.product.personalization_heading",
      "default": "Personalise your keepsake"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "personalization_field",
      "name": "t:sections.product.personalization_field",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.product.field_label",
          "default": "Names or message to include"
        },
        {
          "type": "select",
          "id": "field_type",
          "label": "t:sections.product.field_type",
          "options": [
            { "value": "text", "label": "t:sections.product.field_type_text" },
            { "value": "textarea", "label": "t:sections.product.field_type_textarea" }
          ],
          "default": "text"
        },
        {
          "type": "checkbox",
          "id": "required",
          "label": "t:sections.product.field_required",
          "default": false
        }
      ]
    },
    {
      "type": "highlight",
      "name": "t:sections.product.highlight",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.product.highlight_text",
          "default": "Handcrafted to order"
        }
      ]
    },
    {
      "type": "spec",
      "name": "t:sections.product.spec",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.product.spec_label",
          "default": "Frame size"
        },
        {
          "type": "text",
          "id": "value",
          "label": "t:sections.product.spec_value",
          "default": "25 x 25 cm"
        }
      ]
    },
    {
      "type": "collapsible_row",
      "name": "t:sections.product.collapsible",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.product.collapsible_heading",
          "default": "Shipping & Delivery"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "t:sections.product.collapsible_content",
          "default": "<p>Each piece is handcrafted to order and typically takes 2–3 weeks to create. Free worldwide shipping typically takes 7–10 business days after dispatch. Duties are prepaid.</p>"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
