{% comment %}
  Product page. A media gallery (main stage + thumbnails + lightbox) paired with
  a purchase panel, then a full-width story (description + specs) below.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/product
{% endcomment %}

{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign highlight_blocks = section.blocks | where: 'type', 'highlight'
  assign detail_blocks = section.blocks | where: 'type', 'collapsible_row'
  assign personalization_blocks = section.blocks | where: 'type', 'personalization_field'
  assign spec_blocks = section.blocks | where: 'type', 'spec'
%}

<div class="product" data-product>
  <div class="product__top">
    <div class="product__gallery" data-gallery>
      <div class="product__stage">
        {% if product.media.size > 0 %}
          {% for media in product.media %}
            <div
              class="product__stage-item{% if forloop.first %} is-active{% endif %}"
              data-stage-item
              data-media-index="{{ forloop.index0 }}"
            >
              {% if media.media_type == 'image' %}
                <button
                  type="button"
                  class="product__zoom"
                  data-zoom-open="{{ forloop.index0 }}"
                  aria-label="{{ 'sections.product.zoom' | t }}"
                >
                  {% if forloop.first %}
                    {{
                      media.preview_image
                      | image_url: width: 1600
                      | image_tag: loading: 'eager', fetchpriority: 'high', class: 'product__image', sizes: '(min-width: 750px) 50vw, 100vw', widths: '400, 600, 800, 1200, 1600', alt: media.preview_image.alt | default: product.title
                    }}
                  {% else %}
                    {{
                      media.preview_image
                      | image_url: width: 1600
                      | image_tag: loading: 'lazy', class: 'product__image', sizes: '(min-width: 750px) 50vw, 100vw', widths: '400, 600, 800, 1200, 1600', alt: media.preview_image.alt | default: product.title
                    }}
                  {% endif %}
                </button>
              {% else %}
                {{ media | media_tag: class: 'product__image', image_size: '1600x' }}
              {% endif %}
            </div>
          {% endfor %}
        {% else %}
          <div class="product__stage-item is-active" data-stage-item data-media-index="0">
            {{ 'product-1' | placeholder_svg_tag: 'product__image product__image--placeholder' }}
          </div>
        {% endif %}
      </div>

      {% if product.media.size > 1 %}
        <div class="product__thumb-rail" data-thumb-rail>
          <div class="product__thumbs" data-thumbs role="group" aria-label="{{ 'sections.product.thumbnails' | t }}">
            {% for media in product.media %}
              <button
                type="button"
                class="product__thumb{% if forloop.first %} is-active{% endif %}"
                data-thumb="{{ forloop.index0 }}"
                aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-label="{{ 'sections.product.go_to_media' | t: index: forloop.index }}"
              >
                {{
                  media.preview_image
                  | image_url: width: 200, height: 200, crop: 'center'
                  | image_tag: loading: 'lazy', class: 'product__thumb-image', alt: ''
                }}
                {% if media.media_type != 'image' %}
                  <span class="product__thumb-badge" aria-hidden="true">&#9658;</span>
                {% endif %}
              </button>
            {% endfor %}
          </div>
        </div>
      {% endif %}
    </div>

    <div class="product__info">
      {% if section.settings.show_vendor and product.vendor != blank %}
        <p class="product__vendor">{{ product.vendor }}</p>
      {% endif %}

      <h1 class="product__title">{{ product.title }}</h1>

      {% if section.settings.show_rating %}
        <a class="product__rating" href="#reviews">
          <span class="product__rating-stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
          {{ 'sections.product.read_reviews' | t }}
        </a>
      {% endif %}

      <div class="product__price">
        <span class="product__price-current" data-price>{{ current_variant.price | money }}</span>
        <s
          class="product__price-compare"
          data-compare
          {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}
        >
          {{ current_variant.compare_at_price | money }}
        </s>
        <span
          class="product__badge"
          data-badge
          {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}
        >
          {{ 'product.sale' | t }}
        </span>
      </div>

      {% if section.settings.lead_time != blank %}
        <p class="product__lead-time">
          <span class="product__lead-time-dot" aria-hidden="true"></span>
          {{ section.settings.lead_time }}
        </p>
      {% endif %}

      {% form 'product', product, class: 'product__form' %}
        {% unless product.has_only_default_variant %}
          <div class="product__options">
            {% for option in product.options_with_values %}
              <fieldset class="product__option" data-option-position="{{ option.position }}">
                <legend class="product__option-name">{{ option.name }}</legend>
                <div class="product__swatches">
                  {% for value in option.values %}
                    <label class="product__swatch">
                      <input
                        type="radio"
                        name="option-{{ option.position }}"
                        value="{{ value | escape }}"
                        data-option-input
                        {% if option.selected_value == value %}checked{% endif %}
                      >
                      {% if value.swatch.image %}
                        <span
                          class="product__swatch-chip"
                          style="background-image: url({{ value.swatch.image | image_url: width: 80 }})"
                        ></span>
                        <span class="visually-hidden">{{ value }}</span>
                      {% elsif value.swatch.color %}
                        <span
                          class="product__swatch-chip"
                          style="background-color: {{ value.swatch.color }}"
                        ></span>
                        <span class="visually-hidden">{{ value }}</span>
                      {% else %}
                        <span class="product__swatch-label">{{ value }}</span>
                      {% endif %}
                    </label>
                  {% endfor %}
                </div>
              </fieldset>
            {% endfor %}
          </div>
        {% endunless %}

        <div
          class="product__variant-select"
          data-variant-select-wrapper
          {% if product.has_only_default_variant %}hidden{% endif %}
        >
          <label class="visually-hidden" for="variant-id">{{ 'product.variant' | t }}</label>
          <select name="id" id="variant-id" data-variant-select>
            {% for variant in product.variants %}
              <option
                value="{{ variant.id }}"
                {% if variant == current_variant %}selected{% endif %}
                {% unless variant.available %}disabled{% endunless %}
                data-price="{{ variant.price | money }}"
                {% if variant.compare_at_price > variant.price %}data-compare="{{ variant.compare_at_price | money }}"{% endif %}
                data-available="{{ variant.available }}"
              >
                {% if variant.available %}
                  {{ variant.title }} &middot; {{ variant.price | money }}
                {% else %}
                  {{ variant.title }} &middot; {{ 'product.sold_out' | t }}
                {% endif %}
              </option>
            {% endfor %}
          </select>
        </div>

        {% if personalization_blocks.size > 0 %}
          <div class="product__personalization">
            {% if section.settings.personalization_heading != blank %}
              <p class="product__personalization-title">{{ section.settings.personalization_heading }}</p>
            {% endif %}
            {% for block in personalization_blocks %}
              <div class="product__field" {{ block.shopify_attributes }}>
                <label class="product__field-label" for="prop-{{ block.id }}">
                  {{ block.settings.label }}
                  {% unless block.settings.required %}
                    <span class="product__field-optional">{{ 'product.optional' | t }}</span>
                  {% endunless %}
                </label>
                {% if block.settings.field_type == 'textarea' %}
                  <textarea
                    class="product__field-input"
                    id="prop-{{ block.id }}"
                    name="properties[{{ block.settings.label | escape }}]"
                    rows="3"
                    {% if block.settings.required %}required{% else %}data-property-optional{% endif %}
                  ></textarea>
                {% else %}
                  <input
                    class="product__field-input"
                    type="text"
                    id="prop-{{ block.id }}"
                    name="properties[{{ block.settings.label | escape }}]"
                    {% if block.settings.required %}required{% else %}data-property-optional{% endif %}
                  >
                {% endif %}
              </div>
            {% endfor %}
          </div>
        {% endif %}

        <div class="product__purchase">
          <div class="product__quantity">
            <span class="product__quantity-label">{{ 'product.quantity' | t }}</span>
            <div class="product__stepper">
              <button type="button" data-qty-step="-1" aria-label="{{ 'product.decrease_quantity' | t }}">&minus;</button>
              <input
                class="product__quantity-input"
                type="number"
                name="quantity"
                value="1"
                min="1"
                data-qty-input
              >
              <button type="button" data-qty-step="1" aria-label="{{ 'product.increase_quantity' | t }}">+</button>
            </div>
          </div>

          <button
            type="submit"
            name="add"
            class="product__add"
            data-add-button
            data-label-add="{{ 'product.add_to_cart' | t }}"
            data-label-soldout="{{ 'product.sold_out' | t }}"
            data-label-unavailable="{{ 'product.unavailable' | t }}"
            {% unless current_variant.available %}disabled{% endunless %}
          >
            {% if current_variant.available %}
              {{ 'product.add_to_cart' | t }}
            {% else %}
              {{ 'product.sold_out' | t }}
            {% endif %}
          </button>

          {{ form | payment_button }}
        </div>
      {% endform %}

      {% if highlight_blocks.size > 0 %}
        <ul class="product__highlights">
          {% for block in highlight_blocks %}
            <li class="product__highlight" {{ block.shopify_attributes }}>
              <span class="product__highlight-mark" aria-hidden="true">&#10022;</span>
              {{ block.settings.text }}
            </li>
          {% endfor %}
        </ul>
      {% endif %}

      {% if detail_blocks.size > 0 %}
        <div class="product__details">
          {% for block in detail_blocks %}
            <details class="product__detail" {{ block.shopify_attributes }}>
              <summary class="product__detail-summary">
                {{ block.settings.heading }}
                <span class="product__detail-icon" aria-hidden="true">&#43;</span>
              </summary>
              <div class="product__detail-content">{{ block.settings.content }}</div>
            </details>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>

  {% if product.description != blank or spec_blocks.size > 0 %}
    <div class="product__story{% if spec_blocks.size > 0 and product.description != blank %} product__story--split{% endif %}">
      {% if product.description != blank %}
        <div class="product__story-body">{{ product.description }}</div>
      {% endif %}
      {% if spec_blocks.size > 0 %}
        <dl class="product__specs">
          {% for block in spec_blocks %}
            <div class="product__spec" {{ block.shopify_attributes }}>
              <dt class="product__spec-label">{{ block.settings.label }}</dt>
              <dd class="product__spec-value">{{ block.settings.value }}</dd>
            </div>
          {% endfor %}
        </dl>
      {% endif %}
    </div>
  {% endif %}

  {% if product.media.size > 1 %}
    <dialog class="product__lightbox" data-lightbox aria-label="{{ 'sections.product.gallery' | t }}">
      <button
        type="button"
        class="product__lightbox-close"
        data-lightbox-close
        aria-label="{{ 'sections.product.close' | t }}"
      >
        {{- 'icon-close.svg' | inline_asset_content -}}
      </button>
      <button
        type="button"
        class="product__lightbox-nav product__lightbox-nav--prev"
        data-lightbox-prev
        aria-label="{{ 'sections.product.previous_media' | t }}"
      >
        {{- 'icon-chevron.svg' | inline_asset_content -}}
      </button>
      {% # theme-check-disable ImgWidthAndHeight, RemoteAsset %}
      <img class="product__lightbox-image" data-lightbox-image alt="">
      {% # theme-check-enable ImgWidthAndHeight, RemoteAsset %}
      <button
        type="button"
        class="product__lightbox-nav product__lightbox-nav--next"
        data-lightbox-next
        aria-label="{{ 'sections.product.next_media' | t }}"
      >
        {{- 'icon-chevron.svg' | inline_asset_content -}}
      </button>
    </dialog>
  {% endif %}

  <script type="application/json" data-variants>{{ product.variants | json }}</script>
</div>

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% stylesheet %}
  .product {
    padding-block: var(--section-spacing);
  }

  .product__top {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: start;
    gap: clamp(2rem, 5vw, 4.5rem);
  }

  /* Gallery */
  .product__gallery {
    position: sticky;
    top: 6.5rem;
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 1rem;
    align-items: start;
  }

  .product__stage {
    position: relative;
    order: 2;
  }

  .product__stage-item {
    display: none;
    overflow: hidden;
    background-color: var(--color-surface);
    aspect-ratio: 1 / 1;
  }

  .product__stage-item.is-active {
    display: block;
  }

  .product__zoom {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: zoom-in;
  }

  .product__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product__stage-item .product__image--placeholder {
    object-fit: contain;
  }

  /* Wrapper carries the edge fades; the inner rail is what actually scrolls,
     so the fades stay pinned while thumbnails move under them. */
  .product__thumb-rail {
    order: 1;
    position: relative;
    min-height: 0;
  }

  .product__thumb-rail::before,
  .product__thumb-rail::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    height: 2.25rem;
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--duration-ui) ease;
    z-index: 1;
  }

  .product__thumb-rail::before {
    top: 0;
    background: linear-gradient(to bottom, var(--color-background), transparent);
  }

  .product__thumb-rail::after {
    bottom: 0;
    background: linear-gradient(to top, var(--color-background), transparent);
  }

  /* JS sets these when there is more to scroll in that direction. */
  .product__thumb-rail[data-fade-start]::before,
  .product__thumb-rail[data-fade-end]::after {
    opacity: 1;
  }

  .product__thumbs {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    /* Fallback cap; JS narrows this to the main image's exact height so the
       rail never grows taller than the stage beside it. */
    max-height: 34rem;
    overflow-y: auto;
    scrollbar-width: none;
  }

  .product__thumbs::-webkit-scrollbar {
    display: none;
  }

  .product__thumb {
    position: relative;
    flex: 0 0 auto;
    width: 4.5rem;
    aspect-ratio: 1 / 1;
    padding: 0;
    border: 1px solid transparent;
    background: var(--color-surface);
    cursor: pointer;
    overflow: hidden;
    transition: border-color var(--duration-ui) ease, opacity var(--duration-ui) ease;
    opacity: 0.7;
  }

  .product__thumb:hover,
  .product__thumb:focus-visible {
    opacity: 1;
  }

  .product__thumb.is-active {
    border-color: var(--color-foreground);
    opacity: 1;
  }

  .product__thumb-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product__thumb-badge {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.9rem;
    color: #fff;
    background-color: rgb(0 0 0 / 0.25);
  }

  /* Buy box */
  .product__info {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .product__vendor {
    font-size: 0.78rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-accent-strong);
  }

  .product__title {
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: var(--text-xl);
    line-height: 1.1;
    margin-top: -0.5rem;
  }

  .product__rating {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: -0.75rem;
    font-size: 0.85rem;
    color: var(--color-muted);
    text-decoration: none;
  }

  .product__rating-stars {
    color: var(--color-accent);
    letter-spacing: 0.1em;
  }

  .product__rating:hover,
  .product__rating:focus-visible {
    color: var(--color-foreground);
  }

  .product__price {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 1.15rem;
  }

  .product__price-compare {
    color: var(--color-muted);
    font-size: 1rem;
  }

  .product__badge {
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent-strong);
    border: 1px solid var(--color-accent-strong);
    padding: 0.15rem 0.5rem;
    align-self: center;
  }

  .product__lead-time {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: -0.75rem;
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  .product__lead-time-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background-color: var(--color-accent);
    flex-shrink: 0;
  }

  .product__form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin: 0;
  }

  .product__options {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .product__option {
    border: 0;
    padding: 0;
    margin: 0;
  }

  .product__option-name {
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 0.75rem;
    padding: 0;
  }

  .product__swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .product__swatch {
    cursor: pointer;
  }

  .product__swatch input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .product__swatch-label {
    display: inline-flex;
    align-items: center;
    padding: 0.55rem 1.1rem;
    font-size: 0.85rem;
    border: 1px solid var(--color-line);
    transition: border-color 0.25s ease, background-color 0.25s ease;
  }

  .product__swatch input:checked + .product__swatch-label {
    border-color: var(--color-foreground);
    background-color: var(--color-surface);
  }

  .product__swatch-chip {
    display: block;
    width: 2.4rem;
    height: 2.4rem;
    border: 1px solid var(--color-line);
    background-size: cover;
    background-position: center;
    transition: box-shadow 0.2s ease;
  }

  .product__swatch input:checked + .product__swatch-chip {
    box-shadow: 0 0 0 2px var(--color-background), 0 0 0 3px var(--color-foreground);
  }

  .product__swatch input:focus-visible + .product__swatch-label,
  .product__swatch input:focus-visible + .product__swatch-chip {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .product__variant-select select {
    width: 100%;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--color-line);
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .product__personalization {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
    border: 1px solid var(--color-line);
    background-color: var(--color-surface);
  }

  .product__personalization-title {
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent-strong);
  }

  .product__field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .product__field-label {
    font-size: 0.85rem;
  }

  .product__field-optional {
    color: var(--color-muted);
    font-size: 0.75rem;
  }

  .product__field-input {
    width: 100%;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--color-line);
    background-color: var(--color-background);
    color: var(--color-foreground);
    resize: vertical;
  }

  .product__field-input:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
  }

  .product__purchase {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .product__quantity {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .product__quantity-label {
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .product__stepper {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--color-line);
  }

  .product__stepper button {
    width: 2.5rem;
    height: 2.75rem;
    background: transparent;
    border: 0;
    color: var(--color-foreground);
    font-size: 1.1rem;
    cursor: pointer;
  }

  .product__quantity-input {
    width: 3rem;
    height: 2.75rem;
    text-align: center;
    border: 0;
    border-inline: 1px solid var(--color-line);
    background: transparent;
    color: var(--color-foreground);
    -moz-appearance: textfield;
    appearance: textfield;
  }

  .product__quantity-input::-webkit-outer-spin-button,
  .product__quantity-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .product__add {
    width: 100%;
    padding: 1.05rem 2rem;
    font-size: 0.82rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-background);
    background-color: var(--color-foreground);
    border: 1px solid var(--color-foreground);
    cursor: pointer;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .product__add:hover:not(:disabled),
  .product__add:focus-visible:not(:disabled) {
    background-color: transparent;
    color: var(--color-foreground);
  }

  .product__add:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .product__highlights {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-line);
  }

  .product__highlight {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: 0.9rem;
    color: var(--color-muted);
  }

  .product__highlight-mark {
    color: var(--color-accent);
    font-size: 0.75rem;
  }

  .product__details {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-line);
  }

  .product__detail {
    border-bottom: 1px solid var(--color-line);
  }

  .product__detail-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 0;
    cursor: pointer;
    list-style: none;
    font-size: 0.95rem;
  }

  .product__detail-summary::-webkit-details-marker {
    display: none;
  }

  .product__detail-icon {
    color: var(--color-accent);
    transition: transform 0.25s ease;
  }

  .product__detail[open] .product__detail-icon {
    transform: rotate(45deg);
  }

  .product__detail-content {
    padding-bottom: 1.25rem;
    line-height: 1.7;
    color: var(--color-muted);
  }

  .product__detail-content > * + * {
    margin-top: 0.75rem;
  }

  /* Story — single centered column by default, two columns when specs exist. */
  .product__story {
    margin-top: var(--section-spacing);
    padding-top: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--color-line);
  }

  .product__story--split {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  .product__story-body {
    line-height: 1.8;
    color: var(--color-foreground);
    max-width: 46rem;
    margin-inline: auto;
  }

  .product__story--split .product__story-body {
    max-width: 42rem;
    margin-inline: 0;
  }

  .product__story-body > * + * {
    margin-top: 1rem;
  }

  .product__story-body img {
    margin-block: 1.5rem;
    width: 100%;
  }

  .product__story-body a,
  .product__detail-content a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .product__specs {
    margin: 0;
    align-self: start;
    border-top: 1px solid var(--color-line);
  }

  .product__spec {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--color-line);
    font-size: 0.9rem;
  }

  .product__spec-label {
    color: var(--color-muted);
    letter-spacing: 0.04em;
  }

  .product__spec-value {
    margin: 0;
    text-align: right;
    font-family: var(--font-heading--family);
  }

  /* Lightbox */
  .product__lightbox {
    width: min(92vw, 60rem);
    max-width: 92vw;
    max-height: 92vh;
    padding: 0;
    border: 0;
    background: transparent;
  }

  .product__lightbox::backdrop {
    background-color: rgb(0 0 0 / 0.8);
  }

  .product__lightbox-image {
    display: block;
    width: 100%;
    max-height: 92vh;
    object-fit: contain;
  }

  .product__lightbox-close,
  .product__lightbox-nav {
    position: fixed;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    color: #fff;
    background-color: rgb(0 0 0 / 0.35);
    border: 0;
    cursor: pointer;
  }

  .product__lightbox-close svg,
  .product__lightbox-nav svg {
    width: 1.4rem;
    height: 1.4rem;
  }

  .product__lightbox-close {
    top: 1.25rem;
    right: 1.25rem;
  }

  .product__lightbox-nav--prev {
    top: 50%;
    left: 1.25rem;
    transform: translateY(-50%);
  }

  .product__lightbox-nav--next {
    top: 50%;
    right: 1.25rem;
    transform: translateY(-50%);
  }

  .product__lightbox-nav--next svg {
    transform: rotate(180deg);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (max-width: 989px) {
    .product__top {
      grid-template-columns: 1fr;
      gap: 2rem;
      /* Media leads on mobile; keep a small, deliberate gap under the header. */
      padding-top: 1.5rem;
    }

    .product {
      padding-top: 0;
    }

    .product__gallery {
      position: static;
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .product__thumb-rail {
      order: 2;
    }

    /* Horizontal rail on mobile — fade the left/right edges instead. */
    .product__thumb-rail::before,
    .product__thumb-rail::after {
      inset-inline: auto;
      top: 0;
      bottom: 0;
      width: 2.25rem;
      height: auto;
    }

    .product__thumb-rail::before {
      left: 0;
      background: linear-gradient(to right, var(--color-background), transparent);
    }

    .product__thumb-rail::after {
      right: 0;
      background: linear-gradient(to left, var(--color-background), transparent);
    }

    .product__thumbs {
      flex-direction: row;
      max-height: none;
      overflow-x: auto;
      padding-bottom: 0.25rem;
    }

    .product__story {
      grid-template-columns: 1fr;
      margin-top: 2.5rem;
    }

    .product__specs {
      order: -1;
    }

    .product__lightbox-nav {
      width: 2.5rem;
      height: 2.5rem;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    function initGallery(root) {
      var gallery = root.querySelector('[data-gallery]');
      if (!gallery) return;
      var items = Array.prototype.slice.call(gallery.querySelectorAll('[data-stage-item]'));
      var thumbs = Array.prototype.slice.call(gallery.querySelectorAll('[data-thumb]'));
      var lightbox = root.querySelector('[data-lightbox]');
      var lightboxImg = lightbox ? lightbox.querySelector('[data-lightbox-image]') : null;
      var rail = gallery.querySelector('[data-thumb-rail]');
      var scroller = gallery.querySelector('[data-thumbs]');
      var stage = gallery.querySelector('.product__stage');
      var index = 0;

      /* Cap the vertical rail to the main image's height so a long list of
         thumbnails scrolls within the stage instead of towering beside it.
         On mobile the rail is a horizontal strip, so leave it uncapped. */
      function syncRailHeight() {
        if (scroller && stage) {
          if (window.matchMedia('(max-width: 989px)').matches) {
            scroller.style.maxHeight = '';
          } else {
            scroller.style.maxHeight = stage.offsetHeight + 'px';
          }
        }
        updateFades();
      }

      /* Show a soft fade on whichever edge still has thumbnails to scroll to,
         so a long rail reads as scrollable. Axis follows the layout: vertical
         on desktop, horizontal on mobile. */
      function updateFades() {
        if (!rail || !scroller) return;
        var vertical = scroller.scrollHeight > scroller.clientHeight + 1;
        var start;
        var end;
        if (vertical) {
          start = scroller.scrollTop > 1;
          end = scroller.scrollTop + scroller.clientHeight < scroller.scrollHeight - 1;
        } else {
          start = scroller.scrollLeft > 1;
          end = scroller.scrollLeft + scroller.clientWidth < scroller.scrollWidth - 1;
        }
        rail.toggleAttribute('data-fade-start', start);
        rail.toggleAttribute('data-fade-end', end);
      }

      /* Cache the largest source for each image so the lightbox shows full detail. */
      var sources = items.map(function (item) {
        var img = item.querySelector('img');
        if (!img) return null;
        return { src: img.currentSrc || img.src, alt: img.getAttribute('alt') || '' };
      });

      function show(next) {
        if (next < 0) next = items.length - 1;
        if (next >= items.length) next = 0;
        index = next;
        items.forEach(function (item, i) {
          item.classList.toggle('is-active', i === index);
        });
        thumbs.forEach(function (thumb, i) {
          var active = i === index;
          thumb.classList.toggle('is-active', active);
          thumb.setAttribute('aria-current', active ? 'true' : 'false');
        });
        if (thumbs[index]) {
          thumbs[index].scrollIntoView({ block: 'nearest', inline: 'nearest' });
        }
        updateFades();
      }

      thumbs.forEach(function (thumb, i) {
        thumb.addEventListener('click', function () {
          show(i);
        });
      });

      /* Left/right arrows move between media when a thumbnail has focus. */
      gallery.addEventListener('keydown', function (event) {
        if (document.activeElement && document.activeElement.hasAttribute('data-thumb')) {
          if (event.key === 'ArrowRight') {
            event.preventDefault();
            show(index + 1);
            thumbs[index].focus();
          } else if (event.key === 'ArrowLeft') {
            event.preventDefault();
            show(index - 1);
            thumbs[index].focus();
          }
        }
      });

      if (scroller) {
        scroller.addEventListener('scroll', updateFades);
        window.addEventListener('resize', syncRailHeight);
        window.addEventListener('load', syncRailHeight);
        syncRailHeight();
      }

      if (lightbox && lightboxImg && typeof lightbox.showModal === 'function') {
        function openLightbox(i) {
          show(i);
          var source = sources[i];
          if (!source) return;
          lightboxImg.src = source.src;
          lightboxImg.alt = source.alt;
          lightbox.showModal();
        }

        gallery.querySelectorAll('[data-zoom-open]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            openLightbox(parseInt(btn.getAttribute('data-zoom-open'), 10) || 0);
          });
        });

        function move(step) {
          var next = index + step;
          if (next < 0) next = items.length - 1;
          if (next >= items.length) next = 0;
          openLightbox(next);
        }

        var prev = lightbox.querySelector('[data-lightbox-prev]');
        var nextBtn = lightbox.querySelector('[data-lightbox-next]');
        var close = lightbox.querySelector('[data-lightbox-close]');
        if (prev) prev.addEventListener('click', function () { move(-1); });
        if (nextBtn) nextBtn.addEventListener('click', function () { move(1); });
        if (close) close.addEventListener('click', function () { lightbox.close(); });

        lightbox.addEventListener('keydown', function (event) {
          if (event.key === 'ArrowRight') move(1);
          else if (event.key === 'ArrowLeft') move(-1);
        });

        /* Click on the backdrop (outside the image) closes. */
        lightbox.addEventListener('click', function (event) {
          if (event.target === lightbox) lightbox.close();
        });
      }
    }

    function initBuyBox(root) {
      var select = root.querySelector('[data-variant-select]');
      var selectWrapper = root.querySelector('[data-variant-select-wrapper]');
      var optionInputs = root.querySelectorAll('[data-option-input]');
      var priceEl = root.querySelector('[data-price]');
      var compareEl = root.querySelector('[data-compare]');
      var badgeEl = root.querySelector('[data-badge]');
      var addBtn = root.querySelector('[data-add-button]');

      var variants = [];
      var dataEl = root.querySelector('[data-variants]');
      if (dataEl) {
        try {
          variants = JSON.parse(dataEl.textContent);
        } catch (e) {
          variants = [];
        }
      }

      function selectedValues() {
        var values = [];
        root.querySelectorAll('[data-option-position]').forEach(function (group) {
          var pos = parseInt(group.getAttribute('data-option-position'), 10) - 1;
          var checked = group.querySelector('input:checked');
          if (checked) values[pos] = checked.value;
        });
        return values;
      }

      function findVariant(values) {
        return variants.find(function (variant) {
          return values.every(function (value, index) {
            return variant.options[index] === value;
          });
        });
      }

      /* Keeps ?variant= in the address bar in sync so the selection survives a
         refresh and can be shared. Uses replaceState to avoid filling up history. */
      function updateUrl(variantId) {
        if (!variantId || !window.history || !window.history.replaceState) return;
        var url = new URL(window.location.href);
        url.searchParams.set('variant', variantId);
        window.history.replaceState({}, '', url.toString());
      }

      function applyOption(option) {
        if (!option) return;
        if (priceEl && option.dataset.price) priceEl.textContent = option.dataset.price;
        if (compareEl) {
          if (option.dataset.compare) {
            compareEl.textContent = option.dataset.compare;
            compareEl.hidden = false;
            if (badgeEl) badgeEl.hidden = false;
          } else {
            compareEl.hidden = true;
            if (badgeEl) badgeEl.hidden = true;
          }
        }
        if (addBtn) {
          var available = option.dataset.available === 'true';
          addBtn.disabled = !available;
          addBtn.textContent = available
            ? addBtn.getAttribute('data-label-add')
            : addBtn.getAttribute('data-label-soldout');
        }
      }

      function onOptionChange(syncUrl) {
        var variant = findVariant(selectedValues());
        if (variant && select) select.value = variant.id;
        if (variant && select) {
          applyOption(select.selectedOptions[0]);
          if (syncUrl) updateUrl(variant.id);
        } else if (addBtn) {
          addBtn.disabled = true;
          addBtn.textContent = addBtn.getAttribute('data-label-unavailable');
        }
      }

      if (optionInputs.length && select) {
        if (selectWrapper) selectWrapper.hidden = true;
        optionInputs.forEach(function (input) {
          input.addEventListener('change', function () {
            onOptionChange(true);
          });
        });
        /* The URL is left untouched on load: Liquid already resolved the variant. */
        onOptionChange(false);
      } else if (select) {
        select.addEventListener('change', function () {
          applyOption(select.selectedOptions[0]);
          updateUrl(select.value);
        });
      }

      var qtyInput = root.querySelector('[data-qty-input]');
      root.querySelectorAll('[data-qty-step]').forEach(function (button) {
        button.addEventListener('click', function () {
          if (!qtyInput) return;
          var step = parseInt(button.getAttribute('data-qty-step'), 10);
          var next = (parseInt(qtyInput.value, 10) || 1) + step;
          if (next < 1) next = 1;
          qtyInput.value = next;
        });
      });

      /* Don't store blank optional personalization fields as empty line-item
         properties: disabled inputs aren't submitted with the form. */
      var form = root.querySelector('.product__form');
      if (form) {
        form.addEventListener('submit', function () {
          root.querySelectorAll('[data-property-optional]').forEach(function (field) {
            if (!field.value.trim()) field.disabled = true;
          });
        });
      }
    }

    /* Scope to the section that loaded so re-renders in the theme editor
       (shopify:section:load) re-bind against the fresh DOM. */
    function initFrom(scope) {
      var root = scope.querySelector('[data-product]');
      if (!root) return;
      initBuyBox(root);
      initGallery(root);
    }

    initFrom(document);
    document.addEventListener('shopify:section:load', function (event) {
      initFrom(event.target);
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:general.product",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "t:sections.product.show_vendor",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "t:sections.product.show_rating",
      "default": true
    },
    {
      "type": "text",
      "id": "lead_time",
      "label": "t:sections.product.lead_time",
      "default": "Handmade to order · ready in 2–3 weeks"
    },
    {
      "type": "text",
      "id": "personalization_heading",
      "label": "t:sections.product.personalization_heading",
      "default": "Personalise your keepsake"
    }
  ],
  "blocks": [
    {
      "type": "personalization_field",
      "name": "t:sections.product.personalization_field",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.product.field_label",
          "default": "Names or message to include"
        },
        {
          "type": "select",
          "id": "field_type",
          "label": "t:sections.product.field_type",
          "options": [
            { "value": "text", "label": "t:sections.product.field_type_text" },
            { "value": "textarea", "label": "t:sections.product.field_type_textarea" }
          ],
          "default": "text"
        },
        {
          "type": "checkbox",
          "id": "required",
          "label": "t:sections.product.field_required",
          "default": false
        }
      ]
    },
    {
      "type": "highlight",
      "name": "t:sections.product.highlight",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.product.highlight_text",
          "default": "Handcrafted to order"
        }
      ]
    },
    {
      "type": "spec",
      "name": "t:sections.product.spec",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.product.spec_label",
          "default": "Frame size"
        },
        {
          "type": "text",
          "id": "value",
          "label": "t:sections.product.spec_value",
          "default": "25 x 25 cm"
        }
      ]
    },
    {
      "type": "collapsible_row",
      "name": "t:sections.product.collapsible",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.product.collapsible_heading",
          "default": "Shipping & returns"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "t:sections.product.collapsible_content",
          "default": "<p>Made to order and shipped worldwide.</p>"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
