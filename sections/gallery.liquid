{% comment %}
  An editorial image gallery showcasing finished pieces in real homes.
  Each image is a block; the first item can be featured at double size.
{% endcomment %}

<div class="gallery full-width">
  <div class="gallery__inner">
    <header class="gallery__header">
      {% if section.settings.eyebrow != blank %}
        <p class="gallery__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="gallery__heading">{{ section.settings.heading }}</h2>
      {% endif %}
    </header>

    <div class="gallery__grid">
      {% for block in section.blocks %}
        <figure
          class="gallery__item{% if section.settings.feature_first and forloop.first %} gallery__item--featured{% endif %}"
          {{ block.shopify_attributes }}
        >
          {% if block.settings.image %}
            {{
              block.settings.image
              | image_url: width: 1200
              | image_tag: loading: 'lazy', class: 'gallery__image', alt: block.settings.image.alt
            }}
          {% else %}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'gallery__image gallery__image--placeholder' }}
          {% endif %}
        </figure>
      {% endfor %}
    </div>
  </div>
</div>

{% stylesheet %}
  .gallery {
    background-color: var(--color-surface);
  }

  .gallery__inner {
    max-width: var(--page-width);
    margin-inline: auto;
    padding-block: var(--section-spacing);
    padding-inline: var(--page-margin);
  }

  .gallery__header {
    text-align: center;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .gallery__eyebrow {
    font-size: 0.8rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.9rem;
  }

  .gallery__heading {
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: clamp(1.9rem, 3.5vw, 2.9rem);
    line-height: 1.1;
  }

  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 1fr;
    gap: clamp(0.5rem, 1.2vw, 1rem);
  }

  .gallery__item {
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background-color: var(--color-background);
  }

  .gallery__item--featured {
    grid-column: span 2;
    grid-row: span 2;
  }

  .gallery__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .gallery__item:hover .gallery__image {
    transform: scale(1.05);
  }

  @media (max-width: 749px) {
    .gallery__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .gallery__item--featured {
      grid-column: span 2;
      grid-row: span 1;
      aspect-ratio: 2 / 1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.gallery.name",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.gallery.eyebrow",
      "default": "Our gallery"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.gallery.heading",
      "default": "Botanical elegance for every home"
    },
    {
      "type": "checkbox",
      "id": "feature_first",
      "label": "t:sections.gallery.feature_first",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "t:sections.gallery.block_name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.gallery.image"
        }
      ]
    }
  ],
  "max_blocks": 9,
  "presets": [
    {
      "name": "t:sections.gallery.name",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
