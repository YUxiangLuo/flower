{% comment %}
  An editorial image gallery showcasing finished pieces in real homes.
  Each image is a block; the first item can be featured at double size.
{% endcomment %}

{% liquid
  assign has_gallery_images = false
  for block in section.blocks
    if block.settings.image
      assign has_gallery_images = true
      break
    endif
  endfor
%}

{% if has_gallery_images or request.design_mode %}
  <div class="gallery full-width">
    <div class="gallery__inner">
      <header class="gallery__header">
        {% if section.settings.eyebrow != blank %}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="gallery__heading">{{ section.settings.heading }}</h2>
        {% endif %}
      </header>

      <div class="gallery__grid" style="--columns: {{ section.settings.columns }}">
        {% for block in section.blocks %}
          {% if block.settings.image %}
            <figure class="gallery__item" {{ block.shopify_attributes }}>
              {{
                block.settings.image
                | image_url: width: 1000, height: 1000, crop: 'center'
                | image_tag: loading: 'lazy', class: 'gallery__image', sizes: '(min-width: 990px) 25vw, 50vw', widths: '320, 480, 640, 800, 1000', alt: block.settings.image.alt
              }}
            </figure>
          {% elsif request.design_mode %}
            <figure class="gallery__item" {{ block.shopify_attributes }}>
              {{ 'lifestyle-1' | placeholder_svg_tag: 'gallery__image gallery__image--placeholder' }}
            </figure>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .gallery {
    background-color: var(--color-surface);
  }

  .gallery__inner {
    max-width: var(--page-width);
    margin-inline: auto;
    padding-block: var(--section-spacing);
    padding-inline: var(--page-margin);
  }

  .gallery__header {
    text-align: center;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .gallery__heading {
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: var(--text-xl);
    line-height: 1.1;
  }

  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(var(--columns), 1fr);
    gap: clamp(0.5rem, 1.2vw, 1rem);
  }

  .gallery__item {
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background-color: var(--color-surface-deep);
  }

  .gallery__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-media) var(--ease-out);
  }

  /* Center the placeholder art at a modest size so empty tiles read as
     intentional image slots rather than blank cards. */
  .gallery__image--placeholder {
    padding: 22%;
    object-fit: contain;
    opacity: 0.35;
  }

  .gallery__item:hover .gallery__image:not(.gallery__image--placeholder) {
    transform: scale(1.05);
  }

  @media (max-width: 989px) {
    .gallery__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.gallery.name",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.gallery.eyebrow",
      "default": "Our gallery"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.gallery.heading",
      "default": "Botanical elegance for every home"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "t:sections.gallery.columns",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "t:sections.gallery.block_name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.gallery.image"
        }
      ]
    }
  ],
  "max_blocks": 9,
  "presets": [
    {
      "name": "t:sections.gallery.name",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
