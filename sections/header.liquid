<header class="header full-width">
  <div class="header__inner">
    <a class="header__logo" href="{{ routes.root_url }}">{{ shop.name }}</a>

    {% if section.settings.menu.links.size > 0 %}
      <nav class="header__nav">
        {% for link in section.settings.menu.links %}
          <a class="header__nav-link" href="{{ link.url }}">{{ link.title }}</a>
        {% endfor %}
      </nav>
    {% else %}
      <span class="header__nav"></span>
    {% endif %}

    <div class="header__actions">
      {% if shop.customer_accounts_enabled %}
        <shopify-account class="header__action" menu="{{ section.settings.customer_account_menu }}">
          {{ 'icon-account.svg' | inline_asset_content }}
        </shopify-account>
      {% endif %}

      <a class="header__action" href="{{ routes.cart_url }}">
        {{ 'icon-cart.svg' | inline_asset_content }}
        {% if cart.item_count > 0 %}
          <sup class="header__cart-count">{{ cart.item_count }}</sup>
        {% endif %}
      </a>
    </div>
  </div>
</header>

{% stylesheet %}
  .shopify-section:has(.header) {
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .header {
    background-color: var(--color-background);
    border-bottom: 1px solid var(--color-line);
  }

  .header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
    min-height: 4.75rem;
    padding-block: 0.75rem;
    padding-inline: max(var(--page-margin), 3vw);
    max-width: var(--page-width);
    margin-inline: auto;
  }

  .header__logo {
    justify-self: start;
    font-family: var(--font-heading--family);
    font-size: 1.4rem;
    letter-spacing: 0.02em;
    color: var(--color-foreground);
    text-decoration: none;
    white-space: nowrap;
  }

  .header__nav {
    justify-self: center;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.75rem;
  }

  .header__nav-link {
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-foreground);
    text-decoration: none;
    padding-bottom: 0.15rem;
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s ease, color 0.3s ease;
  }

  .header__nav-link:hover,
  .header__nav-link:focus-visible {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  .header__actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .header__action {
    position: relative;
    display: flex;
    align-items: center;
    color: var(--color-foreground);
    text-decoration: none;
    cursor: pointer;
  }

  .header__action svg {
    width: 1.4rem;
  }

  .header__cart-count {
    position: absolute;
    top: -0.5rem;
    left: 100%;
    font-size: 0.7rem;
    line-height: 1;
    color: var(--color-accent);
  }

  @media (max-width: 749px) {
    .header__inner {
      grid-template-columns: auto 1fr;
    }

    .header__nav {
      display: none;
    }

    .header__actions {
      grid-column: 2;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}
