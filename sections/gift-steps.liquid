{% comment %}
  A three-step "gifting made easy" walkthrough. Block-driven so merchants can
  add, remove and reorder steps. Reassures gift-buyers that ordering a bespoke
  keepsake for someone is simple.
{% endcomment %}

{% liquid
  # A step counts when it carries anything at all. Requiring a title would drop
  # a step a merchant wrote only body copy for, and losing their words is worse
  # than the empty band this guard exists to prevent.
  assign step_count = 0
  for block in section.blocks
    if block.settings.title != blank
      assign step_count = step_count | plus: 1
    elsif block.settings.text != blank
      assign step_count = step_count | plus: 1
    endif
  endfor
%}

{%- comment -%}
  A heading over no steps is section padding and nothing else. It stays up in
  the editor so the merchant can select it while adding the first step.
{%- endcomment -%}
{% if step_count > 0 or request.design_mode %}
  <div class="giftsteps giftsteps--{{ section.settings.background }} full-width">
    <div class="giftsteps__inner">
      <header class="giftsteps__header">
        {% if section.settings.eyebrow != blank %}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="giftsteps__heading">{{ section.settings.heading }}</h2>
        {% endif %}
      </header>

      {%- comment -%}
        The column count and the step numbers both follow the steps that render,
        not the blocks that exist: an untitled block would otherwise widen the
        row and take a number with it, leaving a gap in the sequence.
      {%- endcomment -%}
      <ol class="giftsteps__list" style="--columns: {{ step_count }}">
        {% assign step_number = 0 %}
        {% for block in section.blocks %}
          {% assign step_has_content = false %}
          {% if block.settings.title != blank %}
            {% assign step_has_content = true %}
          {% elsif block.settings.text != blank %}
            {% assign step_has_content = true %}
          {% endif %}

          {% if step_has_content %}
            {% assign step_number = step_number | plus: 1 %}
            <li class="giftsteps__step" {{ block.shopify_attributes }}>
              <span class="giftsteps__num" aria-hidden="true">{{ step_number }}</span>
              {% if block.settings.title != blank %}
                <h3 class="giftsteps__step-title">{{ block.settings.title }}</h3>
              {% endif %}
              {% if block.settings.text != blank %}
                <p class="giftsteps__step-text">{{ block.settings.text }}</p>
              {% endif %}
            </li>
          {% endif %}
        {% endfor %}
      </ol>
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .giftsteps--page {
    background-color: var(--color-background);
  }
  .giftsteps--surface {
    background-color: var(--color-surface);
  }
  .giftsteps--surface-deep {
    background-color: var(--color-surface-deep);
  }

  .giftsteps__inner {
    max-width: var(--page-width);
    margin-inline: auto;
    padding-block: var(--section-spacing);
    padding-inline: var(--page-margin);
  }

  .giftsteps__header {
    text-align: center;
    max-width: 42rem;
    margin: 0 auto clamp(2.5rem, 5vw, 4rem);
  }

  .giftsteps__heading {
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: var(--text-xl);
    line-height: 1.15;
  }

  .giftsteps__list {
    display: grid;
    grid-template-columns: repeat(var(--columns), 1fr);
    gap: var(--content-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .giftsteps__step {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.75rem;
  }

  .giftsteps__num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.25rem;
    height: 3.25rem;
    border: 1px solid var(--color-accent);
    border-radius: 50%;
    font-family: var(--font-heading--family);
    font-size: 1.4rem;
    color: var(--color-foreground);
  }

  .giftsteps__step-title {
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: var(--text-lg);
    line-height: 1.2;
  }

  .giftsteps__step-text {
    line-height: 1.7;
    color: var(--color-muted);
    max-width: 22rem;
  }

  @media (max-width: 989px) {
    .giftsteps__list {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-lg);
    }
  }

  @media (max-width: 749px) {
    .giftsteps__list {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.gift_steps.name",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.gift_steps.eyebrow",
      "default": "Gifting made easy"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.gift_steps.heading",
      "default": "A thoughtful gift in three steps"
    },
    {
      "type": "select",
      "id": "background",
      "label": "t:sections.gift_steps.background",
      "options": [
        { "value": "page", "label": "t:options.background.page" },
        { "value": "surface", "label": "t:options.background.surface" },
        { "value": "surface-deep", "label": "t:options.background.surface_deep" }
      ],
      "default": "page"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "t:sections.gift_steps.block_name",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.gift_steps.title",
          "default": "Choose their keepsake"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:sections.gift_steps.text",
          "default": "Pick a design, or send us the flowers that mean something to them."
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "t:sections.gift_steps.name",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Choose their keepsake",
            "text": "Pick a design, or send us the flowers that mean something to them."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Add a personal note",
            "text": "Include names, a message or a gift note — we handcraft it to order."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Arrives gift-ready",
            "text": "Beautifully packed and shipped worldwide, ready to give."
          }
        }
      ]
    }
  ]
}
{% endschema %}
