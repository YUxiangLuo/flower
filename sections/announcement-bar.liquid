{% comment %}
  A slim, full-width announcement bar shown above the header.
  Ideal for promotions, shipping notices, or seasonal messages.
{% endcomment %}

<div
  class="announcement full-width"
  style="--bar-bg: {{ section.settings.background_color }}; --bar-text: {{ section.settings.text_color }};"
>
  {% if section.settings.link != blank %}
    <a class="announcement__inner" href="{{ section.settings.link }}">
      <span>{{ section.settings.text }}</span>
      {% if section.settings.show_arrow %}
        <span class="announcement__arrow" aria-hidden="true">&rarr;</span>
      {% endif %}
    </a>
  {% else %}
    <p class="announcement__inner">{{ section.settings.text }}</p>
  {% endif %}
</div>

{% stylesheet %}
  .announcement {
    background-color: var(--bar-bg);
    color: var(--bar-text);
  }

  .announcement__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    min-height: 2.5rem;
    padding: 0.5rem 1rem;
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: inherit;
    text-decoration: none;
  }

  .announcement__arrow {
    transition: transform 0.3s ease;
  }

  a.announcement__inner:hover .announcement__arrow,
  a.announcement__inner:focus-visible .announcement__arrow {
    transform: translateX(0.3rem);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.announcement.name",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "t:sections.announcement.text",
      "default": "Free shipping on every keepsake"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:sections.announcement.link"
    },
    {
      "type": "checkbox",
      "id": "show_arrow",
      "label": "t:sections.announcement.show_arrow",
      "default": true
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.announcement.background_color",
      "default": "#2a3320"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:sections.announcement.text_color",
      "default": "#fcfaf4"
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement.name"
    }
  ]
}
{% endschema %}
