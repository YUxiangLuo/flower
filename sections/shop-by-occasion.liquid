{% comment %}
  A row of occasion cards linking to curated collections. A selected collection
  supplies each card's title, image and link unless the merchant overrides them.
{% endcomment %}

{% liquid
  assign visible_card_count = 0
  for block in section.blocks
    if block.settings.collection != blank
      assign visible_card_count = visible_card_count | plus: 1
    elsif block.settings.link != blank
      if block.settings.title != blank
        assign visible_card_count = visible_card_count | plus: 1
      elsif request.design_mode
        assign visible_card_count = visible_card_count | plus: 1
      endif
    elsif request.design_mode
      assign visible_card_count = visible_card_count | plus: 1
    endif
  endfor
%}

{% if visible_card_count > 0 %}
  {% capture occasion_image_sizes %}
    {%- render 'grid-image-sizes', columns: visible_card_count, two_column_breakpoint: 750 -%}
  {% endcapture %}
  {% assign occasion_image_sizes = occasion_image_sizes | strip %}

  <div class="occasion">
    <header class="occasion__header">
      {% if section.settings.eyebrow != blank %}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="occasion__heading">{{ section.settings.heading }}</h2>
      {% endif %}
    </header>

    <div class="occasion__grid" style="--columns: {{ visible_card_count }}">
      {% for block in section.blocks %}
        {% liquid
          assign occasion_collection = block.settings.collection

          assign occasion_image = block.settings.image
          if occasion_image == blank
            assign occasion_image = occasion_collection.featured_image
          endif

          assign occasion_title = block.settings.title
          if occasion_title == blank
            assign occasion_title = occasion_collection.title
          endif

          assign occasion_link = block.settings.link
          if occasion_link == blank
            assign occasion_link = occasion_collection.url
          endif

          assign occasion_image_alt = occasion_image.alt | default: occasion_title

          assign occasion_is_complete = false
          if occasion_link != blank
            if occasion_title != blank
              assign occasion_is_complete = true
            endif
          endif
        %}

        {% capture occasion_card_content %}
        <div class="occasion__media">
          {% if occasion_image != blank %}
            {{
              occasion_image
              | image_url: width: 900, height: 1100, crop: 'center'
              | image_tag: loading: 'lazy', class: 'occasion__image', sizes: occasion_image_sizes, widths: '360, 540, 720, 900', alt: occasion_image_alt
            }}
          {% else %}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'occasion__image occasion__image--placeholder' }}
          {% endif %}
        </div>
        <h3 class="occasion__card-title">
          <span>{{ occasion_title }}</span>
          <span class="occasion__arrow" aria-hidden="true">&rarr;</span>
        </h3>
        {% endcapture %}

        {% if occasion_is_complete %}
          <a class="occasion__card" href="{{ occasion_link }}" {{ block.shopify_attributes }}>
            {{ occasion_card_content }}
          </a>
        {% elsif request.design_mode %}
          <div class="occasion__card" {{ block.shopify_attributes }}>
            {{ occasion_card_content }}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .occasion {
    padding-block: var(--section-spacing);
  }

  .occasion__header {
    text-align: center;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .occasion__heading {
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: var(--text-xl);
    line-height: 1.1;
  }

  .occasion__grid {
    display: grid;
    grid-template-columns: repeat(var(--columns), 1fr);
    gap: var(--content-gap);
  }

  .occasion__card {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    color: var(--color-foreground);
    text-decoration: none;
  }

  .occasion__media {
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background-color: var(--color-surface);
  }

  .occasion__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-media) var(--ease-out);
  }

  .occasion__card:hover .occasion__image,
  .occasion__card:focus-visible .occasion__image {
    transform: scale(1.05);
  }

  .occasion__card-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: var(--text-lg);
  }

  .occasion__arrow {
    color: var(--color-accent);
    transition: transform var(--duration-ui) ease;
  }

  .occasion__card:hover .occasion__arrow,
  .occasion__card:focus-visible .occasion__arrow {
    transform: translateX(0.35rem);
  }

  @media (max-width: 989px) {
    .occasion__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 749px) {
    .occasion__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.occasion.name",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.occasion.eyebrow",
      "default": "Find the perfect gift"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.occasion.heading",
      "default": "Shop by occasion"
    }
  ],
  "blocks": [
    {
      "type": "occasion",
      "name": "t:sections.occasion.block_name",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.occasion.collection",
          "info": "t:sections.occasion.collection_info"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.occasion.image",
          "info": "t:sections.occasion.image_info"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.occasion.title",
          "info": "t:sections.occasion.title_info"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.occasion.link",
          "info": "t:sections.occasion.link_info"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "t:sections.occasion.name",
      "blocks": [
        { "type": "occasion" },
        { "type": "occasion" },
        { "type": "occasion" }
      ]
    }
  ]
}
{% endschema %}
