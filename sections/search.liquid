{% comment %}
  Search page: a search field and results for products, articles and pages.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/search
{% endcomment %}

<div class="search">
  <header class="search__header">
    <h1 class="search__title">{{ 'search.title' | t }}</h1>

    <form class="search__form" action="{{ routes.search_url }}" method="get" role="search">
      <input
        class="search__input"
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ 'search.placeholder' | t }}"
        autocomplete="off"
      >
      <button class="search__submit" type="submit">{{ 'search.submit' | t }}</button>
    </form>
  </header>

  {% if search.performed %}
    {% if search.results_count == 0 %}
      <p class="search__meta">{{ 'search.no_results_html' | t: terms: search.terms }}</p>
    {% else %}
      <p class="search__meta">{{ 'search.results_for_html' | t: terms: search.terms, count: search.results_count }}</p>

      {% paginate search.results by 12 %}
        <div class="search__grid">
          {% for result in search.results %}
            {% if result.object_type == 'product' %}
              {% render 'product-card', product: result, image_size: 700 %}
            {% else %}
              <a class="search__card" href="{{ result.url }}">
                <div class="search__card-media">
                  {% if result.image %}
                    {{
                      result.image
                      | image_url: width: 700, height: 875, crop: 'center'
                      | image_tag: loading: 'lazy', class: 'search__card-image', alt: result.title
                    }}
                  {% else %}
                    {{ 'image' | placeholder_svg_tag: 'search__card-image search__card-image--placeholder' }}
                  {% endif %}
                </div>
                <div class="search__card-info">
                  <h2 class="search__card-title">{{ result.title }}</h2>
                  {% if result.excerpt != blank %}
                    <p class="search__card-excerpt">{{ result.excerpt | strip_html | truncatewords: 20 }}</p>
                  {% endif %}
                </div>
              </a>
            {% endif %}
          {% endfor %}
        </div>

        {% render 'pagination', paginate: paginate %}
      {% endpaginate %}
    {% endif %}
  {% endif %}
</div>

{% stylesheet %}
  .search {
    padding-block: var(--section-spacing);
  }

  .search__header {
    text-align: center;
    max-width: 42rem;
    margin: 0 auto clamp(2rem, 4vw, 3.5rem);
  }

  .search__title {
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: 1.5rem;
  }

  .search__form {
    display: flex;
    gap: 0.75rem;
    border-bottom: 1px solid var(--color-foreground);
    padding-bottom: 0.5rem;
  }

  .search__input {
    flex: 1;
    border: 0;
    background: transparent;
    color: var(--color-foreground);
    font-size: 1.05rem;
    padding: 0.4rem 0.2rem;
  }

  .search__input:focus {
    outline: none;
  }

  .search__submit {
    background: transparent;
    border: 0;
    color: var(--color-accent);
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .search__meta {
    text-align: center;
    color: var(--color-muted);
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .search__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--content-gap);
  }

  .search__card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    color: var(--color-foreground);
    text-decoration: none;
  }

  .search__card-media {
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background-color: var(--color-surface);
  }

  .search__card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .search__card:hover .search__card-image {
    transform: scale(1.04);
  }

  .search__card-title {
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: 1.1rem;
    line-height: 1.3;
  }

  .search__card-excerpt {
    margin-top: 0.4rem;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  @media (max-width: 989px) {
    .search__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 549px) {
    .search__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.search",
  "settings": []
}
{% endschema %}
