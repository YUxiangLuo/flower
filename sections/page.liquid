{% comment %}
  Renders a store page (About, Our Story, Contact, etc.) with an elegant,
  readable long-form layout.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/page
{% endcomment %}

<div class="page{% if section.settings.compact_bottom_spacing %} page--compact-bottom{% endif %}">
  <header class="page__header">
    {% if section.settings.eyebrow != blank %}
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h1 class="page__title">{{ page.title }}</h1>
  </header>

  {% if section.settings.show_content %}
    {% if page.content != blank %}
      <div class="page__content rte" style="--measure: {{ section.settings.content_width }}rem">
        {{ page.content }}
      </div>
    {% endif %}
  {% endif %}
</div>

{% stylesheet %}
  .page {
    padding-block: var(--section-spacing);
  }

  .page--compact-bottom {
    padding-bottom: 0;
  }

  .page--compact-bottom .page__header:last-child {
    margin-bottom: 0;
  }

  .page__header {
    text-align: center;
    max-width: 45rem;
    margin: 0 auto clamp(2.5rem, 5vw, 4rem);
  }

  .page__title {
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: clamp(2.2rem, 4.5vw, 3.6rem);
    line-height: 1.1;
  }

  .page__content {
    max-width: var(--measure);
    margin-inline: auto;
    color: var(--color-foreground);
  }

  .rte {
    line-height: 1.8;
  }

  .rte > * + * {
    margin-top: 1.4rem;
  }

  .rte h2,
  .rte h3,
  .rte h4 {
    font-family: var(--font-heading--family);
    font-weight: 400;
    line-height: 1.2;
    margin-top: 2.5rem;
  }

  .rte h2 {
    font-size: clamp(1.6rem, 3vw, 2.1rem);
  }

  .rte h3 {
    font-size: 1.4rem;
  }

  .rte h4 {
    font-size: 1.15rem;
  }

  .rte a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }

  .rte a:hover,
  .rte a:focus-visible {
    color: var(--color-foreground);
  }

  .rte strong {
    font-weight: 700;
  }

  .rte ul,
  .rte ol {
    padding-inline-start: 1.5rem;
  }

  .rte li + li {
    margin-top: 0.5rem;
  }

  .rte img {
    width: 100%;
    height: auto;
  }

  .rte blockquote {
    margin-inline: 0;
    padding-inline-start: 1.5rem;
    border-inline-start: 2px solid var(--color-accent);
    font-family: var(--font-heading--family);
    font-style: italic;
    font-size: 1.3rem;
    line-height: 1.5;
    color: var(--color-muted);
  }

  .rte hr {
    border: 0;
    border-top: 1px solid var(--color-line);
    margin-block: 2.5rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.page",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.page.eyebrow"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "t:sections.page.content_width",
      "min": 32,
      "max": 56,
      "step": 2,
      "unit": "rem",
      "default": 42
    },
    {
      "type": "checkbox",
      "id": "show_content",
      "label": "t:sections.page.show_content",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "compact_bottom_spacing",
      "label": "t:sections.page.compact_bottom_spacing",
      "default": false
    }
  ]
}
{% endschema %}
