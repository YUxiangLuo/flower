{% comment %}
  Lists all published collections as an elegant card grid.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}

<div class="collections">
  <header class="collections__header">
    {% if section.settings.eyebrow != blank %}
      <p class="collections__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h1 class="collections__heading">{{ section.settings.heading }}</h1>
  </header>

  <div class="collections__grid" style="--columns: {{ section.settings.columns }}">
    {% for collection in collections %}
      <a class="collections__card" href="{{ collection.url }}">
        <div class="collections__media">
          {% if collection.featured_image %}
            {{
              collection.featured_image
              | image_url: width: 900, height: 1100, crop: 'center'
              | image_tag: loading: 'lazy', class: 'collections__image', alt: collection.title
            }}
          {% else %}
            {{ 'collection-1' | placeholder_svg_tag: 'collections__image collections__image--placeholder' }}
          {% endif %}
        </div>

        <div class="collections__info">
          <h2 class="collections__card-title">
            <span>{{ collection.title }}</span>
            <span class="collections__arrow" aria-hidden="true">&rarr;</span>
          </h2>

          {% if section.settings.show_description and collection.description != blank %}
            <p class="collections__card-description">
              {{ collection.description | strip_html | truncatewords: 18 }}
            </p>
          {% endif %}
        </div>
      </a>
    {% endfor %}
  </div>
</div>

{% stylesheet %}
  .collections {
    padding-block: var(--section-spacing);
  }

  .collections__header {
    text-align: center;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .collections__eyebrow {
    font-size: 0.8rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.9rem;
  }

  .collections__heading {
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: clamp(2rem, 4vw, 3.25rem);
    line-height: 1.1;
  }

  .collections__grid {
    display: grid;
    grid-template-columns: repeat(var(--columns), 1fr);
    gap: var(--content-gap);
  }

  .collections__card {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    color: var(--color-foreground);
    text-decoration: none;
  }

  .collections__media {
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background-color: var(--color-surface);
  }

  .collections__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .collections__card:hover .collections__image,
  .collections__card:focus-visible .collections__image {
    transform: scale(1.05);
  }

  .collections__card-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: 1.25rem;
  }

  .collections__arrow {
    color: var(--color-accent);
    transition: transform 0.4s ease;
  }

  .collections__card:hover .collections__arrow,
  .collections__card:focus-visible .collections__arrow {
    transform: translateX(0.35rem);
  }

  .collections__card-description {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  @media (max-width: 989px) {
    .collections__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 549px) {
    .collections__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collections_grid",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.collections.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.collections.heading",
      "default": "Collections"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "t:sections.collections.columns",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "t:sections.collections.show_description",
      "default": true
    }
  ],
  "presets": [{ "name": "t:general.collections_grid" }]
}
{% endschema %}
