{% comment %}
  Lists a merchant-selected set of collections, or all published collections
  when no manual selection has been made.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}

{% capture collection_image_sizes %}
  {%- render 'grid-image-sizes', columns: section.settings.columns -%}
{% endcapture %}
{% assign collection_image_sizes = collection_image_sizes | strip %}

<div class="collections">
  <header class="collections__header">
    {% if section.settings.eyebrow != blank %}
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h1 class="collections__heading">{{ section.settings.heading }}</h1>
  </header>

  {%- comment -%}
    A `for` loop stops after 50 iterations, so a shop past that many collections
    would lose the rest with nothing on the page to reach them by. Paginating is
    what makes the tail reachable at all, not just a nicety on a long list.
  {%- endcomment -%}
  {% if section.settings.selected_collections != blank %}
    {% paginate section.settings.selected_collections by section.settings.collections_per_page %}
      {% render 'collection-grid',
        collection_items: section.settings.selected_collections,
        columns: section.settings.columns,
        show_description: section.settings.show_description,
        image_sizes: collection_image_sizes,
        eager_rows: 2
      %}
      {% render 'pagination', paginate: paginate %}
    {% endpaginate %}
  {% else %}
    {% paginate collections by section.settings.collections_per_page %}
      {% render 'collection-grid',
        collection_items: collections,
        columns: section.settings.columns,
        show_description: section.settings.show_description,
        image_sizes: collection_image_sizes,
        eager_rows: 2
      %}
      {% render 'pagination', paginate: paginate %}
    {% endpaginate %}
  {% endif %}
</div>

{% stylesheet %}
  .collections {
    padding-block: var(--section-spacing);
  }

  .collections__header {
    text-align: center;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .collections__heading {
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: var(--text-2xl);
    line-height: 1.1;
  }

  .collections__grid {
    display: grid;
    grid-template-columns: repeat(var(--columns), 1fr);
    gap: var(--content-gap);
  }

  .collections__card {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    color: var(--color-foreground);
    text-decoration: none;
  }

  .collections__media {
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background-color: var(--color-surface);
  }

  .collections__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-media) var(--ease-out);
  }

  .collections__card:hover .collections__image,
  .collections__card:focus-visible .collections__image {
    transform: scale(1.05);
  }

  .collections__card-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: var(--text-lg);
  }

  .collections__arrow {
    color: var(--color-accent);
    transition: transform var(--duration-ui) ease;
  }

  .collections__card:hover .collections__arrow,
  .collections__card:focus-visible .collections__arrow {
    transform: translateX(0.35rem);
  }

  .collections__card-description {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .collections__empty {
    text-align: center;
    padding-block: clamp(3rem, 8vw, 6rem);
    color: var(--color-muted);
  }

  @media (max-width: 989px) {
    .collections__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 549px) {
    .collections__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collections_grid",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.collections.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.collections.heading",
      "default": "Collections"
    },
    {
      "type": "collection_list",
      "id": "selected_collections",
      "label": "t:sections.collections.selected_collections",
      "info": "t:sections.collections.selected_collections_info",
      "limit": 24
    },
    {
      "type": "select",
      "id": "columns",
      "label": "t:sections.collections.columns",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    {
      "type": "range",
      "id": "collections_per_page",
      "label": "t:sections.collections.collections_per_page",
      "min": 8,
      "max": 24,
      "step": 4,
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "t:sections.collections.show_description",
      "default": true
    }
  ],
  "presets": [{ "name": "t:general.collections_grid" }]
}
{% endschema %}
