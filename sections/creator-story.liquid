{% liquid
  assign show_media = false
  if section.settings.image != blank
    assign show_media = true
  elsif request.design_mode
    assign show_media = true
  endif

  # A richtext setting emptied in the editor keeps a <p></p>, which is not
  # blank. Stripping the tags tells "the merchant cleared this" apart from
  # "the merchant wrote something".
  assign story_body = section.settings.body | strip_html | strip

  assign has_story = false
  if section.settings.eyebrow != blank
    assign has_story = true
  elsif section.settings.heading != blank
    assign has_story = true
  elsif story_body != blank
    assign has_story = true
  elsif section.settings.signature != blank
    assign has_story = true
  elsif section.settings.image != blank
    assign has_story = true
  elsif section.settings.button_label != blank and section.settings.button_link != blank
    assign has_story = true
  endif
%}

{%- comment -%}
  Every child is guarded but the band around them was not, so clearing the
  copy left a stripe of section padding behind. It stays up in the editor so
  the merchant can select it while filling it in.
{%- endcomment -%}
{% if has_story or request.design_mode %}
  <div class="creator creator--{{ section.settings.background }}{% unless show_media %} creator--no-media{% endunless %} full-width">
    <div class="creator__inner creator--{{ section.settings.image_position }}">
      {% if show_media %}
        <div class="creator__media">
          {% if section.settings.image != blank %}
            {%- comment -%}
              Resolve the alt text first. A `| default:` written inside an
              `image_tag` argument binds to the tag's output, not to the argument,
              so the fallback would silently never apply.
            {%- endcomment -%}
            {% assign creator_alt = section.settings.image.alt | default: section.settings.heading %}
            {{
              section.settings.image
              | image_url: width: 1200
              | image_tag: loading: 'lazy', class: 'creator__image', sizes: '(max-width: 749px) 100vw, 50vw', widths: '500, 750, 1000, 1200', alt: creator_alt
            }}
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'creator__image creator__image--placeholder' }}
          {% endif %}
        </div>
      {% endif %}

      <div class="creator__content">
        {% if section.settings.eyebrow != blank %}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="creator__heading">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if story_body != blank %}
          <div class="creator__body">{{ section.settings.body }}</div>
        {% endif %}
        {% if section.settings.signature != blank %}
          <p class="creator__signature">{{ section.settings.signature }}</p>
        {% endif %}
        {% if section.settings.button_label != blank and section.settings.button_link != blank %}
          <a class="button button--outline creator__button" href="{{ section.settings.button_link }}">
            {{ section.settings.button_label }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .creator--page {
    background-color: var(--color-background);
  }
  .creator--surface {
    background-color: var(--color-surface);
  }
  .creator--surface-deep {
    background-color: var(--color-surface-deep);
  }

  .creator__inner {
    max-width: var(--page-width);
    margin-inline: auto;
    padding-block: var(--section-spacing);
    padding-inline: var(--page-margin);
    display: grid;
    grid-template-columns: 5fr 6fr;
    align-items: center;
    gap: clamp(2rem, 6vw, 5.5rem);
  }

  .creator--no-media .creator__inner {
    grid-template-columns: minmax(0, 34rem);
    justify-content: center;
  }

  .creator--right .creator__media {
    order: 2;
  }

  .creator__media {
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background-color: var(--color-surface);
  }

  .creator__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .creator__image--placeholder {
    opacity: 0.4;
  }

  .creator__content {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 34rem;
  }

  /* The flex gap handles spacing, so drop the shared eyebrow's margin here. */
  .creator__content .eyebrow {
    margin-bottom: 0;
  }

  .creator__heading {
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: var(--text-2xl);
    line-height: 1.15;
  }

  .creator__body {
    line-height: 1.75;
    color: var(--color-muted);
  }

  .creator__body > * + * {
    margin-top: var(--space-sm);
  }

  .creator__signature {
    font-family: var(--font-heading--family);
    font-style: italic;
    font-size: 1.4rem;
    margin-top: 0.25rem;
  }

  .creator__button {
    align-self: flex-start;
    margin-top: var(--space-sm);
  }

  @media (max-width: 749px) {
    .creator__inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .creator--right .creator__media {
      order: 0;
    }

    .creator__media {
      aspect-ratio: 4 / 3;
    }

    .creator__content {
      max-width: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.creator.name",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.creator.image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:sections.creator.image_position",
      "options": [
        { "value": "left", "label": "t:sections.creator.position_left" },
        { "value": "right", "label": "t:sections.creator.position_right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "background",
      "label": "t:sections.creator.background",
      "options": [
        { "value": "page", "label": "t:options.background.page" },
        { "value": "surface", "label": "t:options.background.surface" },
        { "value": "surface-deep", "label": "t:options.background.surface_deep" }
      ],
      "default": "page"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.creator.eyebrow",
      "default": "Dried Petals Gallery"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.creator.heading",
      "default": "Meet the creator"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "t:sections.creator.body",
      "default": "<p>Every piece is handcrafted with care. Each petal is selected and pressed by hand, then composed into a keepsake designed to be treasured for years to come.</p>"
    },
    {
      "type": "text",
      "id": "signature",
      "label": "t:sections.creator.signature",
      "default": "With gratitude, Thomas"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.creator.button_label",
      "default": "Our story"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.creator.button_link"
    }
  ],
  "presets": [
    {
      "name": "t:sections.creator.name"
    }
  ]
}
{% endschema %}
