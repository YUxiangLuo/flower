{% comment %}
  A two-column "meet the creator" feature: a portrait image paired with the
  brand's founder story. Constrained to the page width for a balanced,
  editorial composition.
{% endcomment %}

<div class="creator creator--{{ section.settings.image_position }}">
  <div class="creator__media">
    {% if section.settings.image %}
      {{
        section.settings.image
        | image_url: width: 1200
        | image_tag: loading: 'lazy', class: 'creator__image', sizes: '(max-width: 749px) 100vw, 50vw', widths: '500, 750, 1000, 1200'
      }}
    {% else %}
      {{ 'image' | placeholder_svg_tag: 'creator__image creator__image--placeholder' }}
    {% endif %}
  </div>

  <div class="creator__content">
    {% if section.settings.eyebrow != blank %}
      <p class="creator__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="creator__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.body != blank %}
      <div class="creator__body">{{ section.settings.body }}</div>
    {% endif %}
    {% if section.settings.signature != blank %}
      <p class="creator__signature">{{ section.settings.signature }}</p>
    {% endif %}
    {% if section.settings.button_label != blank %}
      <a class="creator__button" href="{{ section.settings.button_link | default: '#' }}">
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .creator {
    display: grid;
    grid-template-columns: 5fr 6fr;
    align-items: center;
    gap: clamp(2rem, 6vw, 5.5rem);
    padding-block: var(--section-spacing);
  }

  .creator--right .creator__media {
    order: 2;
  }

  .creator__media {
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background-color: var(--color-surface);
  }

  .creator__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .creator__image--placeholder {
    opacity: 0.4;
  }

  .creator__content {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 34rem;
  }

  .creator__eyebrow {
    font-size: 0.8rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .creator__heading {
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: clamp(2rem, 3.5vw, 3.1rem);
    line-height: 1.15;
  }

  .creator__body {
    line-height: 1.75;
    color: var(--color-muted);
  }

  .creator__body > * + * {
    margin-top: 1rem;
  }

  .creator__signature {
    font-family: var(--font-heading--family);
    font-style: italic;
    font-size: 1.4rem;
    margin-top: 0.25rem;
  }

  .creator__button {
    align-self: flex-start;
    margin-top: 1rem;
    padding: 0.9rem 2.4rem;
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-foreground);
    text-decoration: none;
    border: 1px solid var(--color-foreground);
    transition: background-color 0.4s ease, color 0.4s ease;
  }

  .creator__button:hover,
  .creator__button:focus-visible {
    background-color: var(--color-foreground);
    color: var(--color-background);
  }

  @media (max-width: 749px) {
    .creator {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .creator--right .creator__media {
      order: 0;
    }

    .creator__media {
      aspect-ratio: 4 / 3;
    }

    .creator__content {
      max-width: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.creator.name",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.creator.image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:sections.creator.image_position",
      "options": [
        { "value": "left", "label": "t:sections.creator.position_left" },
        { "value": "right", "label": "t:sections.creator.position_right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.creator.eyebrow",
      "default": "Dried Petals Gallery"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.creator.heading",
      "default": "Meet the creator"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "t:sections.creator.body",
      "default": "<p>Every piece is handcrafted with care. Each petal is selected and pressed by hand, then composed into a keepsake designed to be treasured for years to come.</p>"
    },
    {
      "type": "text",
      "id": "signature",
      "label": "t:sections.creator.signature",
      "default": "With gratitude,"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.creator.button_label",
      "default": "Our story"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.creator.button_link"
    }
  ],
  "presets": [
    {
      "name": "t:sections.creator.name"
    }
  ]
}
{% endschema %}
