{% comment %}
  Collection page: a title, optional description, a sort bar and a paginated
  product grid.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}

<div class="collection">
  {%- comment -%}
    On narrow screens the collection's own artwork sits behind its name. The URL
    is handed to CSS as a custom property rather than an <img> so the file is
    only ever fetched where it is used: a background-image inside a media query
    is not requested when the query does not match, while an <img> is downloaded
    even when its container is display:none.
  {%- endcomment -%}
  <header
    class="collection__header{% if collection.image %} collection__header--media{% endif %}"
    {%- if collection.image %}
      style="--collection-media: url('{{ collection.image | image_url: width: 420 | escape }}');"
    {%- endif %}
  >
    <h1 class="collection__title">{{ collection.title }}</h1>
    {% if section.settings.show_description and collection.description != blank %}
      <div class="collection__description">{{ collection.description }}</div>
    {% endif %}
  </header>

  {% paginate collection.products by section.settings.products_per_page %}
    {% liquid
      assign current_sort = collection.sort_by | default: collection.default_sort_by

      # Shopify offers every sort it knows how to perform, including reversals
      # nobody reaches for. This is the curated list; anything outside it is
      # dropped from the control.
      assign allowed_sorts = 'manual,best-selling,price-ascending,price-descending,created-descending' | split: ','
    %}

    <form method="get" action="{{ collection.url }}" class="collection__bar collection__form">
      <span class="collection__count">
        {{ 'collection.products_count' | t: count: paginate.items }}
      </span>

      {% if collection.sort_options.size > 0 %}
        <div class="collection__sort">
          <label class="visually-hidden" for="SortBy-{{ section.id }}">
            {{- 'collection.sort_by' | t -}}
          </label>
          <select id="SortBy-{{ section.id }}" name="sort_by" data-auto-submit>
            {% comment %}
              A sort outside the curated list is still rendered while it is the
              one in effect — reached by a shared link, or set as the
              collection's default in the admin. Dropping it would leave the
              control naming a sort the page is not actually in.
            {% endcomment %}
            {% for option in collection.sort_options %}
              {% if allowed_sorts contains option.value or option.value == current_sort %}
                <option value="{{ option.value }}" {% if option.value == current_sort %}selected{% endif %}>
                  {%- comment -%}
                    Shopify calls the collection's own arrangement "Featured",
                    which reads as a category of product rather than an order to
                    put them in.
                  {%- endcomment -%}
                  {% if option.value == 'manual' %}
                    {{- 'collection.sort_recommended' | t -}}
                  {% else %}
                    {{- option.name -}}
                  {% endif %}
                </option>
              {% endif %}
            {% endfor %}
          </select>

          {% comment %}
            Sorting applies on change. Nothing would apply it without
            JavaScript, so the button exists for exactly that case.
          {% endcomment %}
          <noscript>
            <button type="submit" class="collection__apply">{{ 'collection.apply' | t }}</button>
          </noscript>
        </div>
      {% endif %}
    </form>

    {% if collection.products.size > 0 %}
      <div class="collection__grid" style="--columns: {{ section.settings.columns }}">
        {% for product in collection.products %}
          {% render 'product-card', product: product, image_size: 700, columns: section.settings.columns %}
        {% endfor %}
      </div>

      {% render 'pagination', paginate: paginate %}
    {% else %}
      <div class="collection__empty">
        <p>{{ 'collection.empty' | t }}</p>
      </div>
    {% endif %}
  {% endpaginate %}
</div>

{% stylesheet %}
  /* A listing, not a marketing section: the products are what the customer came
     for, so the top gets a fraction of the section rhythm the rest of the theme
     uses and the grid starts near the fold. */
  .collection {
    padding-block: clamp(1.5rem, 3.5vw, 2.75rem) var(--section-spacing);
  }

  .collection__header {
    text-align: center;
    max-width: 40rem;
    margin: 0 auto clamp(1rem, 2.5vw, 1.75rem);
  }

  .collection__title {
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: clamp(1.75rem, 3.2vw, 2.5rem);
    line-height: 1.15;
    /* A two-line collection name should break evenly rather than leave one
       word stranded under the rest. */
    text-wrap: balance;
  }

  /* Set in the heading serif, not the body sans. An italic sans under a serif
     title is what made the pair read as two unrelated voices; the same italic
     in Georgia reads as the title's own subtitle. */
  .collection__description {
    margin-top: var(--space-xs);
    font-family: var(--font-heading--family);
    font-style: italic;
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--color-muted);
    /* Hold it to a comfortable measure so it breaks into balanced lines
       instead of running the full width of the band. */
    max-width: 34ch;
    margin-inline: auto;
  }

  .collection__description p {
    text-wrap: balance;
  }

  /* The description is merchant rich text. A pasted <strong> would otherwise
     land a heavy slab under a light serif title — the weight of the pairing is
     the theme's to decide, not the copy's. */
  .collection__description :is(strong, b) {
    font-weight: inherit;
  }

  /* One row: the count at the start, sorting at the end. The "Sort by" caption
     is what would force a wrap on a narrow viewport, so it survives as a
     visually hidden label on the select rather than as text in the bar.

     No rules above or below it — the gap to the grid is what sets it apart, and
     a line across the page was drawing more attention than a count and a select
     deserve. */
  .collection__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }

  .collection__sort {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  /* Only ever rendered inside <noscript>. */
  .collection__apply {
    padding: 0.35rem 1rem;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-foreground);
    background-color: transparent;
    border: 1px solid var(--color-foreground);
    cursor: pointer;
  }

  .collection__sort select {
    border: 0;
    border-bottom: 1px solid var(--color-line);
    background-color: transparent;
    color: var(--color-foreground);
    font-size: 0.85rem;
    padding: 0.2rem 1.25rem 0.2rem 0.2rem;
    cursor: pointer;
  }

  .collection__count {
    font-size: 0.8rem;
    color: var(--color-muted);
  }

  .collection__grid {
    display: grid;
    grid-template-columns: repeat(var(--columns), 1fr);
    gap: var(--content-gap);
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .collection__empty {
    text-align: center;
    padding-block: clamp(3rem, 8vw, 6rem);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
    color: var(--color-muted);
  }

  @media (max-width: 989px) {
    .collection__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 749px) {
    .collection__bar {
      justify-content: flex-start;
    }

    /* The band meets the site header directly. A strip of page colour between
       the two reads as a gap in the page rather than as margin, and only the
       variant that has artwork can close it — without one there is no band, and
       the title would sit against the header with nothing to separate them. */
    .collection:has(.collection__header--media) {
      padding-block-start: 0;
    }

    /* Keep the existing soft photographic treatment, then use the same dark
       scrim pattern as the hero so near-white copy reads over the artwork. */
    .collection__header--media {
      position: relative;
      isolation: isolate;
      overflow: hidden;
      max-width: none;
      /* Step back out of the inset the section grid gives its children so the
         artwork reaches both edges. */
      margin-inline: calc(var(--page-margin) * -1);
      padding: clamp(2rem, 9vw, 3rem) var(--page-margin);
    }

    .collection__header--media::before,
    .collection__header--media::after {
      content: '';
      position: absolute;
      inset: 0;
    }

    .collection__header--media::before {
      z-index: -2;
      background-image: var(--collection-media);
      background-size: cover;
      background-position: center;
      /* Most of the softening is already done: the source is requested at
         420px and stretched, which costs a few kilobytes instead of a
         full-width blur on a phone GPU. The rest takes it past "slightly out of
         focus" — a recognisable photograph behind the words is what made the
         band read as text dropped on an image rather than as a printed page. */
      filter: blur(6px) saturate(0.55);
      /* Overscan, or the blur feathers the artwork's own edges into the page. */
      transform: scale(1.08);
    }

    .collection__header--media::after {
      z-index: -1;
      background-color: rgb(0 0 0 / 0.35);
    }

    .collection__header--media .collection__title,
    .collection__header--media .collection__description {
      color: var(--color-inverse-foreground);
    }
  }

  @media (max-width: 549px) {
    .collection__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    /* The bar has no apply button with scripting on — it only exists inside
       <noscript> — so changing the sort order is what applies it. */
    function initSort(form) {
      if (form.getAttribute('data-sort-initialized') === 'true') return;
      form.setAttribute('data-sort-initialized', 'true');

      form.addEventListener('change', function (event) {
        if (!event.target.matches('[data-auto-submit]')) return;

        if (typeof form.requestSubmit === 'function') {
          form.requestSubmit();
          return;
        }

        /* Safari before 16 has no requestSubmit. Submitting the form directly
           is fine here: it is a GET form carrying one select, and the browser
           builds the same query string this would. */
        form.submit();
      });
    }

    /* Walk every sort form in scope rather than the first one, so a page
       carrying more than one collection section wires up all of them. */
    function init(scope) {
      scope.querySelectorAll('.collection__form').forEach(initSort);
    }

    init(document);
    document.addEventListener('shopify:section:load', function (event) {
      init(event.target);
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:general.collection",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "t:sections.collection.show_description",
      "default": true
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:sections.collection.products_per_page",
      "min": 8,
      "max": 24,
      "step": 4,
      "default": 12
    },
    {
      "type": "select",
      "id": "columns",
      "label": "t:sections.collection.columns",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    }
  ]
}
{% endschema %}
