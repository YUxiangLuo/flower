{% comment %}
  Collection page: a title, optional description, a sort bar and a paginated
  product grid.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}

{%- comment -%}
  One crop per pixel density, resolved once and used twice: the preload links
  below and the custom properties on the header have to name the same file, or
  the page fetches the artwork twice. The stylesheet picks between them with the
  same three resolution bands the `media` attributes use here — change a band in
  one place and it has to change in the other.
{%- endcomment -%}
{%- liquid
  if collection.image
    assign hero_1x = collection.image | image_url: width: 750
    assign hero_2x = collection.image | image_url: width: 1500
    assign hero_3x = collection.image | image_url: width: 2250
  endif
-%}

{%- if collection.image -%}
  {%- comment -%}
    A background-image is discovered only after the stylesheet has been parsed
    and the box laid out, and on a phone this artwork sits behind the page's own
    <h1> — usually its largest paint. These give the preload scanner something
    to find while the document is still being read. `media` keeps them as narrow
    as the CSS: a desktop parses three links and requests none of them.
  {%- endcomment -%}
  {%- comment -%}
    AssetPreload asks for `image_tag`'s preload argument instead, which is the
    right answer for an <img> and no answer at all here: there is no <img> to
    hang it on, and it emits an unconditional Link header — the artwork would
    then be preloaded on the desktop that never displays it, which is the whole
    reason this is a background image.
  {%- endcomment -%}
  {% # theme-check-disable AssetPreload %}
  <link rel="preload" as="image" media="(max-width: 749px) and (max-resolution: 1.49dppx)" href="{{ hero_1x }}">
  <link rel="preload" as="image" media="(max-width: 749px) and (min-resolution: 1.5dppx) and (max-resolution: 2.49dppx)" href="{{ hero_2x }}">
  <link rel="preload" as="image" media="(max-width: 749px) and (min-resolution: 2.5dppx)" href="{{ hero_3x }}">
  {% # theme-check-enable AssetPreload %}
{%- endif -%}

{%- comment -%}
  `full-width` opts out of the section grid's centred column so the product grid
  runs the width of the screen — a pressed-flower arrangement is the detail the
  customer came to look at, and at the page width four of them are small enough
  that the petals turn to mush.

  The inset comes back as padding rather than as the grid column, under a name
  of its own — see `--collection-inset` in the stylesheet, which everything on
  this page that needs the measurement reads, including the artwork band that
  steps back out of it to reach the screen edges.

  `--columns` sits here rather than on the grid because the header is laid out
  against the same tracks, and the two have to agree. Inheriting it from a
  common ancestor is what makes disagreeing impossible.
{%- endcomment -%}
<div class="collection full-width" style="--columns: {{ section.settings.columns }}">
  {%- comment -%}
    On narrow screens the collection's own artwork sits behind its name. The URL
    is handed to CSS as a custom property rather than an <img> so the file is
    only ever fetched where it is used: a background-image inside a media query
    is not requested when the query does not match, while an <img> is downloaded
    even when its container is display:none.

    Three properties rather than one `image-set()`: a custom property holding a
    function the browser does not know makes the whole declaration invalid at
    computed-value time, which drops the artwork entirely instead of falling
    back to an earlier declaration. Plain url() values and media queries have no
    such cliff.
  {%- endcomment -%}
  <header
    class="collection__header{% if collection.image %} collection__header--media{% endif %}"
    {%- if collection.image %}
      style="
        --collection-media: url('{{ hero_1x | escape }}');
        --collection-media-2x: url('{{ hero_2x | escape }}');
        --collection-media-3x: url('{{ hero_3x | escape }}');
      "
    {%- endif %}
  >
    <h1 class="collection__title">{{ collection.title }}</h1>
    {% if section.settings.show_description and collection.description != blank %}
      <div class="collection__description">{{ collection.description }}</div>
    {% endif %}
  </header>

  {% paginate collection.products by section.settings.products_per_page %}
    {% liquid
      assign current_sort = collection.sort_by | default: collection.default_sort_by

      # Shopify offers every sort it knows how to perform, including reversals
      # nobody reaches for. This is the curated list; anything outside it is
      # dropped from the control.
      assign allowed_sorts = 'manual,best-selling,price-ascending,price-descending,created-descending' | split: ','
    %}

    <form method="get" action="{{ collection.url }}" class="collection__bar collection__form">
      <span class="collection__count">
        {{ 'collection.products_count' | t: count: paginate.items }}
      </span>

      {% if collection.sort_options.size > 0 %}
        <div class="collection__sort">
          <label class="visually-hidden" for="SortBy-{{ section.id }}">
            {{- 'collection.sort_by' | t -}}
          </label>
          <select id="SortBy-{{ section.id }}" name="sort_by" data-auto-submit>
            {% comment %}
              A sort outside the curated list is still rendered while it is the
              one in effect — reached by a shared link, or set as the
              collection's default in the admin. Dropping it would leave the
              control naming a sort the page is not actually in.
            {% endcomment %}
            {% for option in collection.sort_options %}
              {% if allowed_sorts contains option.value or option.value == current_sort %}
                <option value="{{ option.value }}" {% if option.value == current_sort %}selected{% endif %}>
                  {%- comment -%}
                    Shopify calls the collection's own arrangement "Featured",
                    which reads as a category of product rather than an order to
                    put them in.
                  {%- endcomment -%}
                  {% if option.value == 'manual' %}
                    {{- 'collection.sort_recommended' | t -}}
                  {% else %}
                    {{- option.name -}}
                  {% endif %}
                </option>
              {% endif %}
            {% endfor %}
          </select>

          {% comment %}
            Sorting applies on change. Nothing would apply it without
            JavaScript, so the button exists for exactly that case.
          {% endcomment %}
          <noscript>
            <button type="submit" class="collection__apply">{{ 'collection.apply' | t }}</button>
          </noscript>
        </div>
      {% endif %}
    </form>

    {% if collection.products.size > 0 %}
      <div class="collection__grid">
        {%- comment -%}
          The cards on screen when the page opens are asked for eagerly so the
          preload scanner can find them; everything after stays deferred.

          Two, not `section.settings.columns`. The grid is four across only on a
          wide window: it is two columns under 990px and one under 550px, so a
          desktop count marked eager here would be three off-screen images
          racing the phone's own header artwork. Two is the whole first row at
          both narrow widths and the largest paint at every width above them.
        {%- endcomment -%}
        {%- comment -%}
          `full_width` is the grid's own layout restated for the image: the card
          is a fraction of the viewport at every width, never of the page width,
          and the `sizes` value has to say so or the browser keeps answering a
          wide monitor with the file it picked for a 1440px one.

          The larger `image_size` is what that answer needs to exist. Four cards
          across a 1920px screen render at ~470px, which a 2x display wants at
          ~940 — above the old ceiling of 700.

          The ceiling is global, so a phone pays for it too: at one column a
          350px card on a 3x screen now draws the 1000w candidate where it used
          to settle for 700w. That is the correct file for 1050 device pixels
          and it was under-served before, but it is also roughly double the
          bytes on the two cards marked eager below. Accepted deliberately —
          sharpness over weight — rather than overlooked. Lowering it back is a
          one-line change here if that trade ever stops being worth it.
        {%- endcomment -%}
        {% for product in collection.products %}
          {% if forloop.index0 < 2 %}
            {% render 'product-card',
              product: product,
              image_size: 1000,
              columns: section.settings.columns,
              full_width: true,
              eager: true
            %}
          {% else %}
            {% render 'product-card',
              product: product,
              image_size: 1000,
              columns: section.settings.columns,
              full_width: true
            %}
          {% endif %}
        {% endfor %}
      </div>

      {% render 'pagination', paginate: paginate %}
    {% else %}
      <div class="collection__empty">
        <p>{{ 'collection.empty' | t }}</p>
      </div>
    {% endif %}
  {% endpaginate %}
</div>

{% stylesheet %}
  /* A listing, not a marketing section: the products are what the customer came
     for, so the top gets a fraction of the section rhythm the rest of the theme
     uses and the grid starts near the fold. */
  .collection {
    padding-block: clamp(1.5rem, 3.5vw, 2.75rem) var(--section-spacing);

    /* Replaces the inset the section grid gives a centred child. See the note
       on the `full-width` class in the markup.

       The same measurement the site header insets its logo by, so the first
       card lines up under it — two full-width rows on the same page reading as
       one edge instead of two. A flat `--page-margin` stops growing while the
       header's inset does not, so the two drift apart by whatever 3vw exceeds
       the margin by: about 38px on a 1920 screen at the default 20px, more on
       anything wider.

       Named because the artwork band below steps back out of exactly this to
       reach the screen edges. Written out twice instead, the two would agree
       only while 3vw stays under `--page-margin` — a merchant setting, so
       where that stops being true depends on what they set it to, and above
       it a strip of page colour would show down both sides of the band. One
       expression, read from one place, cannot drift. */
    --collection-inset: max(var(--page-margin), 3vw);

    padding-inline: var(--collection-inset);
  }

  /* Left-aligned and stacked at every width, which is the whole design on a
     phone and the fallback the desktop grid below is built on top of. The one
     exception is the artwork band at 749px, which stays centred — near-white
     copy over a dark scrim is a banner, and a banner is centred. */
  .collection__header {
    margin-bottom: clamp(1rem, 2.5vw, 1.75rem);
  }

  .collection__title {
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: clamp(1.75rem, 3.2vw, 2.5rem);
    line-height: 1.15;
    /* A two-line collection name should break evenly rather than leave one
       word stranded under the rest. */
    text-wrap: balance;
  }

  /* Set in the heading serif, not the body sans. An italic sans under a serif
     title is what made the pair read as two unrelated voices; the same italic
     in Georgia reads as the title's own subtitle. */
  .collection__description {
    margin-top: var(--space-xs);
    font-family: var(--font-heading--family);
    font-style: italic;
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--color-muted);
    /* A measure, not a layout: on the desktop grid the track says where the
       copy starts and this says how wide it gets to be, so a merchant who
       writes three sentences does not end up with one very long line.

       68ch is about 77 characters in the rendered face — the top of the range
       that still reads as a measure, chosen so a one-sentence description sits
       on a single line. `ch` is the width of "0" in whatever font actually
       resolves from the heading stack, so the exact break moves between
       machines that do and do not have Georgia; the cap is deliberately loose
       enough that it does not matter. */
    max-width: 68ch;
  }

  /* `pretty` rather than `balance`: balance evens out line lengths, which is
     what a centred block wants and what a left-aligned one does not — it pulls
     the rag in and leaves the measure looking short of its own width. The
     centred artwork band puts `balance` back. */
  .collection__description p {
    text-wrap: pretty;
  }

  /* Shopify's rich-text editor writes alignment as `style="text-align: center"`
     on the paragraph itself, and an inline declaration outranks every normal
     rule a stylesheet can write. An author `!important` is the only thing that
     reaches past it — this is the theme's one use of it, together with the
     banner override further down that has to answer this rule in kind.

     Alignment here is structural, not decorative: the copy is a column of the
     header grid, and a centred rag inside one column reads as a mistake rather
     than a choice. Same position the `<strong>` rule below takes. `start`, not
     `left`, so a right-to-left storefront is not pinned the wrong way. */
  .collection__description,
  .collection__description * {
    text-align: start !important;
  }

  /* The header is set against the product grid's own tracks: the title takes
     the first column, the description starts at the second. Its left edge
     therefore lands on the second card's, and — this is the point — neither
     block moves when a collection has a long name, because each is placed by
     the track rather than by whatever precedes it.

     1200px, not the 990px where the product grid reaches its full column count.
     Sharing the grid's tracks means the title is set inside one of them, and at
     990px with four columns that track is about 215px against a 32px display
     serif — a two-word collection name wraps to two lines and a long one to
     four or five, which `align-items: center` then builds the whole band
     around. 1200px is where a track (~263px at a 38px face) is enough of a
     column to set a heading in. Below it the header keeps the stacked layout,
     which has the full width and does not care. */
  @media (min-width: 1200px) {
    .collection__header {
      display: grid;
      /* `--columns` and the gap both come from the same place the product grid
         reads them, so the two sets of tracks are the same tracks. */
      grid-template-columns: repeat(var(--columns), 1fr);
      gap: var(--content-gap);
      /* Centre lines, not baselines. The two blocks are different heights — one
         line of display serif against two or three of italic — and sharing a
         baseline hangs the taller one off the shorter, which leaves the row
         bottom-heavy. Centring reads them as one band instead.

         This only holds because the description's top margin is dropped below;
         a stray margin would offset the centre it is being measured from. */
      align-items: center;
    }

    .collection__title {
      grid-column: 1;
    }

    /* `2 / -1`, not a fixed span. The column count is a merchant setting, and
       a span of two would reach past the last track at their lowest choice and
       have the grid invent an extra one. This ends at whatever the last track
       is; `max-width` above is what actually sets the measure. */
    .collection__description {
      grid-column: 2 / -1;
      /* The row is the gap to the title now. */
      margin-top: 0;
    }
  }

  /* The description is merchant rich text. A pasted <strong> would otherwise
     land a heavy slab under a light serif title — the weight of the pairing is
     the theme's to decide, not the copy's. */
  .collection__description :is(strong, b) {
    font-weight: inherit;
  }

  /* One row: the count at the start, sorting at the end. The "Sort by" caption
     is what would force a wrap on a narrow viewport, so it survives as a
     visually hidden label on the select rather than as text in the bar.

     No rules above or below it — the gap to the grid is what sets it apart, and
     a line across the page was drawing more attention than a count and a select
     deserve. */
  .collection__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }

  .collection__sort {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  /* Only ever rendered inside <noscript>. */
  .collection__apply {
    padding: 0.35rem 1rem;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-foreground);
    background-color: transparent;
    border: 1px solid var(--color-foreground);
    cursor: pointer;
  }

  .collection__sort select {
    border: 0;
    border-bottom: 1px solid var(--color-line);
    background-color: transparent;
    color: var(--color-foreground);
    font-size: 0.85rem;
    padding: 0.2rem 1.25rem 0.2rem 0.2rem;
    cursor: pointer;
  }

  .collection__count {
    font-size: 0.8rem;
    color: var(--color-muted);
  }

  .collection__grid {
    display: grid;
    grid-template-columns: repeat(var(--columns), 1fr);
    gap: var(--content-gap);
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .collection__empty {
    text-align: center;
    padding-block: clamp(3rem, 8vw, 6rem);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
    color: var(--color-muted);
  }

  @media (max-width: 989px) {
    .collection__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 749px) {
    .collection__bar {
      justify-content: flex-start;
    }

    /* The band meets the site header directly. A strip of page colour between
       the two reads as a gap in the page rather than as margin, and only the
       variant that has artwork can close it — without one there is no band, and
       the title would sit against the header with nothing to separate them. */
    .collection:has(.collection__header--media) {
      padding-block-start: 0;
    }

    /* Keep the photograph crisp, then use the same dark scrim pattern as the
       hero so near-white copy reads over the artwork. */
    .collection__header--media {
      position: relative;
      isolation: isolate;
      overflow: hidden;
      /* No placeholder colour under the artwork, deliberately. The band is the
         photograph and the gradient over it, nothing else — which does mean the
         gradient paints a frame or two before the image it was drawn for, since
         one is CSS and the other is a network request. A base colour would fill
         that frame but only by substituting one visible state for another, and
         this one is at least the state the band is actually made of. Priming
         the fetch is what the preload links at the top of the file are for. */

      /* The scrim colour as an rgb triplet, so the stops below can vary its
         alpha. It is `--color-inverse-background` (#2a3320) at four tenths of
         its brightness — same hue, a fraction of the luminance.

         Taken down rather than used as-is because that colour carries too much
         chroma for the luminance it has: darkening a photograph with it means
         mixing in enough green to tint the whole band olive. At 40% the hue
         survives as an undertone while the darkening comes from being dark,
         which is the job. Written out by hand because Liquid does not run
         inside a stylesheet tag, so the token cannot be converted here — if
         that colour moves, move this with it.

         A triplet rather than `color-mix()` on the token itself, because an
         unsupported `color-mix()` invalidates the whole declaration — and the
         declaration it would take down is the one keeping near-white text
         legible over a photograph. `rgb()` with a slash alpha has no such
         cliff. */
      --scrim: 17 20 13;

      /* The one place the header is centred. Everywhere else it reads as a
         page heading and sits on the left margin; here it is a banner, and the
         near-white copy is centred in its own artwork rather than aligned to a
         grid that is behind the scrim. */
      text-align: center;
      /* Step back out of the section's own inset so the artwork reaches both
         edges — `--collection-inset`, not the margin it is derived from, or the
         two disagree at the widths where 3vw wins. */
      margin-inline: calc(var(--collection-inset) * -1);
      /* Named because the scrim's stops are anchored to it. The copy begins one
         of these in from the top and ends one up from the bottom, at any band
         height — which is the only thing that makes the gradient's flat middle
         line up with the text it is there to back. */
      --band-padding: clamp(2rem, 9vw, 3rem);
      padding: var(--band-padding) var(--collection-inset);
    }

    /* Centring the block, not just the text — the measure would otherwise sit
       against the left edge of a banner whose copy is centred inside it. */
    .collection__header--media .collection__description {
      margin-inline: auto;
    }

    /* Overrides the start-alignment default, which includes the `!important`
       that holds off the merchant's own inline alignment: the banner decides
       this one, the same way the rest of the header does. */
    .collection__header--media .collection__description,
    .collection__header--media .collection__description * {
      text-align: center !important;
    }

    /* Centred copy is exactly the case `balance` is for. */
    .collection__header--media .collection__description p {
      text-wrap: balance;
    }

    .collection__header--media::before,
    .collection__header--media::after {
      content: '';
      position: absolute;
      inset: 0;
    }

    /* The bands match the `media` attributes on the preload links in the
       markup one for one. A band that drifts here does not break the page, it
       just downloads the artwork twice — once for the link and once for this. */
    .collection__header--media::before {
      z-index: -2;
      background-image: var(--collection-media);
      background-size: cover;
      background-position: center;
      filter: saturate(0.55);
    }

    @media (min-resolution: 1.5dppx) {
      .collection__header--media::before {
        background-image: var(--collection-media-2x);
      }
    }

    @media (min-resolution: 2.5dppx) {
      .collection__header--media::before {
        background-image: var(--collection-media-3x);
      }
    }

    /* A flat scrim spends the same darkness everywhere, including the strips
       above and below the copy where there is nothing to keep legible. This
       spends it where the text is: dense through the middle, nearly clear at
       the edges, so the artwork reads as a photograph rather than as something
       behind a filter.

       The stops are anchored to `--band-padding`, the same measurement that
       insets the copy, so the flat middle begins exactly where the text begins
       however tall the band grows. Percentages would only agree with the copy
       at one band height: the padding is a fixed length, so a taller band — a
       wrapped title, a three-line description — pushes a smaller fraction of
       itself above the text, and the first line ends up sitting in the ramp at
       an alpha the contrast budget below never accounted for.

       The scrim carries the palette's hue rather than being neutral black, so
       the band reads as part of the theme — but only as an undertone. See the
       note on `--scrim` above for why the token is darkened before it is used.

       Contrast is a budget, not a taste call, and any colour that is not 0/0/0
       spends some of it: at a given alpha, a lighter scrim darkens less. 0.49
       is what holds the same headroom a 0.44 black scrim had — 4.5:1 for the
       near-white copy against artwork up to roughly 81% brightness. The five
       points are the whole price of the hue at this luminance; the undarkened
       token would have cost fifteen. A high-key photo above the line still
       falls short, because no fixed scrim survives a white image. */
    .collection__header--media::after {
      z-index: -1;
      background-image: linear-gradient(
        to bottom,
        rgb(var(--scrim) / 0.16) 0,
        rgb(var(--scrim) / 0.49) var(--band-padding),
        rgb(var(--scrim) / 0.49) calc(100% - var(--band-padding)),
        rgb(var(--scrim) / 0.18) 100%
      );
    }

    .collection__header--media .collection__title,
    .collection__header--media .collection__description {
      color: var(--color-inverse-foreground);
    }

    /* The artwork deliberately does not animate.

       An entrance keyed to page load only works on something that is there at
       page load, and the photograph is not: it is a network request, while the
       markup and the scrim are already painted. An animation running against it
       lands the image mid-flight — dimmer and slightly larger than it should be,
       then still moving — which is a worse arrival than no animation at all.
       Motion cannot cover a gap it has already started crossing.

       So the photograph simply appears, in one step and at its resting
       appearance, whenever it gets there. The copy below carries the entrance
       on its own, because the copy is the part that is actually ready when the
       entrance begins. */

    /* `ease-in-out`, deliberately not `--ease-out`. The theme's curve is front
       loaded: it spends about seventy percent of the distance in the first
       quarter of the time and drifts imperceptibly through the rest. That is
       what a settle wants — the drawer and the panels elsewhere arrive and then
       come to rest — and it is exactly wrong for a fade, because it makes a
       long one read as short no matter how much duration it is given. A
       symmetric curve is what lets two seconds be felt as two seconds.

       Movement stays at 4px. At this size the travel is only there to give the
       fade a direction; anything more and the copy is seen to move, which is
       the thing that stops reading as elegant. */
    .collection__header--media .collection__title,
    .collection__header--media .collection__description {
      animation: collection-copy-in 2s ease-in-out both;
    }

    /* The title starts on the first frame, with no delay of its own. On a phone
       this <h1> is the largest text on screen and the band behind it is a
       pseudo-element background, which is not an LCP candidate — so the heading
       is what the metric measures, and a fully transparent element is not
       counted as painted at all. Holding it back to open the choreography would
       be paying for the stagger in load time. The description carries the
       stagger instead; nothing measures when it arrives. */
    .collection__header--media .collection__title {
      animation-delay: 0s;
    }

    /* Far enough behind the title to be a second beat rather than a blur of the
       same one — 400ms is longer than the fade takes to become visible, so the
       two reads are sequential rather than overlapping. */
    .collection__header--media .collection__description {
      animation-delay: 400ms;
    }

    @keyframes collection-copy-in {
      from {
        opacity: 0;
        transform: translateY(0.25rem);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Nothing moves, but the copy still resolves out of nothing — an element
       that animates its own opacity from 0 has to be given a way to reach 1,
       or reduced motion becomes invisible text. */
    @media (prefers-reduced-motion: reduce) {
      .collection__header--media .collection__title,
      .collection__header--media .collection__description {
        animation-name: collection-copy-fade;
        animation-duration: 200ms;
        /* The stagger above is a choreography, and choreography is the thing
           being opted out of. Left in, it would hold the description invisible
           for half a second with nothing happening to explain the wait. */
        animation-delay: 0s;
      }

      @keyframes collection-copy-fade {
        from {
          opacity: 0;
        }
        to {
          opacity: 1;
        }
      }
    }
  }

  @media (max-width: 549px) {
    .collection__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    /* The bar has no apply button with scripting on — it only exists inside
       <noscript> — so changing the sort order is what applies it. */
    function initSort(form) {
      if (form.getAttribute('data-sort-initialized') === 'true') return;
      form.setAttribute('data-sort-initialized', 'true');

      form.addEventListener('change', function (event) {
        if (!event.target.matches('[data-auto-submit]')) return;

        if (typeof form.requestSubmit === 'function') {
          form.requestSubmit();
          return;
        }

        /* Safari before 16 has no requestSubmit. Submitting the form directly
           is fine here: it is a GET form carrying one select, and the browser
           builds the same query string this would. */
        form.submit();
      });
    }

    /* Walk every sort form in scope rather than the first one, so a page
       carrying more than one collection section wires up all of them. */
    function init(scope) {
      scope.querySelectorAll('.collection__form').forEach(initSort);
    }

    init(document);
    document.addEventListener('shopify:section:load', function (event) {
      init(event.target);
    });
  })();
{% endjavascript %}

