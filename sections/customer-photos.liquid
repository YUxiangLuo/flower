{% comment %}
  Customer photos of this product, read from metaobject entries linked to the
  product.

  The content has to come from the product rather than from section settings.
  templates/product.json is shared by every product, so anything stored in a
  block or a setting here would show the same photos on every product page —
  which is what made the block-driven review section this theme once carried
  unfixable.

  Requires a metaobject definition of type `customer_photo` with the fields
  `photo` (file, image), `body` (multi-line text) and `author` (single line
  text), plus a product metafield `custom.customer_photos` of type
  `list.metaobject_reference` pointing at it. Neither can be created from
  Liquid; both are set up in the Shopify admin.
{% endcomment %}

{% liquid
  assign snap_entries = product.metafields.custom.customer_photos.value
  assign default_snap_alt = 'sections.customer_photos.photo_alt' | t: product: product.title

  # Only whether there is anything to show; how many get rendered is counted
  # against photos_shown in the loop below.
  assign has_snaps = false
  for entry in snap_entries
    if entry.photo.value
      assign has_snaps = true
      break
    endif
  endfor
%}

{% if has_snaps or request.design_mode %}
  <div class="snaps snaps--{{ section.settings.background }} full-width">
    <div class="snaps__inner">
      <header class="snaps__header">
        {% if section.settings.eyebrow != blank %}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="snaps__heading">{{ section.settings.heading }}</h2>
        {% endif %}
      </header>

      {% if has_snaps %}
        {%- comment -%}
          The rail carries its own overflow so the document never scrolls
          sideways, the way the clips rail on the home page does.

          Nothing inside it can take focus — the clips rail has a button per
          card, this has only images — so the scroller itself has to be
          reachable, or a keyboard-only customer can never see past the cards
          that happen to fit the viewport.

          `photos_shown` counts photos rendered rather than entries walked. A
          `limit:` on the loop would spend the quota on entries whose image was
          removed in the admin, and enough of those in front would empty the
          rail while later entries still had photos. Counting to the limit is
          the pattern product-recommendations already uses.
        {%- endcomment -%}
        <ul
          class="snaps__rail"
          role="list"
          tabindex="0"
          aria-label="{{ 'sections.customer_photos.rail_label' | t }}"
        >
          {% assign shown = 0 %}
          {% for entry in snap_entries %}
            {% if shown >= section.settings.photos_shown %}
              {% break %}
            {% endif %}
            {% if entry.photo.value %}
              <li class="snap">
                <div class="snap__media">
                  {%- comment -%}
                    Resolve the alt text into a variable first. A `| default:`
                    written inside an `image_tag` argument binds to the tag's
                    output rather than to the argument, so the fallback would
                    silently never apply.
                  {%- endcomment -%}
                  {% assign snap_alt = entry.photo.value.alt | default: default_snap_alt %}
                  {{
                    entry.photo.value
                    | image_url: width: 800, height: 800, crop: 'center'
                    | image_tag: loading: 'lazy', class: 'snap__image', sizes: '(min-width: 750px) 20rem, 60vw', widths: '260, 380, 520, 640, 800', alt: snap_alt
                  }}
                </div>

                {% if entry.body.value != blank %}
                  {%- comment -%}
                    The field is multi-line, so the line breaks the customer
                    typed have to survive; without this they collapse into one
                    run-on paragraph. Escaping first keeps the <br> the only
                    markup that reaches the page.
                  {%- endcomment -%}
                  <p class="snap__body">{{ entry.body.value | escape | newline_to_br }}</p>
                {% endif %}

                {% if entry.author.value != blank %}
                  <p class="snap__author">{{ entry.author.value | escape }}</p>
                {% endif %}
              </li>
              {% assign shown = shown | plus: 1 %}
            {% endif %}
          {% endfor %}
        </ul>
      {% else %}
        {%- comment -%}
          Metaobject data cannot be faked in the theme editor, so an
          unconfigured product would otherwise show the merchant nothing at all
          and read as a broken section rather than an empty one. The header stays
          above it, or the heading and eyebrow settings would look dead in the
          one state a merchant is most likely to be setting them in.
        {%- endcomment -%}
        <p class="snaps__empty">{{ 'sections.customer_photos.editor_hint' | t }}</p>
      {% endif %}
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .snaps--page {
    background-color: var(--color-background);
  }

  .snaps--surface {
    background-color: var(--color-surface);
  }

  .snaps--surface-deep {
    background-color: var(--color-surface-deep);
  }

  .snaps__inner {
    max-width: var(--page-width);
    margin-inline: auto;
    padding-block: var(--section-spacing);
    padding-inline: var(--page-margin);
  }

  .snaps__header {
    text-align: center;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .snaps__heading {
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: var(--text-xl);
    line-height: 1.1;
  }

  /* The upper bound is what keeps a sparse rail sane. A bare 1fr hands each
     card an equal share of the full width, so two photos on a 1440px page
     become 680px squares and one becomes a 1400px square. Capped, a card stays
     a photo whatever the merchant linked. */
  .snaps__rail {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(13rem, 20rem);
    gap: var(--content-gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    padding: 0 0 var(--space-sm);
    margin: 0;
    list-style: none;
  }

  /* The rail is focusable so it can be scrolled from the keyboard; that focus
     has to be visible. */
  .snaps__rail:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 4px;
  }

  .snap {
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin: 0;
  }

  .snap__media {
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background-color: var(--color-surface-deep);
  }

  .snap__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .snap__body {
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .snap__author {
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .snaps__empty {
    text-align: center;
    color: var(--color-muted);
    font-style: italic;
  }

  @media (max-width: 749px) {
    .snaps__rail {
      grid-auto-columns: minmax(11rem, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.customer_photos.name",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.customer_photos.eyebrow",
      "default": "From our customers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.customer_photos.heading",
      "default": "Seen at home"
    },
    {
      "type": "select",
      "id": "background",
      "label": "t:sections.customer_photos.background",
      "options": [
        { "value": "page", "label": "t:options.background.page" },
        { "value": "surface", "label": "t:options.background.surface" },
        { "value": "surface-deep", "label": "t:options.background.surface_deep" }
      ],
      "default": "surface"
    },
    {
      "type": "range",
      "id": "photos_shown",
      "label": "t:sections.customer_photos.photos_shown",
      "min": 4,
      "max": 20,
      "step": 2,
      "default": 12
    }
  ],
  "enabled_on": { "templates": ["product"] },
  "presets": [{ "name": "t:sections.customer_photos.name" }]
}
{% endschema %}
