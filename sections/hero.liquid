{% comment %}
  Full-bleed hero carousel. Each slide is a block carrying its own image and
  copy. Slides are stacked in a single grid cell so the tallest one sets the
  height and crossfading never reflows the page.
{% endcomment %}

{% liquid
  assign slide_count = section.blocks.size
  if section.settings.autoplay and slide_count > 1
    assign autoplay = true
  else
    assign autoplay = false
  endif

  # The hero owns the page heading only where nothing else does. Every other
  # template renders its own h1 — the product title, the collection name, the
  # article headline — so a hero dropped onto one of those is demoted here
  # whatever the setting says. The class carries the look either way, so this
  # changes the outline and not the design.
  #
  # The setting is the escape hatch the template check cannot cover: the section
  # can be added more than once, and a second hero on the home page would
  # otherwise claim a second h1. That one gets set to h2 by hand.
  assign hero_owns_page_heading = false
  if section.settings.heading_level == 'h1'
    if template.name == 'index'
      assign hero_owns_page_heading = true
    endif
  endif

  assign hero_page_heading = section.blocks.first.settings.heading
%}

{%- comment -%}
  A carousel with no slides is a full-bleed band of empty minimum height. It
  stays up in the editor so the merchant can select it while adding a slide.
{%- endcomment -%}
{% if slide_count > 0 or request.design_mode %}
  <div
    class="hero full-width hero--{{ section.settings.content_position }}"
    style="--max-text: {{ section.settings.content_width }}rem"
    {% if slide_count > 1 %}
      data-hero
      data-autoplay="{{ autoplay }}"
      data-interval="{{ section.settings.autoplay_interval | times: 1000 }}"
      role="region"
      aria-roledescription="{{ 'sections.hero.carousel' | t }}"
      aria-label="{{ 'sections.hero.label' | t }}"
    {% endif %}
  >
    {%- comment -%}
      The page heading, kept out of the carousel so rotating cannot take it
      away. It repeats the first slide's words, which are on screen when the
      page loads, and is hidden visually because that slide already shows them
      at full size.
    {%- endcomment -%}
    {% if hero_owns_page_heading and hero_page_heading != blank %}
      <h1 class="visually-hidden">{{ hero_page_heading }}</h1>
    {% endif %}

    <div class="hero__slides">
      {% for block in section.blocks %}
        <div
          class="hero__slide"
          data-hero-slide
          {% if forloop.first %}
            data-active
          {% else %}
            aria-hidden="true"
            inert
          {% endif %}
          {{ block.shopify_attributes }}
        >
          <div class="hero__media">
            {% assign hero_image = block.settings.image %}
            {% if hero_image == blank %}
              {% assign hero_image = block.settings.mobile_image %}
            {% endif %}

            {% if hero_image != blank %}
              {%- comment -%}
                Resolve the alt text first. A `| default:` written inside an
                `image_tag` argument binds to the tag's output, not to the
                argument, so the fallback would silently never apply.
              {%- endcomment -%}
              {% assign hero_alt = hero_image.alt | default: block.settings.heading %}
              {%- capture hero_picture -%}
                {% if block.settings.mobile_image != blank %}
                  <source
                    media="(max-width: 749px)"
                    sizes="100vw"
                    srcset="
                      {{ block.settings.mobile_image | image_url: width: 375 }} 375w,
                      {{ block.settings.mobile_image | image_url: width: 550 }} 550w,
                      {{ block.settings.mobile_image | image_url: width: 750 }} 750w,
                      {{ block.settings.mobile_image | image_url: width: 1100 }} 1100w,
                      {{ block.settings.mobile_image | image_url: width: 1500 }} 1500w
                    "
                  >
                {% endif %}

                {% if forloop.first %}
                  {{
                    hero_image
                    | image_url: width: 2400
                    | image_tag: loading: 'eager', fetchpriority: 'high', class: 'hero__image', sizes: '100vw', widths: '600, 900, 1200, 1800, 2400', alt: hero_alt
                  }}
                {% else %}
                  {{
                    hero_image
                    | image_url: width: 2400
                    | image_tag: loading: 'lazy', class: 'hero__image', sizes: '100vw', widths: '600, 900, 1200, 1800, 2400', alt: hero_alt
                  }}
                {% endif %}
              {%- endcapture -%}

              <picture class="hero__picture">
                {%- comment -%}
                  Only the first slide is above the fold, but `loading="lazy"`
                  cannot express that here: every slide shares one grid cell, so
                  the ones behind are inside the viewport too, and the browser
                  decides from layout geometry — `visibility: hidden` still lays
                  out. Left as markup, all eight slides would download at once
                  and share bandwidth with the LCP image.

                  Hand the later slides' URLs over in data-* instead and let the
                  carousel promote them one slide ahead of the rotation. No
                  <noscript> copy: without script the carousel never rotates, so
                  the first slide is the only one those customers can reach.
                {%- endcomment -%}
                {% if forloop.first %}
                  {{ hero_picture }}
                {% else %}
                  {{ hero_picture | replace: ' src=', ' data-src=' | replace: ' srcset=', ' data-srcset=' }}
                {% endif %}
              </picture>
            {% elsif request.design_mode %}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'hero__image hero__image--placeholder' }}
            {% endif %}
            <span class="hero__scrim" style="--scrim: {{ block.settings.overlay_opacity }}%"></span>
          </div>

          <div class="hero__content">
            {% if block.settings.eyebrow != blank %}
              <p class="hero__eyebrow">{{ block.settings.eyebrow }}</p>
            {% endif %}

            {%- comment -%}
              The page's h1 cannot live in here: a slide that rotates away is
              given aria-hidden and inert, so an h1 on the first slide left the
              page with no h1 at all the moment the carousel moved on. It sits
              outside the slides instead.

              Which is why the first slide's copy is not a heading when that h1
              is present — the h1 above is already these exact words, and
              marking them up twice reads them out twice. Later slides are h2:
              nothing else carries their copy, and rotating clears aria-hidden,
              so without a heading their words would be on screen and missing
              from the outline.
            {%- endcomment -%}
            {% if block.settings.heading != blank %}
              {% if forloop.first and hero_owns_page_heading %}
                {%- comment -%}
                  Hidden from assistive technology, not just demoted from a
                  heading: the h1 above is these same words, and leaving both
                  in the tree reads them out twice. Nothing here is focusable
                  or carries meaning the h1 does not.
                {%- endcomment -%}
                <p class="hero__heading" aria-hidden="true">{{ block.settings.heading }}</p>
              {% else %}
                <h2 class="hero__heading">{{ block.settings.heading }}</h2>
              {% endif %}
            {% endif %}

            {% if block.settings.subheading != blank %}
              <p class="hero__subheading">{{ block.settings.subheading }}</p>
            {% endif %}

            {% if block.settings.button_label != blank and block.settings.button_link != blank %}
              <a class="hero__button" href="{{ block.settings.button_link }}">
                {{ block.settings.button_label }}
              </a>
            {% endif %}
          </div>
        </div>
      {% else %}
        {% if request.design_mode %}
          <div class="hero__slide" data-active>
            <div class="hero__media">
              {{ 'lifestyle-1' | placeholder_svg_tag: 'hero__image hero__image--placeholder' }}
              <span class="hero__scrim" style="--scrim: 30%"></span>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if slide_count > 1 %}
      <div class="hero__controls">
        <button
          class="hero__arrow hero__arrow--prev"
          type="button"
          data-hero-prev
          aria-label="{{ 'sections.hero.previous_slide' | t }}"
        >
          {{- 'icon-chevron.svg' | inline_asset_content -}}
        </button>

        <div class="hero__dots" role="group" aria-label="{{ 'sections.hero.slides' | t }}">
          {% for block in section.blocks %}
            <button
              class="hero__dot"
              type="button"
              data-hero-dot
              aria-label="{{ 'sections.hero.go_to_slide' | t: index: forloop.index }}"
              {% if forloop.first %}aria-current="true"{% endif %}
            ></button>
          {% endfor %}
        </div>

        <button
          class="hero__arrow hero__arrow--next"
          type="button"
          data-hero-next
          aria-label="{{ 'sections.hero.next_slide' | t }}"
        >
          {{- 'icon-chevron.svg' | inline_asset_content -}}
        </button>
      </div>
    {% endif %}
  </div>
{% endif %}

{% stylesheet %}
  .hero {
    position: relative;
    display: grid;
    color: #fff;
    /* Dark backstop so nothing light can flash through before images decode. */
    background-color: var(--color-foreground);
    isolation: isolate;
  }

  /* Slides and controls share one cell so the controls overlay the artwork
     instead of being auto-placed into a row of their own. */
  .hero__slides {
    grid-area: 1 / 1;
    display: grid;
  }

  /* Every slide occupies the same cell, so the tallest one sets the height. */
  .hero__slide {
    grid-area: 1 / 1;
    position: relative;
    display: grid;
    align-items: center;
    /* Fill what's left of the viewport below the announcement bar and header.
       The fallback covers both at their default heights until JS measures
       them; svh keeps mobile browser chrome from cropping the slide. */
    min-height: calc(100svh - var(--hero-offset, 7.5rem));
    opacity: 0;
    visibility: hidden;
    transition: opacity 1.2s ease-in-out, visibility 0s linear 1.2s;
  }

  /* The incoming slide fades in on top; the outgoing one stays fully opaque
     underneath until that finishes. Fading both at once would let the page
     background show through at the midpoint and flash the whole hero. */
  .hero__slide[data-active] {
    z-index: 2;
    opacity: 1;
    visibility: visible;
    transition: opacity 1.2s ease-in-out, visibility 0s;
  }

  .hero__slide[data-leaving] {
    z-index: 1;
    opacity: 1;
    visibility: visible;
    transition: none;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    background-color: var(--color-foreground);
  }

  .hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Ken Burns: the push-in restarts each time a slide becomes active, since
     the attribute re-applies the rule. It has to keep running while the slide
     is leaving too, or the image would snap back to 1x mid-fade. */
  .hero__slide[data-active] .hero__image,
  .hero__slide[data-leaving] .hero__image {
    animation: hero-push-in 12s ease-out forwards;
  }

  @keyframes hero-push-in {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.08);
    }
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    /* --scrim is already a percentage from the block setting. */
    background: linear-gradient(
      to top,
      rgb(0 0 0 / calc(var(--scrim) * 0.9)),
      rgb(0 0 0 / var(--scrim))
    );
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: var(--max-text);
    padding: var(--section-spacing) max(var(--page-margin), 6vw);
  }

  .hero--center {
    text-align: center;
  }

  .hero--center .hero__content {
    margin-inline: auto;
    align-items: center;
  }

  .hero--right .hero__content {
    margin-inline-start: auto;
  }

  .hero__eyebrow {
    font-size: 0.8rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  .hero__heading {
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: var(--text-hero);
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .hero__subheading {
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    line-height: 1.6;
    opacity: 0.92;
  }

  .hero__button {
    --hero-button-press-scale: 0.98;
    --hero-button-press-duration: 120ms;

    align-self: flex-start;
    margin-top: 0.75rem;
    padding: 0.9rem 2.4rem;
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #fff;
    text-decoration: none;
    border: 1px solid rgb(255 255 255 / 0.7);
    transition:
      background-color 0.4s ease,
      color 0.4s ease,
      transform var(--hero-button-press-duration) var(--ease-out);
  }

  .hero--center .hero__button {
    align-self: center;
  }

  .hero__button:hover,
  .hero__button:focus-visible {
    background-color: #fff;
    color: var(--color-foreground);
  }

  .hero__button:active {
    transform: scale(var(--hero-button-press-scale));
  }

  .hero__controls {
    grid-area: 1 / 1;
    align-self: end;
    justify-self: center;
    /* Above both the active (2) and leaving (1) slide layers. */
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding-bottom: clamp(1.5rem, 4vw, 3rem);
  }

  .hero__arrow {
    display: flex;
    padding: 0.5rem;
    background: transparent;
    border: 0;
    color: #fff;
    cursor: pointer;
    opacity: 0.7;
    transition: opacity 0.3s ease;
  }

  .hero__arrow:hover,
  .hero__arrow:focus-visible {
    opacity: 1;
  }

  .hero__arrow svg {
    width: 1.4rem;
  }

  .hero__arrow--next svg {
    transform: rotate(180deg);
  }

  .hero__dots {
    display: flex;
    gap: 0.75rem;
  }

  .hero__dot {
    width: 2.25rem;
    height: 1px;
    padding: 0;
    background-color: rgb(255 255 255 / 0.45);
    border: 0;
    cursor: pointer;
    transition: background-color 0.4s ease;
  }

  /* The hit area stays finger-sized even though the mark is a hairline. */
  .hero__dot::before {
    content: '';
    display: block;
    height: 2.75rem;
    margin-top: -1.375rem;
  }

  .hero__dot[aria-current='true'] {
    background-color: #fff;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__button {
      --hero-button-press-scale: 0.995;
      --hero-button-press-duration: 80ms;
    }

    .hero__slide,
    .hero__slide[data-active] {
      transition: none;
    }

    .hero__slide[data-active] .hero__image {
      animation: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    /* Everything stacked above a hero — announcement bar, header — sets how
       much of the viewport is left for it to fill. Measure per hero and store
       the offset on that element, so multiple heroes on one page each get their
       own value instead of sharing a single document-level one. */
    function measureOffset(hero) {
      var section = hero.closest('.shopify-section') || hero;
      var offset = section.getBoundingClientRect().top + window.pageYOffset;
      hero.style.setProperty('--hero-offset', offset + 'px');
    }

    function measureAll() {
      Array.prototype.forEach.call(document.querySelectorAll('.hero'), measureOffset);
    }

    function initCarousel(hero) {
      var slides = Array.prototype.slice.call(hero.querySelectorAll('[data-hero-slide]'));
      var dots = Array.prototype.slice.call(hero.querySelectorAll('[data-hero-dot]'));
      if (slides.length < 2) return null;

      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
      var interval = parseInt(hero.getAttribute('data-interval'), 10) || 6000;
      var timer = null;
      var leaveTimer = null;
      var transitionRequest = 0;
      var disposed = false;

      /* Start from whichever slide is actually on screen rather than assuming
         the first. Re-initialising against a carousel that had already rotated
         would otherwise hold the wrong slide opaque through the next crossfade
         — the one that was showing gets neither state and fades out uncovered,
         which is the background flash the stylesheet exists to prevent. */
      var index = slides.findIndex(function (slide) {
        return slide.hasAttribute('data-active');
      });
      if (index < 0) index = 0;

      /* Track every listener we add so the section can be torn down cleanly
         when the theme editor reloads it (shopify:section:unload). */
      var teardown = [];
      function on(target, type, handler) {
        target.addEventListener(type, handler);
        teardown.push(function () {
          target.removeEventListener(type, handler);
        });
      }

      /* The slides behind the active one carry their URLs in data-src and
         data-srcset rather than in src and srcset — the markup explains why
         `loading="lazy"` cannot defer a slide that shares the active one's grid
         cell. Promote them here instead, one slide ahead of the rotation, so
         the incoming artwork has a full interval to arrive and the first slide
         never shares its bandwidth with one nobody has asked for.

         Order matters inside a slide: document order puts <source> before
         <img>, and an <img> handed its src first would choose from its own
         srcset straight away and re-evaluate only once the <source> gained
         one — on a phone, that fetches the desktop crop and then the mobile
         one. querySelectorAll returns document order, so the loop preserves
         it. */
      function hydrate(slide, urgent) {
        if (!slide) return null;
        var image = slide.querySelector('img');
        if (image && urgent) {
          image.loading = 'eager';
          image.setAttribute('fetchpriority', 'high');
        }
        slide.querySelectorAll('[data-srcset], [data-src]').forEach(function (node) {
          var srcset = node.getAttribute('data-srcset');
          var src = node.getAttribute('data-src');
          if (srcset !== null) {
            node.removeAttribute('data-srcset');
            node.setAttribute('srcset', srcset);
          }
          if (src !== null) {
            node.removeAttribute('data-src');
            node.setAttribute('src', src);
          }
        });
        return image;
      }

      function warm(at) {
        hydrate(slides[((at % slides.length) + slides.length) % slides.length]);
      }

      function whenArtworkReady(image, ready) {
        if (!image) {
          ready();
          return;
        }

        function decodeThenReady() {
          if (image.complete && image.naturalWidth === 0) {
            ready();
            return;
          }
          if (typeof image.decode !== 'function') {
            ready();
            return;
          }

          var decoding;
          try {
            decoding = image.decode();
          } catch (error) {
            ready();
            return;
          }
          Promise.resolve(decoding).catch(function () {}).then(ready);
        }

        if (image.complete) {
          decodeThenReady();
          return;
        }

        var settled = false;
        function settle(event) {
          if (settled) return;
          settled = true;
          image.removeEventListener('load', settle);
          image.removeEventListener('error', settle);
          if (event && event.type === 'error') ready();
          else decodeThenReady();
        }

        image.addEventListener('load', settle);
        image.addEventListener('error', settle);
        if (image.complete) settle();
      }

      /* Read the crossfade length off the stylesheet so the two can't drift.
         A measured 0 is a real answer — reduced motion sets `transition: none`
         — and must not be mistaken for "nothing to read", or the outgoing slide
         would be held opaque for over a second with no crossfade to cover. */
      var measuredFade = parseFloat(getComputedStyle(slides[0]).transitionDuration);
      var fade = (isNaN(measuredFade) ? 1.2 : measuredFade) * 1000;

      function show(next, complete) {
        var target = (next + slides.length) % slides.length;
        var request = ++transitionRequest;
        if (target === index) {
          if (complete) complete();
          return;
        }

        /* A nearby slide is normally already warm; wrapping backwards or
           jumping from a dot may target one with no request yet. Connect that
           artwork at high priority, but keep the current slide visible until
           the selected image has loaded and decoded. Only then warm the slide
           after it, so the requested artwork does not compete with a speculative
           fetch on a slow connection. */
        var image = hydrate(slides[target], true);
        whenArtworkReady(image, function () {
          if (disposed || request !== transitionRequest) return;

          var previous = index;
          if (target === previous) {
            if (complete) complete();
            return;
          }
          index = target;

          /* Autoplay never permanently stops, so a slide can rotate away from
             under a keyboard user. `inert` on the element holding focus drops
             it to <body> and loses their place in the tab order entirely, so
             hand focus to the incoming slide's dot first: it sits outside the
             slides, is always focusable, and its aria-current says where they
             now are. preventScroll matters — the hero may be far above the
             viewport by now, and focusing must not yank the page back up. */
          var outgoing = slides[previous];
          if (dots[index] && outgoing.contains(document.activeElement)) {
            try {
              dots[index].focus({ preventScroll: true });
            } catch (error) {
              dots[index].focus();
            }
          }

          clearTimeout(leaveTimer);
          slides.forEach(function (slide, i) {
            slide.removeAttribute('data-leaving');
            if (i === index) {
              slide.setAttribute('data-active', '');
              slide.removeAttribute('aria-hidden');
              slide.removeAttribute('inert');
            } else {
              slide.removeAttribute('data-active');
              slide.setAttribute('aria-hidden', 'true');
              slide.setAttribute('inert', '');
            }
          });

          /* Hold the outgoing slide opaque below the incoming one until the
             fade is over, so the background never shows through. */
          outgoing.setAttribute('data-leaving', '');
          leaveTimer = setTimeout(function () {
            outgoing.removeAttribute('data-leaving');
          }, fade);

          dots.forEach(function (dot, i) {
            if (i === index) dot.setAttribute('aria-current', 'true');
            else dot.removeAttribute('aria-current');
          });

          warm(index + 1);
          if (complete) complete();
        });
      }

      function stop() {
        if (timer) {
          clearTimeout(timer);
          timer = null;
        }
      }

      /* Nothing the customer does permanently stops autoplay. Pausing on hover
         or on focus meant a full-bleed hero, which is most of the viewport,
         could park the carousel for the rest of the visit. A one-shot timer
         starts only after activation, so a slow image still receives its full
         interval on screen. */
      function start() {
        stop();
        if (disposed || document.hidden) return;
        if (hero.getAttribute('data-autoplay') !== 'true') return;
        if (reduced.matches) return;
        timer = setTimeout(function () {
          timer = null;
          show(index + 1, start);
        }, interval);
      }

      /* Advancing by hand re-syncs the timer so the slide the customer asked
         for still gets a full interval on screen. It never stops autoplay. */
      function goTo(next) {
        stop();
        show(next, start);
      }

      var prev = hero.querySelector('[data-hero-prev]');
      var next = hero.querySelector('[data-hero-next]');
      if (prev) {
        on(prev, 'click', function () {
          goTo(index - 1);
        });
      }
      if (next) {
        on(next, 'click', function () {
          goTo(index + 1);
        });
      }
      dots.forEach(function (dot, i) {
        on(dot, 'click', function () {
          goTo(i);
        });
      });

      /* A background tab is not something the customer did to the carousel, and
         this one cannot leave it parked: coming back always restarts it. */
      on(document, 'visibilitychange', function () {
        if (document.hidden) stop();
        else start();
      });

      if (reduced.addEventListener) on(reduced, 'change', start);

      start();

      /* Whatever is on screen needs its artwork now, load event or not: a
         carousel re-initialised by the theme editor can be sitting on a slide
         that was never promoted. */
      warm(index);

      /* Not before load: until the page has finished, the only hero image worth
         bandwidth is the one on screen. Re-initialising after that — the theme
         editor reloading the section — warms straight away, because there is no
         second load event coming. */
      function warmNext() {
        warm(index + 1);
      }
      if (document.readyState === 'complete') warmNext();
      else on(window, 'load', warmNext);

      return function cleanup() {
        disposed = true;
        transitionRequest += 1;
        stop();
        clearTimeout(leaveTimer);
        teardown.forEach(function (off) {
          off();
        });
        teardown = [];
      };
    }

    function init(scope) {
      measureAll();
      scope.querySelectorAll('[data-hero]').forEach(function (hero) {
        if (hero.heroCleanup) hero.heroCleanup();
        hero.heroCleanup = initCarousel(hero);
      });
    }

    function destroy(scope) {
      scope.querySelectorAll('[data-hero]').forEach(function (hero) {
        if (hero.heroCleanup) {
          hero.heroCleanup();
          hero.heroCleanup = null;
        }
      });
    }

    /* Register the page-level measurement once; per-hero listeners live and
       die with each carousel instance.

       Measuring reads getBoundingClientRect for every hero, which forces
       layout. Resize fires in a continuous stream — on mobile every time the
       address bar slides — so coalesce to one measurement per frame instead of
       thrashing layout on each event. */
    var measureFrame = null;
    function scheduleMeasure() {
      if (measureFrame !== null) return;
      measureFrame = window.requestAnimationFrame(function () {
        measureFrame = null;
        measureAll();
      });
    }

    window.addEventListener('resize', scheduleMeasure);
    window.addEventListener('load', measureAll);

    init(document);
    document.addEventListener('shopify:section:load', function (event) {
      init(event.target);
    });
    document.addEventListener('shopify:section:unload', function (event) {
      destroy(event.target);
    });
  })();
{% endjavascript %}

