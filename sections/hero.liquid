{% comment %}
  Full-bleed hero with a serif headline and a single call to action.
  Designed for an elegant, minimal storefront introduction.
{% endcomment %}

<div class="hero full-width hero--{{ section.settings.content_position }}">
  <div class="hero__media">
    {% if section.settings.image %}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag: loading: 'eager', fetchpriority: 'high', class: 'hero__image', sizes: '100vw', widths: '600, 900, 1200, 1800, 2400'
      }}
    {% else %}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'hero__image hero__image--placeholder' }}
    {% endif %}
    <span class="hero__scrim" style="--scrim: {{ section.settings.overlay_opacity }}%"></span>
  </div>

  <div class="hero__content" style="--max-text: {{ section.settings.content_width }}ch">
    {% if section.settings.eyebrow != blank %}
      <p class="hero__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h1 class="hero__heading">{{ section.settings.heading }}</h1>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <p class="hero__subheading">{{ section.settings.subheading }}</p>
    {% endif %}

    {% if section.settings.button_label != blank %}
      <a class="hero__button" href="{{ section.settings.button_link | default: '#' }}">
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .hero {
    position: relative;
    display: grid;
    align-items: center;
    min-height: clamp(30rem, 82vh, 52rem);
    color: #fff;
    isolation: isolate;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }

  .hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgb(0 0 0 / calc(var(--scrim) * 0.9 / 100)),
      rgb(0 0 0 / calc(var(--scrim) / 100))
    );
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: var(--max-text);
    padding: var(--section-spacing) max(var(--page-margin), 6vw);
  }

  .hero--center {
    text-align: center;
  }

  .hero--center .hero__content {
    margin-inline: auto;
    align-items: center;
  }

  .hero--right .hero__content {
    margin-inline-start: auto;
  }

  .hero__eyebrow {
    font-size: 0.8rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  .hero__heading {
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: clamp(2.5rem, 6vw, 4.75rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
  }

  .hero__subheading {
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    line-height: 1.6;
    opacity: 0.92;
  }

  .hero__button {
    align-self: flex-start;
    margin-top: 0.75rem;
    padding: 0.9rem 2.4rem;
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #fff;
    text-decoration: none;
    border: 1px solid rgb(255 255 255 / 0.7);
    transition: background-color 0.4s ease, color 0.4s ease;
  }

  .hero--center .hero__button {
    align-self: center;
  }

  .hero__button:hover,
  .hero__button:focus-visible {
    background-color: #fff;
    color: var(--color-foreground);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.hero.name",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.hero.image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:sections.hero.overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.hero.eyebrow",
      "default": "Pressed flower artistry"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.hero.heading",
      "default": "Turn the people you love into art made with real flowers"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "t:sections.hero.subheading",
      "default": "Every keepsake is handcrafted from real botanicals and made to last far beyond the day itself."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.hero.button_label",
      "default": "Discover your keepsake"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.hero.button_link"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "t:sections.hero.content_position",
      "options": [
        { "value": "left", "label": "t:sections.hero.position_left" },
        { "value": "center", "label": "t:sections.hero.position_center" },
        { "value": "right", "label": "t:sections.hero.position_right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "t:sections.hero.content_width",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "ch",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "t:sections.hero.name"
    }
  ]
}
{% endschema %}
