{% comment %}
  A numbered "how your keepsake is made" walkthrough. Uses section blocks so
  merchants can add, remove and reorder steps. This is the trust centrepiece:
  it shows the handmade, real-flower process behind every frame.
{% endcomment %}

<div class="craft craft--{{ section.settings.background }} full-width">
  <div class="craft__inner">
    <header class="craft__header">
      {% if section.settings.eyebrow != blank %}
        <p class="craft__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="craft__heading">{{ section.settings.heading }}</h2>
      {% endif %}
    </header>

    <ol class="craft__steps" style="--columns: {{ section.blocks.size }}">
      {% for block in section.blocks %}
        <li class="craft__step" {{ block.shopify_attributes }}>
          {% if block.settings.image %}
            <div class="craft__media">
              {{
                block.settings.image
                | image_url: width: 800, height: 800, crop: 'center'
                | image_tag: loading: 'lazy', class: 'craft__image', alt: block.settings.title
              }}
            </div>
          {% endif %}
          <span class="craft__num" aria-hidden="true">{{ forloop.index }}</span>
          {% if block.settings.title != blank %}
            <h3 class="craft__step-title">{{ block.settings.title }}</h3>
          {% endif %}
          {% if block.settings.text != blank %}
            <p class="craft__step-text">{{ block.settings.text }}</p>
          {% endif %}
        </li>
      {% endfor %}
    </ol>
  </div>
</div>

{% stylesheet %}
  .craft--page {
    background-color: var(--color-background);
  }
  .craft--surface {
    background-color: var(--color-surface);
  }
  .craft--surface-deep {
    background-color: var(--color-surface-deep);
  }

  .craft__inner {
    max-width: var(--page-width);
    margin-inline: auto;
    padding-block: var(--section-spacing);
    padding-inline: var(--page-margin);
  }

  .craft__header {
    text-align: center;
    max-width: 42rem;
    margin: 0 auto clamp(2.5rem, 5vw, 4rem);
  }

  .craft__eyebrow {
    font-size: 0.8rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.9rem;
  }

  .craft__heading {
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: clamp(1.9rem, 3.5vw, 2.9rem);
    line-height: 1.15;
  }

  .craft__steps {
    display: grid;
    grid-template-columns: repeat(var(--columns), 1fr);
    gap: var(--content-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .craft__step {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-line);
  }

  .craft__media {
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    margin-bottom: 0.5rem;
    background-color: var(--color-surface);
  }

  .craft__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .craft__num {
    font-family: var(--font-heading--family);
    font-size: 2.4rem;
    line-height: 1;
    color: var(--color-accent);
  }

  .craft__step-title {
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: 1.35rem;
    line-height: 1.2;
  }

  .craft__step-text {
    line-height: 1.7;
    color: var(--color-muted);
  }

  @media (max-width: 749px) {
    .craft__steps {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.craft_steps.name",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.craft_steps.eyebrow",
      "default": "The making of a keepsake"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.craft_steps.heading",
      "default": "Handmade from real flowers, start to finish"
    },
    {
      "type": "select",
      "id": "background",
      "label": "t:sections.craft_steps.background",
      "options": [
        { "value": "page", "label": "t:options.background.page" },
        { "value": "surface", "label": "t:options.background.surface" },
        { "value": "surface-deep", "label": "t:options.background.surface_deep" }
      ],
      "default": "page"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "t:sections.craft_steps.block_name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.craft_steps.image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.craft_steps.title",
          "default": "Share your flowers"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:sections.craft_steps.text",
          "default": "Send us the stems from your day, or choose birth flowers for everyone in the frame."
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "t:sections.craft_steps.name",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Share your flowers",
            "text": "Send us the stems from your day, or choose birth flowers for everyone in the frame."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Pressed & arranged by hand",
            "text": "Each bloom is pressed within days, then composed by hand in our studio — no two are alike."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Sealed in glass to last",
            "text": "Set under glass in a solid frame, your keepsake holds its colour for years to come."
          }
        }
      ]
    }
  ]
}
{% endschema %}
