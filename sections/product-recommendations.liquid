{% liquid
  assign rec_collection = null
  for collection in product.collections
    if collection.all_products_count > 1
      assign rec_collection = collection
      break
    endif
  endfor

  assign has_native_recommendations = false
  if recommendations.performed?
    if recommendations.products_count > 0
      assign has_native_recommendations = true
    endif
  endif

  assign recommendation_products = null
  assign recommendation_source = 'none'
  if has_native_recommendations
    assign recommendation_products = recommendations.products
    assign recommendation_source = 'shopify'
  elsif rec_collection
    assign recommendation_products = rec_collection.products
    assign recommendation_source = 'collection'
  endif

  assign recommendation_count = 0
  for candidate_product in recommendation_products
    unless candidate_product.id == product.id
      assign recommendation_count = recommendation_count | plus: 1
      if recommendation_count >= section.settings.products_to_show
        break
      endif
    endunless
  endfor

  assign show_recommendations = false
  if recommendation_count > 0
    assign show_recommendations = true
  elsif request.design_mode
    assign show_recommendations = true
  endif
%}

{% if product != blank %}
  {%- capture recommendations_url -%}
    {{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}&intent=related
  {%- endcapture -%}

  <div
    class="recommend full-width"
    data-product-recommendations
    data-recommendations-url="{{ recommendations_url | strip | escape }}"
    data-recommendation-source="{{ recommendation_source }}"
    {% unless show_recommendations %}hidden{% endunless %}
  >
    <div class="recommend__inner">
      <header class="recommend__header">
        {% if section.settings.eyebrow != blank %}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="recommend__heading">{{ section.settings.heading }}</h2>
        {% endif %}
      </header>

      <div
        class="recommend__grid"
        style="--columns: {{ section.settings.columns }}"
        data-recommendations-content
      >
        {% assign shown = 0 %}
        {% for card_product in recommendation_products %}
          {% if shown >= section.settings.products_to_show %}
            {% break %}
          {% endif %}
          {% unless card_product.id == product.id %}
            {% render 'product-card',
              product: card_product,
              image_size: 600,
              heading_level: 'h3',
              columns: section.settings.columns
            %}
            {% assign shown = shown | plus: 1 %}
          {% endunless %}
        {% endfor %}
      </div>
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .recommend {
    background-color: var(--color-background);
  }

  .recommend__inner {
    max-width: var(--page-width);
    margin-inline: auto;
    padding-block: var(--section-spacing);
    padding-inline: var(--page-margin);
  }

  .recommend__header {
    text-align: center;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .recommend__heading {
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: var(--text-xl);
    line-height: 1.1;
  }

  .recommend__grid {
    display: grid;
    grid-template-columns: repeat(var(--columns), 1fr);
    gap: var(--content-gap);
  }

  @media (max-width: 989px) {
    .recommend__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 549px) {
    .recommend__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    function initRecommendations(root) {
      if (root.getAttribute('data-recommendations-initialized') === 'true') return;
      root.setAttribute('data-recommendations-initialized', 'true');

      var url = root.getAttribute('data-recommendations-url');
      if (!url || !window.fetch || !window.DOMParser) return;

      var controller = typeof window.AbortController === 'function' ? new window.AbortController() : null;
      var options = {
        credentials: 'same-origin',
        headers: { Accept: 'text/html' }
      };
      if (controller) options.signal = controller.signal;

      window
        .fetch(url, options)
        .then(function (response) {
          if (!response.ok) throw new Error('Unable to load product recommendations');
          return response.text();
        })
        .then(function (html) {
          if (!root.isConnected) return;

          var rendered = new window.DOMParser().parseFromString(html, 'text/html');
          var nextRoot = rendered.querySelector('[data-product-recommendations]');
          if (!nextRoot) return;
          if (nextRoot.getAttribute('data-recommendation-source') !== 'shopify') return;
          if (nextRoot.hidden || !nextRoot.querySelector('.product-card')) return;

          root.innerHTML = nextRoot.innerHTML;
          root.hidden = false;
          root.setAttribute('data-recommendation-source', 'shopify');
        })
        .catch(function () {});

      root.recommendationsCleanup = function () {
        if (controller) controller.abort();
        root.removeAttribute('data-recommendations-initialized');
        root.recommendationsCleanup = null;
      };
    }

    function init(scope) {
      scope.querySelectorAll('[data-product-recommendations]').forEach(initRecommendations);
    }

    function destroy(scope) {
      scope.querySelectorAll('[data-product-recommendations]').forEach(function (root) {
        if (root.recommendationsCleanup) root.recommendationsCleanup();
      });
    }

    init(document);
    document.addEventListener('shopify:section:load', function (event) {
      init(event.target);
    });
    document.addEventListener('shopify:section:unload', function (event) {
      destroy(event.target);
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.product_recommendations.name",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.product_recommendations.eyebrow",
      "default": "More to love"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.product_recommendations.heading",
      "default": "You may also like"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:sections.product_recommendations.products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:sections.product_recommendations.columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "t:sections.product_recommendations.name"
    }
  ]
}
{% endschema %}
