{% comment %}
  Cart page: an overview of the items in the customer's cart with quantity
  controls, a subtotal and checkout.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/cart
{% endcomment %}

<div
  class="cart"
  data-cart-section
  data-section-id="{{ section.id }}"
  data-cart-change-url="{{ routes.cart_change_url }}.js"
  data-cart-update-url="{{ routes.cart_update_url }}.js"
  data-cart-page-url="{{ routes.cart_url }}"
  data-status-updating="{{ 'cart.updating' | t | escape }}"
  data-status-updated="{{ 'cart.updated' | t | escape }}"
  data-status-note-saved="{{ 'cart.note_saved' | t | escape }}"
  data-status-error="{{ 'cart.update_error' | t | escape }}"
  data-status-invalid-quantity="{{ 'cart.quantity_invalid' | t | escape }}"
>
  <header class="cart__header">
    <h1 class="cart__title" data-cart-title>{{ 'cart.title' | t }}</h1>
  </header>

  <p class="cart__status" data-cart-status role="status" aria-live="polite" aria-atomic="true"></p>

  {% if cart.item_count == 0 %}
    <div class="cart__empty">
      <p>{{ 'cart.empty' | t }}</p>
      <a class="cart__button" href="{{ routes.all_products_collection_url }}">
        {{ 'cart.empty_cta' | t }}
      </a>
    </div>
  {% else %}
    {% form 'cart', cart, class: 'cart__form' %}
      <div class="cart__items" role="table">
        <div class="cart__row cart__row--head" role="row">
          <span role="columnheader">{{ 'cart.product' | t }}</span>
          <span role="columnheader">{{ 'cart.quantity' | t }}</span>
          <span role="columnheader" class="cart__cell--end">{{ 'cart.total' | t }}</span>
        </div>

        {% for item in cart.items %}
          <div
            class="cart__row"
            role="row"
            data-cart-line
            data-line-key="{{ item.key | escape }}"
            data-line-index="{{ forloop.index }}"
          >
            <div class="cart__product" role="cell">
              <a class="cart__media" href="{{ item.url }}">
                {% if item.image %}
                  {{
                    item.image
                    | image_url: width: 200, height: 250, crop: 'center'
                    | image_tag: loading: 'lazy', class: 'cart__image', sizes: '112px', widths: '96, 144, 200', alt: item.title
                  }}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'cart__image' }}
                {% endif %}
              </a>

              <div class="cart__details">
                <a class="cart__product-title" href="{{ item.url }}">{{ item.product.title }}</a>
                {% unless item.product.has_only_default_variant %}
                  <p class="cart__variant">{{ item.variant.title }}</p>
                {% endunless %}
                {%- capture cart_item_properties -%}
                  {%- for property in item.properties -%}
                    {%- assign property_first_char = property.first | slice: 0 -%}
                    {%- unless property.last == blank or property_first_char == '_' -%}
                      <li class="cart__property">
                        <span class="cart__property-name">{{ property.first | escape }}:</span>
                        {{ property.last | escape }}
                      </li>
                    {%- endunless -%}
                  {%- endfor -%}
                {%- endcapture -%}
                {%- if cart_item_properties != blank -%}
                  <ul class="cart__properties">{{ cart_item_properties }}</ul>
                {%- endif -%}
                <p class="cart__unit-price">{{ item.final_price | money }}</p>
                {% if item.line_level_discount_allocations.size > 0 %}
                  <ul class="cart__discounts" role="list">
                    {% for discount_allocation in item.line_level_discount_allocations %}
                      <li class="cart__discount">
                        <span>{{ discount_allocation.discount_application.title | escape }}</span>
                        <span class="cart__discount-amount">
                          &minus;{{ discount_allocation.amount | money }}
                        </span>
                      </li>
                    {% endfor %}
                  </ul>
                {% endif %}
                <a
                  class="cart__remove"
                  href="{{ item.url_to_remove }}"
                  data-cart-remove
                  data-cart-control="remove"
                  data-line-key="{{ item.key | escape }}"
                  data-line-index="{{ forloop.index }}"
                >
                  {{- 'cart.remove' | t -}}
                </a>
              </div>
            </div>

            <div class="cart__quantity" role="cell">
              <div class="cart__stepper">
                <button
                  type="button"
                  data-qty-step="-1"
                  data-qty-target="updates-{{ forloop.index }}"
                  data-cart-control="decrease"
                  data-line-index="{{ forloop.index }}"
                  aria-label="{{ 'product.decrease_quantity' | t }}"
                >
                  &minus;
                </button>
                <input
                  id="updates-{{ forloop.index }}"
                  class="cart__quantity-input"
                  type="number"
                  name="updates[]"
                  value="{{ item.quantity }}"
                  min="0"
                  step="1"
                  inputmode="numeric"
                  data-cart-quantity
                  data-cart-control="quantity"
                  data-line-key="{{ item.key | escape }}"
                  data-line-index="{{ forloop.index }}"
                  data-current-quantity="{{ item.quantity }}"
                  aria-label="{{ 'cart.quantity' | t }}"
                >
                <button
                  type="button"
                  data-qty-step="1"
                  data-qty-target="updates-{{ forloop.index }}"
                  data-cart-control="increase"
                  data-line-index="{{ forloop.index }}"
                  aria-label="{{ 'product.increase_quantity' | t }}"
                >
                  +
                </button>
              </div>
            </div>

            <div class="cart__line-total cart__cell--end" role="cell">
              {% if item.original_line_price > item.final_line_price %}
                <s class="cart__line-was">{{ item.original_line_price | money }}</s>
              {% endif %}
              <span>{{ item.final_line_price | money }}</span>
            </div>
          </div>
        {% endfor %}
      </div>

      <div class="cart__footer">
        {% if section.settings.show_note %}
          <div class="cart__note">
            <label for="cart-note">{{ 'cart.note' | t }}</label>
            <textarea id="cart-note" name="note" rows="3">{{ cart.note | escape }}</textarea>
          </div>
        {% endif %}

        <div class="cart__summary">
          <div class="cart__subtotal">
            <span>{{ 'cart.subtotal' | t }}</span>
            <span class="cart__subtotal-value">{{ cart.items_subtotal_price | money }}</span>
          </div>
          {% if cart.cart_level_discount_applications.size > 0 %}
            <ul class="cart__discounts cart__discounts--summary" role="list">
              {% for discount_application in cart.cart_level_discount_applications %}
                <li class="cart__discount">
                  <span>{{ discount_application.title | escape }}</span>
                  <span class="cart__discount-amount">
                    &minus;{{ discount_application.total_allocated_amount | money }}
                  </span>
                </li>
              {% endfor %}
            </ul>
          {% endif %}
          <div class="cart__total">
            <span>{{ 'cart.total' | t }}</span>
            <span class="cart__total-value">{{ cart.total_price | money }}</span>
          </div>
          <p class="cart__taxes">
            {% if cart.duties_included %}
              {% if cart.taxes_included %}
                {{ 'cart.duties_and_taxes_included' | t }}
              {% else %}
                {{ 'cart.duties_included' | t }}
              {% endif %}
            {% elsif cart.taxes_included %}
              {{ 'cart.taxes_included' | t }}
            {% else %}
              {{ 'cart.taxes_note' | t }}
            {% endif %}
          </p>

          <div class="cart__actions">
            <button type="submit" name="update" class="cart__button cart__button--ghost">
              {{ 'cart.update' | t }}
            </button>
            <button type="submit" name="checkout" class="cart__button">
              {{ 'cart.checkout' | t }}
            </button>
          </div>
        </div>
      </div>
    {% endform %}
  {% endif %}
</div>

{% stylesheet %}
  .cart {
    padding-block: var(--section-spacing);
  }

  .cart__header {
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .cart__status {
    min-height: 1.25em;
    margin: -1.5rem 0 1.5rem;
    color: var(--color-muted);
    font-size: 0.85rem;
  }

  .cart__status:empty {
    min-height: 0;
    margin-block: 0;
  }

  .cart__status--error {
    color: var(--color-accent);
  }

  .cart__title {
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: clamp(2rem, 4vw, 3rem);
  }

  .cart__empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    text-align: center;
    padding-block: clamp(3rem, 8vw, 6rem);
    color: var(--color-muted);
  }

  .cart__items {
    display: flex;
    flex-direction: column;
  }

  .cart__row {
    display: grid;
    grid-template-columns: 1fr auto 8rem;
    align-items: center;
    gap: 1.5rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--color-line);
  }

  .cart__row--head {
    padding-block: 0.75rem;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
    border-bottom: 1px solid var(--color-line);
  }

  .cart__cell--end {
    text-align: end;
    justify-self: end;
  }

  .cart__product {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .cart__media {
    flex: 0 0 auto;
    width: 5rem;
  }

  .cart__image {
    width: 100%;
    height: auto;
    background-color: var(--color-surface);
  }

  .cart__details {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .cart__product-title {
    font-family: var(--font-heading--family);
    font-size: 1.1rem;
    color: var(--color-foreground);
    text-decoration: none;
  }

  .cart__variant,
  .cart__unit-price {
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  .cart__properties {
    list-style: none;
    margin: 0.15rem 0 0;
    padding: 0;
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--color-muted);
  }

  .cart__properties:empty {
    display: none;
  }

  .cart__property-name {
    color: var(--color-foreground);
  }

  .cart__remove {
    align-self: flex-start;
    margin-top: 0.25rem;
    font-size: 0.78rem;
    color: var(--color-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .cart__remove:hover {
    color: var(--color-accent);
  }

  .cart__remove[aria-disabled='true'] {
    opacity: 0.55;
    pointer-events: none;
  }

  .cart__stepper {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--color-line);
  }

  .cart__stepper button {
    width: 2.25rem;
    height: 2.5rem;
    background: transparent;
    border: 0;
    color: var(--color-foreground);
    font-size: 1.05rem;
    cursor: pointer;
  }

  .cart__quantity-input {
    width: 2.75rem;
    height: 2.5rem;
    text-align: center;
    border: 0;
    border-inline: 1px solid var(--color-line);
    background: transparent;
    color: var(--color-foreground);
    -moz-appearance: textfield;
    appearance: textfield;
  }

  .cart__quantity-input::-webkit-outer-spin-button,
  .cart__quantity-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .cart__line-total {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: 0.95rem;
  }

  .cart__line-was {
    color: var(--color-muted);
    font-size: 0.85rem;
  }

  .cart__discounts {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--color-accent);
    font-size: 0.8rem;
  }

  .cart__discount {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
  }

  .cart__discount-amount {
    white-space: nowrap;
  }

  .cart__footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2rem;
    margin-top: 2.5rem;
  }

  .cart__note {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1 1 18rem;
    max-width: 26rem;
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  .cart__note textarea {
    padding: 0.75rem;
    border: 1px solid var(--color-line);
    background-color: var(--color-background);
    color: var(--color-foreground);
    resize: vertical;
  }

  .cart__summary {
    flex: 1 1 20rem;
    max-width: 26rem;
    margin-inline-start: auto;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .cart__subtotal {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 1rem;
  }

  .cart__subtotal-value {
    white-space: nowrap;
  }

  .cart__discounts--summary .cart__discount {
    justify-content: space-between;
  }

  .cart__total {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-sm);
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-line);
  }

  .cart__total-value {
    font-family: var(--font-heading--family);
    font-size: 1.5rem;
    white-space: nowrap;
  }

  .cart__taxes {
    font-size: 0.8rem;
    color: var(--color-muted);
  }

  .cart__actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .cart__button {
    padding: 1rem 2rem;
    font-size: 0.82rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-align: center;
    text-decoration: none;
    color: var(--color-background);
    background-color: var(--color-foreground);
    border: 1px solid var(--color-foreground);
    cursor: pointer;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .cart__button:hover,
  .cart__button:focus-visible {
    background-color: transparent;
    color: var(--color-foreground);
  }

  .cart__button--ghost {
    color: var(--color-foreground);
    background-color: transparent;
  }

  .cart__button--ghost:hover,
  .cart__button--ghost:focus-visible {
    background-color: var(--color-foreground);
    color: var(--color-background);
  }

  .cart--ajax .cart__button[name='update'] {
    display: none;
  }

  .cart[aria-busy='true'] button,
  .cart[aria-busy='true'] input,
  .cart[aria-busy='true'] textarea {
    cursor: wait;
  }

  .cart[aria-busy='true'] button:disabled,
  .cart[aria-busy='true'] input:disabled,
  .cart[aria-busy='true'] textarea:disabled {
    opacity: 0.55;
  }

  @media (max-width: 749px) {
    .cart__row {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        "product product"
        "quantity total";
    }

    .cart__row--head {
      display: none;
    }

    .cart__product {
      grid-area: product;
    }

    .cart__quantity {
      grid-area: quantity;
    }

    .cart__line-total {
      grid-area: total;
      align-items: flex-end;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    var ajaxSupported = Boolean(window.fetch && window.Promise && window.DOMParser);

    function setStatus(cart, message, isError) {
      var status = cart.querySelector('[data-cart-status]');
      if (!status) return;
      status.textContent = message || '';
      status.classList.toggle('cart__status--error', Boolean(isError));
    }

    function setBusy(cart, isBusy) {
      cart.setAttribute('aria-busy', isBusy ? 'true' : 'false');
      cart.querySelectorAll('button, input, textarea').forEach(function (control) {
        control.disabled = isBusy;
      });
      cart.querySelectorAll('[data-cart-remove]').forEach(function (link) {
        link.setAttribute('aria-disabled', isBusy ? 'true' : 'false');
      });
    }

    /* The header owns its own markup and listens for this; the drawer keeps
       itself in step by marking stale, since the response here only carries the
       cart page's own section HTML. */
    function announceCart(itemCount) {
      document.dispatchEvent(
        new CustomEvent('cart:updated', { detail: { itemCount: itemCount } })
      );
      document.dispatchEvent(new CustomEvent('cart:refresh', { detail: {} }));
    }

    function requestCart(url, payload) {
      return fetch(url, {
        method: 'POST',
        credentials: 'same-origin',
        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json',
          'X-Requested-With': 'XMLHttpRequest'
        },
        body: JSON.stringify(payload)
      }).then(function (response) {
        return response
          .json()
          .catch(function () {
            return {};
          })
          .then(function (data) {
            if (!response.ok) {
              var requestError = new Error(data.description || data.message || '');
              requestError.isCartResponseError = true;
              throw requestError;
            }
            return data;
          });
      });
    }

    function focusDescriptor(control) {
      if (!control) return null;
      return {
        control: control.getAttribute('data-cart-control'),
        lineIndex: control.getAttribute('data-line-index')
      };
    }

    function restoreFocus(cart, descriptor) {
      if (!descriptor) return;

      var target = null;
      if (descriptor.control && descriptor.lineIndex) {
        target = cart.querySelector(
          '[data-cart-control="' + descriptor.control + '"][data-line-index="' + descriptor.lineIndex + '"]'
        );
      }
      if (!target) target = cart.querySelector('[data-cart-control="quantity"]');
      if (!target) {
        target = cart.querySelector('[data-cart-title]');
        if (target) target.setAttribute('tabindex', '-1');
      }
      if (!target) return;

      window.requestAnimationFrame(function () {
        try {
          target.focus({ preventScroll: true });
        } catch (error) {
          target.focus();
        }
      });
    }

    /* The node a state was built around can be detached by the time its request
       lands — the theme editor swaps the whole section on re-render. Fall back to
       whichever cart is on the page so a late response still updates what the
       customer sees; `replaceWith` on an orphaned node is a silent no-op, which
       would leave the page showing quantities the server no longer holds. */
    function liveCart(currentCart) {
      if (currentCart.isConnected) return currentCart;
      return document.querySelector('[data-cart-section]');
    }

    function teardownCart(cart) {
      if (!cart || !cart.cartCleanup) return;
      cart.cartCleanup();
      cart.cartCleanup = null;
    }

    function replaceCart(currentCart, sectionHtml, descriptor, message, isError) {
      if (typeof sectionHtml !== 'string') {
        throw new Error('Missing cart section HTML');
      }

      var renderedDocument = new DOMParser().parseFromString(sectionHtml, 'text/html');
      var nextCart = renderedDocument.querySelector('[data-cart-section]');
      if (!nextCart) {
        throw new Error('Missing cart section root');
      }

      var target = liveCart(currentCart);
      if (!target) return;

      /* Retire the outgoing node's state before it leaves the DOM so a queued
         flush can't fire against a cart nobody is looking at. */
      teardownCart(target);
      target.replaceWith(nextCart);
      initCart(nextCart);
      setStatus(nextCart, message, isError);
      restoreFocus(nextCart, descriptor);
    }

    function renderCartData(state, cartData, descriptor, message, isError) {
      announceCart(cartData.item_count);
      replaceCart(
        state.cart,
        cartData.sections && cartData.sections[state.sectionId],
        descriptor,
        message,
        isError
      );
    }

    function reconcileCart(state, descriptor, message) {
      return requestCart(state.updateUrl, {
        sections: [state.sectionId],
        sections_url: state.cartPageUrl
      }).then(function (cartData) {
        try {
          renderCartData(state, cartData, descriptor, message, true);
        } catch (error) {
          window.location.assign(state.cartPageUrl);
        }
      });
    }

    function validQuantity(input) {
      var quantity = Number(input.value);
      if (input.value === '' || !Number.isInteger(quantity) || quantity < 0 || !input.checkValidity()) {
        return null;
      }
      return quantity;
    }

    function resetQuantities(cart) {
      cart.querySelectorAll('[data-cart-quantity]').forEach(function (input) {
        input.value = input.getAttribute('data-current-quantity');
      });
    }

    function queueQuantity(state, input, quantity, descriptor) {
      var lineKey = input.getAttribute('data-line-key');
      var lineIndex = Number(input.getAttribute('data-line-index'));
      var currentQuantity = Number(input.getAttribute('data-current-quantity'));
      var queuedChange = state.quantities.get(lineKey);
      if (!lineKey || !lineIndex) return false;

      if (queuedChange && queuedChange.quantity === quantity) {
        state.focus = descriptor;
        return false;
      }
      if (state.inFlightQuantities.get(lineKey) === quantity) {
        state.focus = descriptor;
        return false;
      }

      if (quantity === currentQuantity) {
        state.quantities.delete(lineKey);
      } else {
        state.quantities.set(lineKey, {
          id: lineKey,
          line: lineIndex,
          quantity: quantity
        });
      }
      state.focus = descriptor;
      return true;
    }

    function scheduleFlush(state, delay) {
      window.clearTimeout(state.timer);
      state.timer = window.setTimeout(function () {
        flush(state);
      }, delay);
    }

    function flush(state) {
      /* A retired state may still hold an in-flight request — that one has to
         finish and render, since the server already accepted it — but it must
         never start new work. */
      if (state.aborted) return;

      if (state.busy) {
        scheduleFlush(state, 100);
        return;
      }

      var quantityChanges = Array.from(state.quantities.values()).sort(function (first, second) {
        return second.line - first.line;
      });
      var noteQueued = state.noteQueued;
      var note = state.note;
      var descriptor = state.focus;

      state.quantities.clear();
      state.noteQueued = false;
      state.inFlightQuantities = new Map(
        quantityChanges.map(function (change) {
          return [change.id, change.quantity];
        })
      );

      if (quantityChanges.length === 0 && !noteQueued) return;

      state.busy = true;
      setBusy(state.cart, true);
      setStatus(state.cart, state.cart.getAttribute('data-status-updating'), false);

      var sequence = Promise.resolve();
      var lastCart = null;

      if (noteQueued) {
        sequence = sequence.then(function () {
          return requestCart(state.updateUrl, { note: note });
        });
      }

      quantityChanges.forEach(function (change) {
        sequence = sequence.then(function () {
          return requestCart(state.changeUrl, {
            line: change.line,
            quantity: change.quantity,
            sections: [state.sectionId],
            sections_url: state.cartPageUrl
          }).then(function (cartData) {
            lastCart = cartData;
          });
        });
      });

      sequence
        .then(function () {
          state.busy = false;
          state.inFlightQuantities.clear();

          if (!lastCart) {
            setBusy(state.cart, false);
            setStatus(state.cart, state.cart.getAttribute('data-status-note-saved'), false);
            return;
          }

          try {
            renderCartData(state, lastCart, descriptor, state.cart.getAttribute('data-status-updated'), false);
          } catch (error) {
            window.location.assign(state.cartPageUrl);
          }
        })
        .catch(function (error) {
          state.busy = false;
          state.inFlightQuantities.clear();
          var message = state.cart.getAttribute('data-status-error');
          if (error.isCartResponseError && error.message) {
            message = error.message;
          }

          reconcileCart(state, descriptor, message).catch(function () {
            if (error.isCartResponseError) {
              window.location.assign(state.cartPageUrl);
              return;
            }

            if (lastCart) {
              try {
                renderCartData(state, lastCart, descriptor, message, true);
              } catch (renderError) {
                window.location.assign(state.cartPageUrl);
              }
              return;
            }

            resetQuantities(state.cart);
            setBusy(state.cart, false);
            setStatus(state.cart, message, true);
            restoreFocus(state.cart, descriptor);
          });
        });
    }

    function initCart(cart) {
      if (!cart || cart.getAttribute('data-cart-initialized') === 'true') return;
      cart.setAttribute('data-cart-initialized', 'true');

      var form = cart.querySelector('.cart__form');
      if (!form || !ajaxSupported) return;

      cart.classList.add('cart--ajax');
      var state = {
        cart: cart,
        form: form,
        sectionId: cart.getAttribute('data-section-id'),
        changeUrl: cart.getAttribute('data-cart-change-url'),
        updateUrl: cart.getAttribute('data-cart-update-url'),
        cartPageUrl: cart.getAttribute('data-cart-page-url'),
        quantities: new Map(),
        inFlightQuantities: new Map(),
        noteQueued: false,
        note: '',
        focus: null,
        timer: null,
        busy: false,
        aborted: false
      };

      cart.cartCleanup = function () {
        window.clearTimeout(state.timer);
        state.timer = null;
        state.aborted = true;
      };

      cart.addEventListener('click', function (event) {
        var stepButton = event.target.closest('[data-qty-step]');
        if (stepButton && cart.contains(stepButton)) {
          var targetId = stepButton.getAttribute('data-qty-target');
          var input = document.getElementById(targetId);
          if (!input) return;

          var step = Number(stepButton.getAttribute('data-qty-step'));
          var current = validQuantity(input);
          if (current === null) current = Number(input.getAttribute('data-current-quantity'));
          var next = Math.max(0, current + step);
          input.value = next;
          if (queueQuantity(state, input, next, focusDescriptor(stepButton))) {
            scheduleFlush(state, 250);
          }
          return;
        }

        var remove = event.target.closest('[data-cart-remove]');
        if (remove && cart.contains(remove)) {
          event.preventDefault();
          if (state.busy) return;

          var lineKey = remove.getAttribute('data-line-key');
          var lineIndex = Number(remove.getAttribute('data-line-index'));
          if (!lineKey || !lineIndex) return;
          state.quantities.set(lineKey, { id: lineKey, line: lineIndex, quantity: 0 });
          state.focus = focusDescriptor(remove);
          scheduleFlush(state, 0);
        }
      });

      cart.addEventListener('change', function (event) {
        if (event.target.matches('[data-cart-quantity]')) {
          var quantity = validQuantity(event.target);
          if (quantity === null) {
            event.target.value = event.target.getAttribute('data-current-quantity');
            setStatus(cart, cart.getAttribute('data-status-invalid-quantity'), true);
            return;
          }

          if (queueQuantity(state, event.target, quantity, focusDescriptor(event.target))) {
            scheduleFlush(state, 0);
          }
          return;
        }

        if (event.target.name === 'note') {
          state.note = event.target.value;
          state.noteQueued = true;
          state.focus = null;
          scheduleFlush(state, 250);
        }
      });

      cart.addEventListener('keydown', function (event) {
        if (event.key !== 'Enter' || !event.target.matches('[data-cart-quantity]')) return;
        event.preventDefault();
        var quantity = validQuantity(event.target);
        if (quantity === null) {
          event.target.value = event.target.getAttribute('data-current-quantity');
          setStatus(cart, cart.getAttribute('data-status-invalid-quantity'), true);
          return;
        }

        if (queueQuantity(state, event.target, quantity, focusDescriptor(event.target))) {
          scheduleFlush(state, 0);
        }
      });

      form.addEventListener('submit', function (event) {
        if (event.submitter && event.submitter.name === 'checkout') return;
        event.preventDefault();

        var invalidInput = null;
        form.querySelectorAll('[data-cart-quantity]').forEach(function (input) {
          var quantity = validQuantity(input);
          if (quantity === null) {
            invalidInput = invalidInput || input;
            return;
          }
          queueQuantity(state, input, quantity, focusDescriptor(input));
        });

        if (invalidInput) {
          invalidInput.value = invalidInput.getAttribute('data-current-quantity');
          invalidInput.focus();
          setStatus(cart, cart.getAttribute('data-status-invalid-quantity'), true);
          return;
        }

        var noteInput = form.querySelector('[name="note"]');
        if (noteInput) {
          state.note = noteInput.value;
          state.noteQueued = true;
        }
        scheduleFlush(state, 0);
      });
    }

    function init(scope) {
      if (scope.matches && scope.matches('[data-cart-section]')) initCart(scope);
      scope.querySelectorAll('[data-cart-section]').forEach(initCart);
    }

    function destroy(scope) {
      if (scope.matches && scope.matches('[data-cart-section]')) teardownCart(scope);
      scope.querySelectorAll('[data-cart-section]').forEach(teardownCart);
    }

    init(document);
    document.addEventListener('shopify:section:load', function (event) {
      init(event.target);
    });
    document.addEventListener('shopify:section:unload', function (event) {
      destroy(event.target);
    });
  })();
{% endjavascript %}

